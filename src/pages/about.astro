---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SimpleContactCallout from '@/components/sections/SimpleContactCallout.astro';
import { aboutProfile } from '@/data/about';
import { siteConfig } from '@/data/site';
import { getProfilePageSchema } from '@/lib/seo/jsonld';

const seo = {
  title: `About ${aboutProfile.name} — Quantitative Finance & Full-Stack Engineer`,
  description: 'Background, engineering principles, education, and technical capabilities of Uzair Ahmad.',
  canonical: `${siteConfig.url}/about`,
  schema: [getProfilePageSchema()],
};
---

<BaseLayout seo={seo}>
  <article class="about-page-container">
    <Breadcrumbs items={[{ label: 'About', href: '/about' }]} />

    <header class="about-header">
      <span class="page-eyebrow">ABOUT</span>
      <h1 class="page-title">{aboutProfile.name}</h1>
      <p class="about-tagline">{aboutProfile.title} · {aboutProfile.location}</p>
      <p class="about-intro">{aboutProfile.shortBio}</p>
    </header>

    <div class="about-content">
      <!-- 1. Who I Am & Narrative -->
      <section class="about-section">
        <h2 class="section-heading">Background & Engineering Focus</h2>
        <div class="narrative-stack">
          {aboutProfile.narrativeParagraphs.map((para) => (
            <p class="body-text">{para}</p>
          ))}
        </div>
      </section>

      <!-- 2. What I Work On / Grouped Capabilities -->
      <section class="about-section">
        <h2 class="section-heading">What I Work On</h2>
        <div class="capabilities-grid">
          <div class="cap-card">
            <h3 class="cap-title">Quantitative Finance & Modeling</h3>
            <p class="cap-desc">
              Time-series forecasting, statistical moment tracking, fractional differencing for memory preservation, walk-forward cross-validation, and portfolio analytics.
            </p>
            <div class="tech-tags">
              <span>Python</span>
              <span>PyTorch</span>
              <span>Pandas</span>
              <span>NumPy</span>
              <span>Scikit-Learn</span>
            </div>
          </div>

          <div class="cap-card">
            <h3 class="cap-title">AI & Multi-Agent Intelligence</h3>
            <p class="cap-desc">
              Deterministic agent state graphs, runtime Pydantic schema validation, LLM-driven research synthesis, and lead qualification engines.
            </p>
            <div class="tech-tags">
              <span>LangGraph</span>
              <span>TypeScript</span>
              <span>Pydantic</span>
              <span>FastAPI</span>
            </div>
          </div>

          <div class="cap-card">
            <h3 class="cap-title">Full-Stack Software Engineering</h3>
            <p class="cap-desc">
              End-to-end web architecture, accessible UI design, role-based access control, relational database modeling, and static-first performance.
            </p>
            <div class="tech-tags">
              <span>React</span>
              <span>TypeScript</span>
              <span>Node.js</span>
              <span>Express</span>
              <span>PostgreSQL</span>
              <span>Astro</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Engineering Principles -->
      <section class="about-section">
        <h2 class="section-heading">How I Approach Engineering</h2>
        <div class="principles-list">
          {aboutProfile.principles.map((p) => (
            <div class="principle-item">
              <span class="principle-num">{p.number}</span>
              <div class="principle-content">
                <h3 class="principle-title">{p.title}</h3>
                <p class="principle-summary">{p.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Education -->
      <section class="about-section">
        <h2 class="section-heading">Education</h2>
        <div class="education-card">
          <div class="edu-top">
            <h3 class="edu-institution">{aboutProfile.education[0].institution}</h3>
            <span class="edu-period">{aboutProfile.education[0].period}</span>
          </div>
          <p class="edu-degree">
            <strong>{aboutProfile.education[0].degree} in {aboutProfile.education[0].field}</strong> — {aboutProfile.education[0].location}
          </p>
          <ul class="edu-focus-list">
            {aboutProfile.education?.[0]?.focus?.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <SimpleContactCallout />
  </article>
</BaseLayout>

<style>
  .about-page-container {
    width: min(var(--container-max, 900px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .about-header {
    margin: 1.5rem 0 2.5rem 0;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .page-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    display: block;
    margin-bottom: 0.5rem;
  }

  :global(html[data-theme="light"]) .page-eyebrow,
  :global([data-theme="light"]) .page-eyebrow {
    color: #0d7663;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  :global(html[data-theme="light"]) .page-title,
  :global([data-theme="light"]) .page-title {
    color: #141f1c;
  }

  .about-tagline {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-accent, #7ed8c4);
    margin: 0 0 1rem 0;
  }

  :global(html[data-theme="light"]) .about-tagline,
  :global([data-theme="light"]) .about-tagline {
    color: #0d7663;
  }

  .about-intro {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
    max-width: 720px;
  }

  :global(html[data-theme="light"]) .about-intro,
  :global([data-theme="light"]) .about-intro {
    color: #4a5c55;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-heading {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  :global(html[data-theme="light"]) .section-heading,
  :global([data-theme="light"]) .section-heading {
    color: #141f1c;
    border-bottom-color: rgba(20, 31, 28, 0.08);
  }

  .narrative-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .body-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .body-text,
  :global([data-theme="light"]) .body-text {
    color: #35453f;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .cap-card {
    padding: 1.35rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  :global(html[data-theme="light"]) .cap-card,
  :global([data-theme="light"]) .cap-card {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  .cap-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  :global(html[data-theme="light"]) .cap-title,
  :global([data-theme="light"]) .cap-title {
    color: #141f1c;
  }

  .cap-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1rem 0;
  }

  :global(html[data-theme="light"]) .cap-desc,
  :global([data-theme="light"]) .cap-desc {
    color: #4a5c55;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-tags span {
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm, 4px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .tech-tags span,
  :global([data-theme="light"]) .tech-tags span {
    background: rgba(13, 118, 99, 0.05);
    border-color: rgba(13, 118, 99, 0.15);
    color: #0d7663;
  }

  .principles-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .principle-item {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    border-radius: var(--radius-md, 8px);
  }

  :global(html[data-theme="light"]) .principle-item,
  :global([data-theme="light"]) .principle-item {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.1);
  }

  .principle-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
  }

  :global(html[data-theme="light"]) .principle-num,
  :global([data-theme="light"]) .principle-num {
    color: #0d7663;
  }

  .principle-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.35rem 0;
  }

  :global(html[data-theme="light"]) .principle-title,
  :global([data-theme="light"]) .principle-title {
    color: #141f1c;
  }

  .principle-summary {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .principle-summary,
  :global([data-theme="light"]) .principle-summary {
    color: #4a5c55;
  }

  .education-card {
    padding: 1.5rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    border-radius: var(--radius-md, 8px);
  }

  :global(html[data-theme="light"]) .education-card,
  :global([data-theme="light"]) .education-card {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.1);
  }

  .edu-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .edu-institution {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .edu-institution,
  :global([data-theme="light"]) .edu-institution {
    color: #141f1c;
  }

  .edu-period {
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .edu-period,
  :global([data-theme="light"]) .edu-period {
    color: #0d7663;
  }

  .edu-degree {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1rem 0;
  }

  :global(html[data-theme="light"]) .edu-degree,
  :global([data-theme="light"]) .edu-degree {
    color: #4a5c55;
  }

  .edu-focus-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .edu-focus-list li {
    font-size: 0.9rem;
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .edu-focus-list li,
  :global([data-theme="light"]) .edu-focus-list li {
    color: #4a5c55;
  }

  @media (max-width: 820px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
