---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TimelineEventCard from '@/components/cards/TimelineEventCard.astro';
import {
  buildTimelineEvents,
  getTimelineSummary,
  groupEventsByYear,
  getTimelineEras,
} from '@/lib/timeline';
import { siteConfig } from '@/data/site';

const allEvents = buildTimelineEvents();
const summary = getTimelineSummary(allEvents);
const yearGroups = groupEventsByYear(allEvents);
const eras = getTimelineEras();

const seo = {
  title: `Personal Engineering Timeline & Technical Evolution | ${siteConfig.name}`,
  description: 'A chronological view of projects, research investigations, lab experiments, and architectural transitions documenting software evolution from 2024 to 2026.',
  canonical: `${siteConfig.url}/timeline`,
  keywords: [
    'Engineering Timeline',
    'Technical History',
    'Project Evolution',
    'Quantitative Finance Research',
    'Distributed Systems',
    'Uzair Ahmad',
  ],
};
---

<BaseLayout seo={seo}>
  <main id="main-content" class="timeline-page">
    <div class="timeline-container">
      <!-- 1. Header & Introduction -->
      <header class="timeline-header">
        <div class="header-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>CHRONOLOGICAL EVOLUTION // 2024 – 2026</span>
        </div>
        <h1 class="page-title">Personal Engineering Timeline</h1>
        <p class="page-subtitle">
          A contextual, chronological record tracing how projects, quantitative research, laboratory experiments, and architectural directions have evolved across my engineering history.
        </p>

        <!-- Metrics Summary Ribbon -->
        <div class="metrics-ribbon" aria-label="Timeline metrics overview">
          <div class="metric-item">
            <span class="metric-val">{summary.totalEvents}</span>
            <span class="metric-lbl">Total Milestones</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">{summary.yearRange.start} – {summary.yearRange.end}</span>
            <span class="metric-lbl">Span of History</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">{summary.byType.project}</span>
            <span class="metric-lbl">Projects</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">{summary.byType.research}</span>
            <span class="metric-lbl">Research Items</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">{summary.byType.lab}</span>
            <span class="metric-lbl">Lab Experiments</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">{summary.byType.note}</span>
            <span class="metric-lbl">Engineering Notes</span>
          </div>
        </div>
      </header>

      <!-- 2. Engineering Eras -->
      <section class="eras-section" aria-labelledby="eras-heading">
        <h2 id="eras-heading" class="sr-only">Engineering Eras</h2>
        <div class="eras-grid">
          {eras.map((era) => (
            <div class="era-card">
              <div class="era-header">
                <span class="era-timeframe">{era.timeframe}</span>
                <h3 class="era-title">{era.title}</h3>
              </div>
              <p class="era-desc">{era.description}</p>
              <div class="era-tags">
                {era.focusAreas.map((area) => (
                  <span class="era-tag">{area}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Interactive Controls -->
      <section class="controls-section" aria-label="Timeline filter controls">
        <div class="filter-group">
          <span class="filter-label">Filter by Type:</span>
          <div class="filter-pills" role="toolbar" aria-label="Filter events by type">
            <button class="filter-btn active" data-filter-type="all" aria-pressed="true">
              All ({summary.totalEvents})
            </button>
            <button class="filter-btn" data-filter-type="project" aria-pressed="false">
              Projects ({summary.byType.project})
            </button>
            <button class="filter-btn" data-filter-type="research" aria-pressed="false">
              Research ({summary.byType.research})
            </button>
            <button class="filter-btn" data-filter-type="lab" aria-pressed="false">
              Lab ({summary.byType.lab})
            </button>
            <button class="filter-btn" data-filter-type="note" aria-pressed="false">
              Notes ({summary.byType.note})
            </button>
          </div>
        </div>

        <div class="filter-group year-group">
          <span class="filter-label">Year:</span>
          <div class="filter-pills" role="toolbar" aria-label="Filter events by year">
            <button class="filter-btn year-btn active" data-filter-year="all" aria-pressed="true">
              All Years
            </button>
            {Object.keys(summary.byYear).sort((a, b) => Number(b) - Number(a)).map((yr) => (
              <button class="filter-btn year-btn" data-filter-year={yr} aria-pressed="false">
                {yr} ({summary.byYear[Number(yr)]})
              </button>
            ))}
          </div>
        </div>

        <div class="live-status sr-only" aria-live="polite" id="filter-status">
          Showing all {summary.totalEvents} timeline events.
        </div>
      </section>

      <!-- 4. Chronological Stream -->
      <div class="timeline-stream" id="timeline-stream">
        {yearGroups.map((group) => (
          <section class="year-block" data-year={group.year} id={`year-${group.year}`}>
            <div class="year-marker-row">
              <div class="year-badge">
                <span class="year-number">{group.year}</span>
                <span class="year-count">({group.events.length} milestones)</span>
              </div>
              <div class="year-rule" aria-hidden="true"></div>
            </div>

            <div class="events-container">
              {group.events.map((evt) => (
                <div class="timeline-item" data-type={evt.type} data-year={evt.year}>
                  <div class="timeline-spine" aria-hidden="true">
                    <span class="spine-dot"></span>
                    <span class="spine-line"></span>
                  </div>
                  <div class="timeline-item-body">
                    <TimelineEventCard event={evt} />
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}

        <!-- Empty Filter State -->
        <div class="empty-filter-state" id="empty-state" style="display: none;">
          <p class="empty-title">No events match the selected filters</p>
          <p class="empty-desc">Try selecting a different type or clearing the year filter to view other milestones.</p>
          <button class="reset-filter-btn" id="reset-filters">Reset All Filters</button>
        </div>
      </div>

      <!-- 5. Footer Exploration Link -->
      <footer class="timeline-footer">
        <div class="footer-card">
          <h3>Historical & Legacy Work</h3>
          <p>
            Looking specifically for archived, superseded, or legacy systems from earlier engineering generations?
          </p>
          <div class="footer-links">
            <a href="/archive" class="btn-portal">
              Explore Project Archive Catalog →
            </a>
            <a href="/knowledge" class="btn-subtle">
              View Knowledge Graph ↗
            </a>
            <a href="/discover" class="btn-subtle">
              Discovery Search 🔍
            </a>
          </div>
        </div>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .timeline-page {
    padding: clamp(3rem, 6vw, 5.5rem) 0;
    min-height: 80vh;
  }

  .timeline-container {
    width: min(var(--container-max, 1100px), calc(100% - 2rem));
    margin: 0 auto;
  }

  .timeline-header {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    font-weight: 800;
    color: var(--color-accent-teal, #7ed8c4);
    letter-spacing: 0.08em;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.24);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent-teal, #7ed8c4);
    box-shadow: 0 0 8px rgba(126, 216, 196, 0.8);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary, #f6f1e8);
    line-height: 1.2;
    margin: 0 0 1rem 0;
  }

  .page-subtitle {
    max-width: 780px;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.65;
    margin: 0 0 2rem 0;
  }

  .metrics-ribbon {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    background: var(--color-background-subtle, #101a17);
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.1));
    border-radius: var(--radius-md, 8px);
    padding: 1.25rem 1.5rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-val {
    font-size: 1.35rem;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent-teal, #7ed8c4);
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: var(--color-text-muted, #83968e);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Eras Section */
  .eras-section {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .eras-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .era-card {
    background: rgba(16, 26, 23, 0.6);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: var(--radius-md, 8px);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .era-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .era-timeframe {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-accent-teal, #7ed8c4);
    letter-spacing: 0.05em;
  }

  .era-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  .era-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.55;
    margin: 0;
  }

  .era-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .era-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--color-text-muted, #83968e);
    background: rgba(246, 241, 232, 0.03);
    border: 1px solid rgba(246, 241, 232, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  /* Controls Section */
  .controls-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
    padding: 1.25rem;
    background: var(--color-background-subtle, #101a17);
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.1));
    border-radius: var(--radius-md, 8px);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted, #83968e);
    text-transform: uppercase;
    min-width: 100px;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text-secondary, #a9b8b1);
    background: rgba(246, 241, 232, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: var(--radius-full, 9999px);
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
    min-height: var(--touch-target-min, 36px);
  }

  .filter-btn:hover {
    color: var(--color-text-primary, #f6f1e8);
    border-color: rgba(126, 216, 196, 0.4);
    background: rgba(126, 216, 196, 0.05);
  }

  .filter-btn.active {
    color: #07110f;
    background: var(--color-accent-teal, #7ed8c4);
    border-color: var(--color-accent-teal, #7ed8c4);
    font-weight: 800;
  }

  /* Timeline Stream */
  .timeline-stream {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .year-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .year-marker-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .year-badge {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    background: rgba(126, 216, 196, 0.12);
    border: 1px solid rgba(126, 216, 196, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm, 4px);
  }

  .year-number {
    font-family: var(--font-mono, monospace);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-accent-teal, #7ed8c4);
  }

  .year-count {
    font-size: 0.775rem;
    color: var(--color-text-muted, #83968e);
    font-family: var(--font-mono, monospace);
  }

  .year-rule {
    flex-grow: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(126, 216, 196, 0.3), rgba(246, 241, 232, 0.06));
  }

  .events-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    padding-left: 2rem;
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .timeline-spine {
    position: absolute;
    left: -2rem;
    top: 0;
    bottom: 0;
    width: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .spine-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-accent-teal, #7ed8c4);
    border: 2px solid #07110f;
    box-shadow: 0 0 6px rgba(126, 216, 196, 0.6);
    margin-top: 1.5rem;
    z-index: 2;
  }

  .spine-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 0.5px);
    width: 1px;
    background: rgba(246, 241, 232, 0.12);
    z-index: 1;
  }

  .timeline-item-body {
    flex-grow: 1;
  }

  /* Empty State */
  .empty-filter-state {
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-background-subtle, #101a17);
    border: 1px dashed var(--color-border, rgba(246, 241, 232, 0.15));
    border-radius: var(--radius-md, 8px);
  }

  .empty-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary, #a9b8b1);
    margin-bottom: 1.5rem;
  }

  .reset-filter-btn {
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
    font-weight: 700;
    color: #07110f;
    background: var(--color-accent-teal, #7ed8c4);
    border: none;
    border-radius: var(--radius-sm, 4px);
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  /* Timeline Footer */
  .timeline-footer {
    margin-top: clamp(3.5rem, 6vw, 5rem);
  }

  .footer-card {
    background: linear-gradient(180deg, rgba(126, 216, 196, 0.04), transparent), var(--color-background-subtle, #101a17);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: var(--radius-md, 8px);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  .footer-card p {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.6;
    margin: 0;
    max-width: 700px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-portal {
    font-size: 0.875rem;
    font-weight: 700;
    color: #07110f;
    background: var(--color-accent-teal, #7ed8c4);
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    transition: opacity var(--transition-fast, 150ms ease);
  }

  .btn-portal:hover {
    opacity: 0.9;
  }

  .btn-subtle {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary, #a9b8b1);
    background: rgba(246, 241, 232, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    transition: all var(--transition-fast, 150ms ease);
  }

  .btn-subtle:hover {
    color: var(--color-text-primary, #f6f1e8);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 900px) {
    .metrics-ribbon {
      grid-template-columns: repeat(3, 1fr);
    }

    .eras-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .metrics-ribbon {
      grid-template-columns: repeat(2, 1fr);
    }

    .events-container {
      padding-left: 1.25rem;
    }

    .timeline-spine {
      left: -1.25rem;
      width: 1.25rem;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  function initTimelineFilters() {
    let currentType = 'all';
    let currentYear = 'all';

    const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
    const yearButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-year]');
    const yearBlocks = document.querySelectorAll<HTMLElement>('.year-block');
    const emptyState = document.getElementById('empty-state');
    const statusRegion = document.getElementById('filter-status');
    const resetBtn = document.getElementById('reset-filters');

    function applyFilters() {
      let visibleCount = 0;

      yearBlocks.forEach((yearBlock) => {
        const blockYear = yearBlock.getAttribute('data-year');
        const isYearMatch = currentYear === 'all' || currentYear === blockYear;

        let visibleInBlock = 0;
        const items = yearBlock.querySelectorAll<HTMLElement>('.timeline-item');

        items.forEach((item) => {
          const itemType = item.getAttribute('data-type');
          const isTypeMatch = currentType === 'all' || currentType === itemType;

          if (isYearMatch && isTypeMatch) {
            item.style.display = 'flex';
            visibleInBlock++;
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (visibleInBlock > 0) {
          yearBlock.style.display = 'flex';
        } else {
          yearBlock.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (statusRegion) {
        statusRegion.textContent = `Showing ${visibleCount} timeline events for filter ${currentType} in ${currentYear}.`;
      }
    }

    typeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        typeButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        currentType = btn.getAttribute('data-filter-type') || 'all';
        applyFilters();
      });
    });

    yearButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        yearButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        currentYear = btn.getAttribute('data-filter-year') || 'all';
        applyFilters();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentType = 'all';
        currentYear = 'all';

        typeButtons.forEach((b) => {
          const isAll = b.getAttribute('data-filter-type') === 'all';
          b.classList.toggle('active', isAll);
          b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
        });

        yearButtons.forEach((b) => {
          const isAll = b.getAttribute('data-filter-year') === 'all';
          b.classList.toggle('active', isAll);
          b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
        });

        applyFilters();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initTimelineFilters);
</script>
