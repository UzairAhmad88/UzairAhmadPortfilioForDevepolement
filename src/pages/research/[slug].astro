---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import RelatedKnowledgeGrid from '@/components/knowledge/RelatedKnowledgeGrid.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import GitHubEvidenceBadge from '@/components/github/GitHubEvidenceBadge.astro';
import { getResearchGitHubEvidence } from '@/lib/github/evidence';
import { researchItems } from '@/data/research';
import { projects } from '@/data/projects';
import { technologies } from '@/data/technologies';
import { siteConfig } from '@/data/site';
import type { ResearchItem } from '@/types/research';

export function getStaticPaths() {
  return researchItems.map((inquiry) => ({
    params: { slug: inquiry.slug },
    props: { inquiry },
  }));
}

export interface Props {
  inquiry: ResearchItem;
}

const { inquiry } = Astro.props;

const seo = {
  title: `${inquiry.title} — Uzair Ahmad | Research Lab`,
  description: inquiry.summary || inquiry.question,
  canonical: `${siteConfig.url}/research/${inquiry.slug}`,
};

const researchSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: inquiry.title,
  description: inquiry.summary,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  datePublished: inquiry.publishedAt || '2024-09-01',
  dateModified: inquiry.updatedAt || inquiry.publishedAt || '2025-01-01',
};

const relatedProjects = (inquiry.relatedProjects || [])
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => Boolean(p));

const linkedTechnologies = (inquiry.technologies || [])
  .map((techId) => technologies.find((t) => t.id === techId))
  .filter((t) => Boolean(t));

const gitHubEvidence = getResearchGitHubEvidence(inquiry);
---

<BaseLayout seo={seo}>
  <div class="research-detail-page">
    <Breadcrumbs
      items={[
        { label: 'Research', href: '/research' },
        { label: inquiry.title, href: `/research/${inquiry.slug}` },
      ]}
    />

    <article class="research-container">
      <header class="research-header">
        <div class="badge-row">
          <span class="domain-pill">{inquiry.domain}</span>
          <span class:list={['status-pill', `badge-${inquiry.badge.toLowerCase()}`]}>
            {inquiry.badge}
          </span>
        </div>
        <h1 class="research-headline">{inquiry.title}</h1>
        <p class="lead-summary">{inquiry.summary}</p>

        <div class="meta-strip">
          <div class="meta-block">
            <span class="meta-label">Domain</span>
            <span class="meta-val">{inquiry.domain}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Research Status</span>
            <span class="meta-val">{inquiry.status}</span>
          </div>
          {inquiry.publishedAt && (
            <div class="meta-block">
              <span class="meta-label">Initiated</span>
              <span class="meta-val">{inquiry.publishedAt}</span>
            </div>
          )}
          {inquiry.updatedAt && (
            <div class="meta-block">
              <span class="meta-label">Last Updated</span>
              <span class="meta-val">{inquiry.updatedAt}</span>
            </div>
          )}
        </div>

        {inquiry.githubUrl && (
          <div class="header-action-links">
            <a href={inquiry.githubUrl} target="_blank" rel="noopener noreferrer" class="cta-primary">
              View Verified Repository on GitHub ↗
            </a>
          </div>
        )}
      </header>

      <div class="research-grid">
        <main class="research-main">
          <!-- 01: Question -->
          <section class="research-section">
            <h2 class="section-title">01 — Core Research Question</h2>
            <div class="question-callout">
              <p class="question-text">"{inquiry.question}"</p>
            </div>
          </section>

          <!-- 02: Context & Motivation -->
          <section class="research-section">
            <h2 class="section-title">02 — Context & Motivation</h2>
            <p>{inquiry.context}</p>
            {inquiry.motivation && (
              <p class="motivation-text">
                <strong>Empirical Motivation:</strong> {inquiry.motivation}
              </p>
            )}
          </section>

          <!-- 03: Hypothesis -->
          <section class="research-section">
            <h2 class="section-title">03 — Working Hypothesis</h2>
            <div class="hypothesis-card">
              <p>{inquiry.hypothesis}</p>
            </div>
          </section>

          <!-- 04: Methodology Stages -->
          {inquiry.methodologyStages && inquiry.methodologyStages.length > 0 ? (
            <section class="research-section">
              <h2 class="section-title">04 — Methodological Pipeline & Stages</h2>
              <div class="methodology-stages-grid">
                {inquiry.methodologyStages.map((st) => (
                  <div class="stage-card">
                    <span class="stage-num">{st.stage}</span>
                    <h3 class="stage-title">{st.title}</h3>
                    <p class="stage-desc">{st.description}</p>
                    {st.tools && st.tools.length > 0 && (
                      <div class="stage-tools">
                        <span class="tools-label">Toolkit:</span>
                        <div class="tools-tags">
                          {st.tools.map((tool) => (
                            <span class="tool-badge">{tool}</span>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </section>
          ) : inquiry.methodology && inquiry.methodology.length > 0 ? (
            <section class="research-section">
              <h2 class="section-title">04 — Methodological Approach</h2>
              <ul class="bullet-list">
                {inquiry.methodology.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- 05: Mathematical Formulation -->
          {inquiry.mathematicalFormulation && (
            <section class="research-section">
              <h2 class="section-title">05 — Mathematical & Structural Formulation</h2>
              <pre class="math-block" aria-label="Mathematical Formulation"><code>{inquiry.mathematicalFormulation}</code></pre>
            </section>
          )}

          <!-- 06: Data Sources -->
          {inquiry.dataSources && inquiry.dataSources.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">06 — Data Sources & Experimental Inputs</h2>
              <ul class="bullet-list">
                {inquiry.dataSources.map((ds) => (
                  <li>{ds}</li>
                ))}
              </ul>
            </section>
          )}

          <!-- 07: Empirical Experiments -->
          {inquiry.experimentsList && inquiry.experimentsList.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">07 — Experiments & Empirical Testing</h2>
              <div class="experiments-stack">
                {inquiry.experimentsList.map((exp) => (
                  <div class="experiment-card">
                    <div class="exp-header">
                      <span class="exp-id">{exp.id.toUpperCase()}</span>
                      <span class:list={['exp-status', `status-${exp.status.toLowerCase()}`]}>
                        {exp.status}
                      </span>
                    </div>
                    <h3 class="exp-title">{exp.title}</h3>
                    <p class="exp-objective"><strong>Objective:</strong> {exp.objective}</p>
                    {exp.variables && (
                      <div class="exp-vars">
                        <span class="vars-label">Controlled Variables:</span>
                        <ul class="vars-list">
                          {exp.variables.map((v) => (
                            <li>{v}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {exp.results && (
                      <div class="exp-results">
                        <span class="results-label">Observed Results:</span>
                        <ul class="results-list">
                          {exp.results.map((r) => (
                            <li>{r}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {exp.interpretation && (
                      <p class="exp-interpretation">
                        <strong>Interpretation:</strong> {exp.interpretation}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- 08: Findings vs Interpretation -->
          {inquiry.findings && inquiry.findings.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">08 — Empirical Findings & Technical Interpretation</h2>
              <div class="findings-stack">
                {inquiry.findings.map((f) => (
                  <div class="finding-card">
                    <span class:list={['finding-status', `status-${f.status.toLowerCase()}`]}>
                      {f.status}
                    </span>
                    <p class="finding-desc">{f.description}</p>
                  </div>
                ))}
              </div>

              {inquiry.interpretation && (
                <div class="interpretation-box">
                  <h3 class="interpretation-title">Technical Interpretation & Synthesis</h3>
                  <p>{inquiry.interpretation}</p>
                </div>
              )}
            </section>
          )}

          <!-- 09: Limitations & Open Questions -->
          <section class="research-section">
            <h2 class="section-title">09 — Known Limitations & Epistemic Uncertainty</h2>
            {inquiry.limitations && inquiry.limitations.length > 0 && (
              <div class="limits-block">
                <h3 class="sub-block-title">Methodological & Data Limitations</h3>
                <ul class="bullet-list">
                  {inquiry.limitations.map((lim) => (
                    <li>{lim}</li>
                  ))}
                </ul>
              </div>
            )}

            {inquiry.openQuestions && inquiry.openQuestions.length > 0 && (
              <div class="open-q-block">
                <h3 class="sub-block-title">Unresolved Questions Under Active Exploration</h3>
                <ul class="bullet-list">
                  {inquiry.openQuestions.map((oq) => (
                    <li>{oq}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>

          <!-- 10: Technologies -->
          {linkedTechnologies.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">10 — Related Technology Stack</h2>
              <div class="tech-chips-grid">
                {linkedTechnologies.map((t) => (
                  <a href={`/technology/${t!.id}`} class="tech-chip">
                    <span class="tech-chip-name">{t!.name}</span>
                    <span class="tech-chip-role">{t!.primaryRole}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- 11: Academic References -->
          {inquiry.references && inquiry.references.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">11 — Academic & Technical References</h2>
              <ul class="references-list">
                {inquiry.references.map((ref) => (
                  <li class="ref-item">
                    <span>{ref.citation}</span>
                    {ref.url && (
                      <a href={ref.url} target="_blank" rel="noopener noreferrer" class="ref-link">
                        [Source Link ↗]
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </main>

        <aside class="research-sidebar">
          <div class="sticky-sidebar-card">
            <h3 class="sidebar-heading">Investigation Specs</h3>
            <dl class="sidebar-specs">
              <dt>Domain</dt>
              <dd>{inquiry.domain}</dd>
              <dt>Status</dt>
              <dd>{inquiry.status}</dd>
              <dt>Artifacts</dt>
              <dd>
                {inquiry.githubUrl ? (
                  <a href={inquiry.githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link">
                    Public GitHub Repository ↗
                  </a>
                ) : (
                  'Active Lab'
                )}
              </dd>
            </dl>

            <div class="sidebar-evidence-wrapper" style="margin-top: 1.25rem;">
              <GitHubEvidenceBadge
                evidence={gitHubEvidence}
                entityTitle={inquiry.title}
                isPrivateOrUnavailable={!inquiry.githubUrl && !gitHubEvidence}
              />
            </div>

            {linkedTechnologies.length > 0 && (
              <div class="sidebar-tech-list">
                <span class="sidebar-tech-label">Primary Stack:</span>
                <div class="sidebar-tags">
                  {linkedTechnologies.map((t) => (
                    <a href={`/technology/${t!.id}`} class="sidebar-tag-link">
                      {t!.name}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div class="sidebar-cta-box">
              <p class="sidebar-cta-text">Interested in discussing these research findings?</p>
              <a href="/contact" class="sidebar-btn">
                Contact Uzair →
              </a>
            </div>
          </div>
        </aside>
      </div>

      {relatedProjects.length > 0 && (
        <section class="related-section">
          <h2 class="related-heading">Related Engineering Systems & Implementations</h2>
          <div class="related-grid">
            {relatedProjects.map((rel) => (
              <ProjectCard project={rel!} />
            ))}
          </div>
        </section>
      )}

      <RelatedKnowledgeGrid
        type="research"
        slug={inquiry.slug}
        title="Knowledge Graph & Empirical Connections"
        subtitle="Connected software implementations, laboratory experiments, engineering decision logs, and foundational technologies."
      />

      <ContactCallout
        title="Explore collaborating on this research?"
        subtitle="Open to technical exchanges, empirical data validation, and joint quantitative modeling."
      />
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(researchSchema)} />
  </div>
</BaseLayout>

<style>
  .research-detail-page {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .research-header {
    padding: 1.5rem 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-subtle, #1e293b);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .domain-pill {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
  }

  .status-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
  }

  .badge-exploring {
    background: rgba(189, 166, 255, 0.15);
    color: #bda6ff;
    border: 1px solid rgba(189, 166, 255, 0.3);
  }

  .badge-experimenting {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .badge-building {
    background: rgba(126, 216, 196, 0.15);
    color: #7ed8c4;
    border: 1px solid rgba(126, 216, 196, 0.3);
  }

  .badge-completed {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .research-headline {
    font-size: var(--font-size-h1, clamp(2rem, 3.8vw, 2.75rem));
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .lead-summary {
    font-size: var(--font-size-lead, 1.15rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .meta-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
  }

  .meta-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
  }

  .header-action-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: rgba(126, 216, 196, 0.15);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.35);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    text-align: center;
    transition: background 150ms ease, color 150ms ease;
  }

  .cta-primary:hover {
    background: var(--color-accent, #7ed8c4);
    color: #0d1512;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .research-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(1.2rem, 2vw + 0.1rem, 1.45rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .research-section p {
    font-size: var(--font-size-body, 1.05rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.75;
    margin: 0 0 1rem 0;
  }

  .motivation-text {
    background: rgba(0, 0, 0, 0.2);
    border-left: 2px solid rgba(126, 216, 196, 0.5);
    padding: 0.75rem 1rem;
    border-radius: 0 0.375rem 0.375rem 0;
    margin-top: 1rem !important;
  }

  .question-callout {
    background: rgba(126, 216, 196, 0.08);
    border-left: 3px solid var(--color-accent, #7ed8c4);
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .question-text {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem) !important;
    font-weight: 600;
    color: var(--color-text, #f6f1e8) !important;
    line-height: 1.5 !important;
    margin: 0 !important;
  }

  .hypothesis-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .hypothesis-card p {
    margin: 0;
    color: var(--color-text, #f6f1e8);
  }

  .methodology-stages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .stage-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .stage-num {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
  }

  .stage-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0.35rem 0 0.5rem 0;
  }

  .stage-desc {
    font-size: 0.95rem !important;
    color: var(--color-text-muted, #a9b8b1) !important;
    line-height: 1.55 !important;
    margin: 0 0 0.75rem 0 !important;
  }

  .stage-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tools-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted, #a9b8b1);
    font-family: var(--font-mono, monospace);
  }

  .tools-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tool-badge {
    font-size: 0.725rem;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-accent, #7ed8c4);
  }

  .bullet-list {
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bullet-list li {
    font-size: 1.025rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
  }

  .math-block {
    background: #060911;
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: 1.25rem;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    color: #7ed8c4;
    line-height: 1.6;
  }

  .experiments-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .experiment-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: 1.35rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .exp-id {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
  }

  .exp-status {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
  }

  .status-completed {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .status-running {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .status-inconclusive {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .exp-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .exp-objective {
    font-size: 0.95rem !important;
    color: var(--color-text-muted, #a9b8b1) !important;
    margin: 0 0 0.75rem 0 !important;
  }

  .vars-label, .results-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted, #a9b8b1);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, monospace);
  }

  .vars-list, .results-list {
    padding-left: 1.25rem;
    margin: 0 0 0.75rem 0;
  }

