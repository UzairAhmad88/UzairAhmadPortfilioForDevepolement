---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { researchItems } from '@/data/research';
import { projects } from '@/data/projects';
import { siteConfig } from '@/data/site';
import type { ResearchItem } from '@/types/research';

export function getStaticPaths() {
  return researchItems.map((inquiry) => ({
    params: { slug: inquiry.slug },
    props: { inquiry },
  }));
}

export interface Props {
  inquiry: ResearchItem;
}

const { inquiry } = Astro.props;

const seo = {
  title: `${inquiry.title} — Uzair Ahmad | Research Lab`,
  description: inquiry.summary || inquiry.question,
  canonical: `${siteConfig.url}/research/${inquiry.slug}`,
};

const researchSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: inquiry.title,
  description: inquiry.summary,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  datePublished: inquiry.publishedAt || '2024-09-01',
  dateModified: inquiry.updatedAt || inquiry.publishedAt || '2025-01-01',
};

const relatedProjects = (inquiry.relatedProjects || [])
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => Boolean(p));

const relatedResearchList = (inquiry.relatedResearch || [])
  .map((slug) => researchItems.find((r) => r.slug === slug))
  .filter((r) => Boolean(r));
---

<BaseLayout seo={seo}>
  <div class="research-detail-page">
    <Breadcrumbs
      items={[
        { label: 'Research', href: '/research' },
        { label: inquiry.title, href: `/research/${inquiry.slug}` },
      ]}
    />

    <article class="research-container">
      <header class="research-header">
        <div class="badge-row">
          <span class="domain-pill">{inquiry.domain}</span>
          <span class:list={['status-pill', `badge-${inquiry.badge.toLowerCase()}`]}>
            {inquiry.badge}
          </span>
        </div>
        <h1 class="research-headline">{inquiry.title}</h1>
        <p class="lead-summary">{inquiry.summary}</p>

        <div class="meta-strip">
          <div class="meta-block">
            <span class="meta-label">Domain</span>
            <span class="meta-val">{inquiry.domain}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Research Status</span>
            <span class="meta-val">{inquiry.status}</span>
          </div>
          {inquiry.publishedAt && (
            <div class="meta-block">
              <span class="meta-label">Initiated</span>
              <span class="meta-val">{inquiry.publishedAt}</span>
            </div>
          )}
          {inquiry.updatedAt && (
            <div class="meta-block">
              <span class="meta-label">Last Updated</span>
              <span class="meta-val">{inquiry.updatedAt}</span>
            </div>
          )}
        </div>

        {inquiry.githubUrl && (
          <div class="header-action-links">
            <a href={inquiry.githubUrl} target="_blank" rel="noopener noreferrer" class="cta-primary">
              View Research Artifacts on GitHub ↗
            </a>
          </div>
        )}
      </header>

      <div class="research-grid">
        <main class="research-main">
          <section class="research-section">
            <h2 class="section-title">01 — Core Research Question</h2>
            <div class="question-callout">
              <p class="question-text">"{inquiry.question}"</p>
            </div>
          </section>

          <section class="research-section">
            <h2 class="section-title">02 — Context & Motivation</h2>
            <p>{inquiry.context}</p>
          </section>

          <section class="research-section">
            <h2 class="section-title">03 — Hypothesis</h2>
            <div class="hypothesis-card">
              <p>{inquiry.hypothesis}</p>
            </div>
          </section>

          {inquiry.methodology && inquiry.methodology.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">04 — Methodological Approach</h2>
              <ul class="bullet-list">
                {inquiry.methodology.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </section>
          )}

          {inquiry.mathematicalFormulation && (
            <section class="research-section">
              <h2 class="section-title">05 — Mathematical / Structural Formulation</h2>
              <pre class="math-block" aria-label="Mathematical Formulation"><code>{inquiry.mathematicalFormulation}</code></pre>
            </section>
          )}

          {inquiry.dataSources && inquiry.dataSources.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">06 — Data Sources & Inputs</h2>
              <ul class="bullet-list">
                {inquiry.dataSources.map((ds) => (
                  <li>{ds}</li>
                ))}
              </ul>
            </section>
          )}

          {inquiry.findings && inquiry.findings.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">07 — Empirical Findings & Current State</h2>
              <div class="findings-stack">
                {inquiry.findings.map((f) => (
                  <div class="finding-card">
                    <span class:list={['finding-status', `status-${f.status.toLowerCase()}`]}>
                      {f.status}
                    </span>
                    <p class="finding-desc">{f.description}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {inquiry.limitations && inquiry.limitations.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">08 — Known Limitations & Constraints</h2>
              <ul class="bullet-list">
                {inquiry.limitations.map((lim) => (
                  <li>{lim}</li>
                ))}
              </ul>
            </section>
          )}

          {inquiry.conclusion && (
            <section class="research-section">
              <h2 class="section-title">09 — Technical Synthesis</h2>
              <p>{inquiry.conclusion}</p>
            </section>
          )}

          {inquiry.nextSteps && inquiry.nextSteps.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">10 — Next Iterations</h2>
              <ul class="bullet-list">
                {inquiry.nextSteps.map((ns) => (
                  <li>{ns}</li>
                ))}
              </ul>
            </section>
          )}

          {inquiry.references && inquiry.references.length > 0 && (
            <section class="research-section">
              <h2 class="section-title">11 — Academic & Technical References</h2>
              <ul class="references-list">
                {inquiry.references.map((ref) => (
                  <li class="ref-item">
                    <span>{ref.citation}</span>
                    {ref.url && (
                      <a href={ref.url} target="_blank" rel="noopener noreferrer" class="ref-link">
                        [Link ↗]
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </main>

        <aside class="research-sidebar">
          <div class="sticky-sidebar-card">
            <h3 class="sidebar-heading">Research Metadata</h3>
            <dl class="sidebar-specs">
              <dt>Domain</dt>
              <dd>{inquiry.domain}</dd>
              <dt>Inquiry Status</dt>
              <dd>{inquiry.status}</dd>
              <dt>Artifacts</dt>
              <dd>
                {inquiry.githubUrl ? (
                  <a href={inquiry.githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link">
                    Public GitHub Code ↗
                  </a>
                ) : (
                  'Active Lab'
                )}
              </dd>
            </dl>

            <div class="sidebar-cta-box">
              <p class="sidebar-cta-text">Interested in discussing these research findings?</p>
              <a href="/contact" class="sidebar-btn">
                Contact Uzair →
              </a>
            </div>
          </div>
        </aside>
      </div>

      {relatedProjects.length > 0 && (
        <section class="related-section">
          <h2 class="related-heading">Related Engineering Systems & Implementations</h2>
          <div class="related-grid">
            {relatedProjects.map((rel) => (
              <ProjectCard project={rel!} />
            ))}
          </div>
        </section>
      )}

      <ContactCallout
        title="Explore collaborating on this research?"
        subtitle="Open to technical exchanges, empirical data validation, and joint quantitative modeling."
      />
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(researchSchema)} />
  </div>
</BaseLayout>

<style>
  .research-detail-page {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1rem 0 5rem;
  }

  .research-header {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle, #1e293b);
    margin-bottom: 3.5rem;
  }

  .badge-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .domain-pill {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #60a5fa);
  }

  .status-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .badge-exploring {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .badge-experimenting {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .badge-building {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .research-headline {
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 1.25rem 0;
  }

  .lead-summary {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .meta-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.75rem;
    padding: 1.25rem 1.75rem;
    margin-bottom: 2rem;
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #94a3b8);
  }

  .meta-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary, #f8fafc);
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .cta-primary:hover {
    background: #2563eb;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .research-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.015em;
  }

  .research-section p {
    font-size: 1.05rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.75;
    margin: 0 0 1rem 0;
  }

  .question-callout {
    background: rgba(59, 130, 246, 0.08);
    border-left: 3px solid var(--color-accent, #3b82f6);
    padding: 1.25rem 1.5rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .question-text {
    font-size: 1.15rem !important;
    font-weight: 600;
    color: var(--text-primary, #f8fafc) !important;
    line-height: 1.5 !important;
    margin: 0 !important;
  }

  .hypothesis-card {
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
  }

  .hypothesis-card p {
    margin: 0;
    color: var(--text-secondary, #cbd5e1);
  }

  .bullet-list {
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bullet-list li {
    font-size: 1.025rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.65;
  }

  .math-block {
    background: #060911;
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.5rem;
    padding: 1.5rem;
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    color: #60a5fa;
    line-height: 1.6;
  }

  .findings-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .finding-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .finding-status {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .status-confirmed {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .status-active {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .finding-desc {
    font-size: 0.95rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.5;
    margin: 0 !important;
  }

  .references-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ref-item {
    font-size: 0.95rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .ref-item::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent, #60a5fa);
  }

  .ref-link {
    color: var(--color-accent, #60a5fa);
    text-decoration: none;
    margin-left: 0.5rem;
  }

  .ref-link:hover {
    text-decoration: underline;
  }

  .sticky-sidebar-card {
    position: sticky;
    top: 5rem;
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.75rem;
    padding: 1.75rem;
  }

  .sidebar-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle, #1e293b);
  }

  .sidebar-specs {
    margin: 0 0 1.5rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .sidebar-specs dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted, #94a3b8);
  }

  .sidebar-specs dd {
    font-size: 0.95rem;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 0.5rem 0;
  }

  .ext-link {
    color: var(--color-accent, #60a5fa);
    text-decoration: none;
  }

  .ext-link:hover {
    text-decoration: underline;
  }

  .sidebar-cta-box {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle, #1e293b);
  }

  .sidebar-cta-text {
    font-size: 0.9rem;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 1rem;
  }

  .sidebar-btn {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-accent, #60a5fa);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .sidebar-btn:hover {
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
  }

  .related-section {
    margin: 5rem 0 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-subtle, #1e293b);
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 2rem 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .sticky-sidebar-card {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
