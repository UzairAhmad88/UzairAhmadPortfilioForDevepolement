---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import LabItemCard from '@/components/cards/LabItemCard.astro';
import WorkbenchPrinciple from '@/components/lab/WorkbenchPrinciple.astro';
import LabFilters from '@/components/lab/LabFilters.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { getAllLabItems } from '@/data/lab';
import { siteConfig } from '@/data/site';

const labItems = getAllLabItems();

const allTypes = ['All', ...Array.from(new Set(labItems.map((item) => item.type)))];

const promotedItems = labItems.filter((item) => Boolean(item.promotedToProject));

const seo = {
  title: `Lab & Experimental Workbench | ${siteConfig.name}`,
  description: 'Public engineering workbench of Uzair Ahmad: prototypes, quantitative algorithm explorations, multi-agent state machines, and proof-of-concepts.',
  canonical: `${siteConfig.url}/lab`,
};
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={[{ label: 'Lab', href: '/lab' }]} />

    <!-- Workbench Hero -->
    <section class="lab-hero">
      <SectionHeader
        eyebrow="Experimental Workbench"
        title="The Engineering Lab"
        subtitle="A dedicated workspace for hands-on experiments, algorithmic prototypes, mathematical explorations, and intentional technical tests. Here, ideas are built to test hypotheses, understand complex systems, and determine what is worth engineering further."
      />
    </section>

    <!-- Workbench Principle Editorial Callout -->
    <WorkbenchPrinciple />

    <!-- Filter Controls & Dynamic Counter -->
    <LabFilters types={allTypes} totalCount={labItems.length} />

    <!-- Workbench Experiments Grid -->
    <section class="lab-grid-section" aria-label="Lab Experiments">
      <div class="lab-grid" id="lab-items-grid">
        {labItems.map((item) => (
          <div data-item-type={item.type} data-item-status={item.status} class="lab-item-wrapper">
            <LabItemCard item={item} />
          </div>
        ))}
      </div>

      <!-- Empty Filter State -->
      <div id="empty-state" class="empty-state hidden" role="region" aria-label="No Results">
        <div class="empty-icon" aria-hidden="true">🔬</div>
        <h3 class="empty-heading">No experiments match this filter</h3>
        <p class="empty-text">There are currently no active experiments under this category in the lab workbench.</p>
        <button type="button" id="clear-filter-btn" class="clear-btn">
          Clear Filter & Show All Experiments
        </button>
      </div>
    </section>

    <!-- Graduated Systems Section -->
    {promotedItems.length > 0 && (
      <section class="graduated-section" aria-labelledby="graduated-heading">
        <div class="graduated-header">
          <span class="graduated-eyebrow">Evolution Lifecycle</span>
          <h2 id="graduated-heading" class="graduated-title">Experiments Promoted to Production Systems</h2>
          <p class="graduated-subtitle">
            When an algorithmic prototype or architectural exploration proves successful, its patterns and code contracts are graduated into primary production systems.
          </p>
        </div>

        <div class="graduated-grid">
          {promotedItems.map((item) => (
            <article class="graduated-card">
              <div class="graduated-card-content">
                <span class="graduated-type">{item.type}</span>
                <h3 class="graduated-card-title">
                  {item.title.includes(':') ? item.title.split(':').slice(1).join(':').trim() : item.title}
                </h3>
                <p class="graduated-desc">{item.shortDescription}</p>
              </div>
              <footer class="graduated-card-footer">
                <a href={`/lab/${item.slug}`} class="graduated-link">
                  View Experiment →
                </a>
                <a href={`/work/${item.promotedToProject}`} class="graduated-link project-link">
                  View Production Case Study ↗
                </a>
              </footer>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Collaboration Callout -->
    <ContactCallout
      title="Interested in collaborating on an experiment?"
      subtitle="Open to exploring algorithmic models, state-machine architectures, and high-performance prototypes."
    />
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .lab-hero {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lab-grid-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .lab-item-wrapper {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    text-align: center;
    padding: clamp(3rem, 5vw, 4.5rem) 1.5rem;
    border: 1px dashed var(--color-border, rgba(246, 241, 232, 0.15));
    border-radius: 0.875rem;
    background: var(--color-surface, rgba(16, 26, 23, 0.5));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .empty-state.hidden {
    display: none;
  }

  .empty-icon {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .empty-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0;
  }

  .empty-text {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 480px;
    margin: 0;
    line-height: 1.55;
  }

  .clear-btn {
    margin-top: 0.5rem;
    padding: 0.55rem 1.25rem;
    border-radius: 0.375rem;
    background: rgba(126, 216, 196, 0.15);
    border: 1px solid var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .clear-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #090d16;
  }

  .graduated-section {
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .graduated-header {
    margin-bottom: 1.75rem;
  }

  .graduated-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.35rem;
  }

  .graduated-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .graduated-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .graduated-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .graduated-card {
    background: var(--color-surface-card, rgba(16, 26, 23, 0.75));
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.09));
    border-radius: 0.875rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    box-shadow: var(--shadow-sm);
  }

  .graduated-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent, #7ed8c4);
    box-shadow: var(--shadow-card, 0 8px 24px rgba(0, 0, 0, 0.3));
  }

  .graduated-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .graduated-type {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .graduated-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0;
    line-height: 1.35;
  }

  .graduated-desc {
    font-size: 0.825rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .graduated-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    gap: 0.5rem;
  }

  .graduated-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    font-weight: 600;
  }

  .graduated-link:hover {
    text-decoration: underline;
  }

  .project-link {
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
  }

  @media (max-width: 900px) {
    .lab-grid {
      grid-template-columns: 1fr;
    }

    .graduated-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .graduated-section,
  :global([data-theme="light"]) .graduated-section {
    border-top-color: rgba(20, 31, 28, 0.1) !important;
  }

  :global(html[data-theme="light"]) .graduated-title,
  :global([data-theme="light"]) .graduated-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .graduated-subtitle,
  :global([data-theme="light"]) .graduated-subtitle {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .graduated-eyebrow,
  :global([data-theme="light"]) .graduated-eyebrow {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .graduated-card,
  :global([data-theme="light"]) .graduated-card {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .graduated-card:hover,
  :global([data-theme="light"]) .graduated-card:hover {
    background: #ffffff !important;
    border-color: #0d7663 !important;
    box-shadow: 0 8px 24px rgba(20, 31, 28, 0.09) !important;
  }

  :global(html[data-theme="light"]) .graduated-card-title,
  :global([data-theme="light"]) .graduated-card-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .graduated-desc,
  :global([data-theme="light"]) .graduated-desc {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .graduated-type,
  :global([data-theme="light"]) .graduated-type {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .graduated-card-footer,
  :global([data-theme="light"]) .graduated-card-footer {
    border-top-color: rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .graduated-link,
  :global([data-theme="light"]) .graduated-link {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .project-link,
  :global([data-theme="light"]) .project-link {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .empty-state,
  :global([data-theme="light"]) .empty-state {
    background: rgba(20, 31, 28, 0.02) !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
  }

  :global(html[data-theme="light"]) .empty-heading,
  :global([data-theme="light"]) .empty-heading {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .empty-text,
  :global([data-theme="light"]) .empty-text {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .clear-btn,
  :global([data-theme="light"]) .clear-btn {
    background: rgba(13, 118, 99, 0.08) !important;
    border-color: #0d7663 !important;
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .clear-btn:hover,
  :global([data-theme="light"]) .clear-btn:hover {
    background: #0d7663 !important;
    color: #ffffff !important;
  }
</style>

<script>
  function setupFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
    const items = document.querySelectorAll<HTMLElement>('.lab-item-wrapper');
    const countDisplay = document.getElementById('item-count');
    const emptyState = document.getElementById('empty-state');
    const clearBtn = document.getElementById('clear-filter-btn');

    function applyFilter(selectedType: string) {
      let visibleCount = 0;

      filterButtons.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-filter-type') === selectedType;
        btn.classList.toggle('active', isCurrent);
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });

      items.forEach((item) => {
        const itemType = item.getAttribute('data-item-type');
        if (selectedType === 'All' || itemType === selectedType) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countDisplay) countDisplay.textContent = visibleCount.toString();
      if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);

      // Sync URL search param
      const url = new URL(window.location.href);
      if (selectedType === 'All') {
        url.searchParams.delete('type');
      } else {
        url.searchParams.set('type', selectedType);
      }
      window.history.replaceState({}, '', url.toString());
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-filter-type') || 'All';
        applyFilter(type);
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        applyFilter('All');
      });
    }

    // Check URL params on initial load
    const params = new URLSearchParams(window.location.search);
    const initialType = params.get('type');
    if (initialType) {
      applyFilter(initialType);
    }
  }

  // Setup on initial load and Astro client-side navigation
  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
