---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import LabItemCard from '@/components/cards/LabItemCard.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { getAllLabItems } from '@/data/lab';
import { siteConfig } from '@/data/site';

const labItems = getAllLabItems();

const allTypes = ['All', ...Array.from(new Set(labItems.map((item) => item.type)))];

const promotedItems = labItems.filter((item) => Boolean(item.promotedToProject));

const seo = {
  title: `Lab & Experimental Workbench | ${siteConfig.name}`,
  description: 'Public engineering workbench of Uzair Ahmad: prototypes, quantitative algorithm explorations, multi-agent state machines, and proof-of-concepts.',
  canonical: `${siteConfig.url}/lab`,
};
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={[{ label: 'Lab', href: '/lab' }]} />

    <!-- Workbench Hero -->
    <section class="lab-hero">
      <SectionHeader
        eyebrow="Experimental Workbench"
        title="The Engineering Lab"
        subtitle="A dedicated workspace for hands-on experiments, algorithmic prototypes, mathematical explorations, and intentional technical tests. Here, ideas are built to test hypotheses, understand complex systems, and determine what is worth engineering further."
      />
    </section>

    <!-- Workbench Philosophy Callout -->
    <section class="philosophy-section">
      <div class="philosophy-box">
        <div class="philosophy-header">
          <span class="philosophy-icon" aria-hidden="true">ℹ</span>
          <span class="philosophy-eyebrow">THE WORKBENCH PRINCIPLE</span>
        </div>
        <p class="philosophy-text">
          Not every experiment needs to become a production product. Some exist to test an algorithm, explore memory vs. stationarity, isolate an async runtime failure, or evaluate state machine guardrails. Unfinished or abandoned experiments are documented with equal technical honesty.
        </p>
      </div>
    </section>

    <!-- Filter Controls -->
    <section class="filter-section" aria-label="Filter Workbench Items">
      <div class="filter-bar">
        <div class="filter-group" id="type-filter-group">
          <span class="filter-label">Type:</span>
          {allTypes.map((type) => (
            <button
              type="button"
              data-filter-type={type}
              class:list={['filter-pill', type === 'All' ? 'active' : '']}
            >
              {type}
            </button>
          ))}
        </div>

        <div class="item-count-badge">
          Showing <span id="item-count" class="count-number">{labItems.length}</span> active experiments
        </div>
      </div>
    </section>

    <!-- Workbench Experiments Grid -->
    <section class="lab-grid-section" aria-label="Lab Experiments">
      <div class="lab-grid" id="lab-items-grid">
        {labItems.map((item) => (
          <div data-item-type={item.type} data-item-status={item.status} class="lab-item-wrapper">
            <LabItemCard item={item} />
          </div>
        ))}
      </div>

      <div id="empty-state" class="empty-state hidden">
        <p class="empty-text">No experiments match the selected filter.</p>
      </div>
    </section>

    <!-- Graduated Systems Section -->
    {promotedItems.length > 0 && (
      <section class="graduated-section">
        <div class="graduated-header">
          <span class="graduated-eyebrow">Evolution Lifecycle</span>
          <h2 class="graduated-title">Experiments Promoted to Production Systems</h2>
          <p class="graduated-subtitle">
            When an algorithmic prototype or architectural exploration proves successful, its patterns are integrated into primary projects.
          </p>
        </div>

        <div class="graduated-grid">
          {promotedItems.map((item) => (
            <div class="graduated-card">
              <div class="graduated-card-content">
                <span class="graduated-type">{item.type}</span>
                <h3 class="graduated-card-title">{item.title.split(':')[0]}</h3>
                <p class="graduated-desc">{item.shortDescription}</p>
              </div>
              <div class="graduated-card-footer">
                <a href={`/lab/${item.slug}`} class="graduated-link">
                  View Experiment →
                </a>
                <a href={`/work/${item.promotedToProject}`} class="graduated-link project-link">
                  View Project ↗
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <ContactCallout
      title="Interested in collaborating on an experiment?"
      subtitle="Open to exploring algorithmic models, state-machine architectures, and high-performance prototypes."
    />
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .lab-hero {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .philosophy-section {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .philosophy-box {
    background: var(--color-surface-elevated, rgba(16, 26, 23, 0.65));
    border: 1px solid var(--color-accent-muted, rgba(126, 216, 196, 0.2));
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm);
  }

  .philosophy-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .philosophy-icon {
    font-size: 0.95rem;
    color: var(--color-accent, #7ed8c4);
  }

  .philosophy-eyebrow {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
  }

  .philosophy-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.65;
    margin: 0;
  }

  .filter-section {
    margin-bottom: 2rem;
  }

  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    color: #83968e;
    margin-right: 0.25rem;
  }

  .filter-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-text-muted, #a9b8b1);
    cursor: pointer;
    transition: all 150ms ease;
    min-height: 36px;
  }

  .filter-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-text, #f6f1e8);
    border-color: rgba(126, 216, 196, 0.25);
  }

  .filter-pill.active {
    background: rgba(126, 216, 196, 0.15);
    border-color: rgba(126, 216, 196, 0.4);
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .item-count-badge {
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .count-number {
    color: var(--color-text, #f6f1e8);
    font-weight: 700;
  }

  .lab-grid-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .lab-item-wrapper {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1.5rem;
    border: 1px dashed rgba(246, 241, 232, 0.12);
    border-radius: 0.75rem;
    background: rgba(16, 26, 23, 0.5);
  }

  .empty-state.hidden {
    display: none;
  }

  .empty-text {
    font-size: 0.875rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    margin: 0;
  }

  .graduated-section {
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .graduated-header {
    margin-bottom: 1.5rem;
  }

  .graduated-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.35rem;
  }

  .graduated-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .graduated-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 650px;
    line-height: 1.55;
    margin: 0;
  }

  .graduated-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .graduated-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .graduated-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .graduated-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .graduated-type {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
  }

  .graduated-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0;
  }

  .graduated-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .graduated-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .graduated-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    font-weight: 600;
  }

  .graduated-link:hover {
    text-decoration: underline;
  }

  .project-link {
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .lab-grid {
      grid-template-columns: 1fr;
    }

    .graduated-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-theme="light"]) .philosophy-box,
  :global([data-theme="light"]) .philosophy-box {
    background: #ffffff !important;
    border: 1px solid rgba(13, 118, 99, 0.25) !important;
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .philosophy-eyebrow,
  :global([data-theme="light"]) .philosophy-eyebrow,
  :global(html[data-theme="light"]) .philosophy-icon,
  :global([data-theme="light"]) .philosophy-icon {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .philosophy-text,
  :global([data-theme="light"]) .philosophy-text {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .graduated-card,
  :global([data-theme="light"]) .graduated-card {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .graduated-title,
  :global([data-theme="light"]) .graduated-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .graduated-description,
  :global([data-theme="light"]) .graduated-description {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .filter-pill,
  :global([data-theme="light"]) .filter-pill {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.12);
    color: #35453f;
  }

  :global(html[data-theme="light"]) .filter-pill:hover,
  :global([data-theme="light"]) .filter-pill:hover {
    background: rgba(20, 31, 28, 0.08);
    color: #141f1c;
    border-color: #0d7663;
  }

  :global(html[data-theme="light"]) .filter-pill.active,
  :global([data-theme="light"]) .filter-pill.active {
    background: rgba(13, 118, 99, 0.12) !important;
    border-color: #0d7663 !important;
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .empty-state,
  :global([data-theme="light"]) .empty-state {
    background: rgba(20, 31, 28, 0.02);
    border-color: rgba(20, 31, 28, 0.12);
  }
</style>

<script>
  function setupFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
    const items = document.querySelectorAll<HTMLElement>('.lab-item-wrapper');
    const countDisplay = document.getElementById('item-count');
    const emptyState = document.getElementById('empty-state');

    function applyFilter(selectedType: string) {
      let visibleCount = 0;

      filterButtons.forEach((btn) => {
        if (btn.getAttribute('data-filter-type') === selectedType) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      items.forEach((item) => {
        const itemType = item.getAttribute('data-item-type');
        if (selectedType === 'All' || itemType === selectedType) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countDisplay) countDisplay.textContent = visibleCount.toString();
      if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);

      // Update URL search param
      const url = new URL(window.location.href);
      if (selectedType === 'All') {
        url.searchParams.delete('type');
      } else {
        url.searchParams.set('type', selectedType);
      }
      window.history.replaceState({}, '', url.toString());
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-filter-type') || 'All';
        applyFilter(type);
      });
    });

    // Check URL params on initial load
    const params = new URLSearchParams(window.location.search);
    const initialType = params.get('type');
    if (initialType) {
      applyFilter(initialType);
    }
  }

  // Setup on initial load and Astro client-side navigation
  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
