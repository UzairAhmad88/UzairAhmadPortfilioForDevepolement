---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisualization from '@/components/visualizations/ProjectVisualization.astro';
import RelatedKnowledgeGrid from '@/components/knowledge/RelatedKnowledgeGrid.astro';
import VercelEvidenceBadge from '@/components/vercel/VercelEvidenceBadge.astro';
import { getVercelEvidenceForLab } from '@/lib/vercel/evidence';
import { getAllLabItems } from '@/data/lab';
import { projects } from '@/data/projects';
import { getTechnologyById } from '@/data/technologies';
import { siteConfig } from '@/data/site';
import type { LabItem } from '@/types/lab';
import type { Technology } from '@/types/technology';

export function getStaticPaths() {
  const items = getAllLabItems();
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

export interface Props {
  item: LabItem;
}

const { item } = Astro.props;

const technologyObjects: Technology[] = (item.technologies || [])
  .map((id) => getTechnologyById(id))
  .filter((t): t is Technology => Boolean(t));

const promotedProject = item.promotedToProject
  ? projects.find((p) => p.slug === item.promotedToProject)
  : undefined;

const statusColors: Record<string, string> = {
  Completed: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Active: 'bg-[rgba(126,216,196,0.1)] text-[#7ed8c4] border-[rgba(126,216,196,0.3)]',
  Prototype: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Validating: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Exploring: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Paused: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Abandoned: 'bg-rose-500/10 text-rose-400 border-rose-500/30',
  Idea: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};

const statusClass = statusColors[item.status] || 'bg-slate-500/10 text-slate-400 border-slate-500/30';

const seo = {
  title: `${item.title} | Lab Workbench | ${siteConfig.name}`,
  description: item.shortDescription,
  canonical: `${siteConfig.url}/lab/${item.slug}`,
};

const vercelEvidence = getVercelEvidenceForLab(item.id || item.slug);
---

<BaseLayout seo={seo}>
  <main id="top" class="lab-detail-page py-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-8" aria-label="Breadcrumbs">
        <ol class="flex items-center space-x-2 text-xs font-mono text-[#83968e]">
          <li><a href="/" class="hover:text-[#7ed8c4] transition-colors">Home</a></li>
          <li class="text-[#83968e]">/</li>
          <li><a href="/lab" class="hover:text-[#7ed8c4] transition-colors">Lab</a></li>
          <li class="text-[#83968e]">/</li>
          <li class="text-[#f6f1e8] truncate max-w-[200px] sm:max-w-xs" aria-current="page">{item.slug}</li>
        </ol>
      </nav>

      <!-- Experiment Header -->
      <header class="mb-12 border-b border-[rgba(246,241,232,0.08)] pb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class={`px-2.5 py-1 rounded-full border text-xs font-mono font-semibold tracking-wider ${statusClass}`}>
            {item.status.toUpperCase()}
          </span>
          <span class="px-2.5 py-1 rounded border border-[rgba(246,241,232,0.08)] bg-[rgba(255,255,255,0.04)] text-xs font-mono text-[#83968e] uppercase tracking-wider font-semibold">
            {item.type}
          </span>
          <span class="px-2.5 py-1 rounded border border-[rgba(246,241,232,0.08)] bg-[rgba(16,26,23,0.75)] text-xs font-mono text-[#83968e]">
            STATE: {item.state.toUpperCase()}
          </span>
          <span class="text-xs font-mono text-[#83968e] ml-auto">
            {item.date} {item.updatedAt ? `(Updated: ${item.updatedAt})` : ''}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[#f6f1e8] mb-4 leading-tight">
          {item.title}
        </h1>

        <p class="text-base sm:text-lg text-[#a9b8b1] leading-relaxed">
          {item.description}
        </p>

        <!-- Promoted Callout if applicable -->
        {promotedProject && (
          <div class="mt-6 rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs font-mono text-emerald-300 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2">
              <span class="text-base">🚀</span>
              <span><strong>Evolution:</strong> This experiment successfully graduated into the production system: <strong>{promotedProject.title}</strong></span>
            </div>
            <a href={`/work/${promotedProject.slug}`} class="text-emerald-400 underline font-semibold hover:text-emerald-300 shrink-0">
              Inspect Project Case Study →
            </a>
          </div>
        )}

        {vercelEvidence && (
          <div class="mt-6">
            <VercelEvidenceBadge evidence={vercelEvidence} showGitLink={true} />
          </div>
        )}

        <!-- Technology Pills -->
        <div class="mt-6 flex flex-wrap items-center gap-2 pt-4 border-t border-[rgba(246,241,232,0.08)]">
          <span class="text-xs font-mono text-[#83968e] mr-2">Ecosystem:</span>
          {technologyObjects.map((tech) => (
            <a
              href={`/technology/${tech.id}`}
              class="rounded bg-[rgba(255,255,255,0.04)] hover:bg-[rgba(126,216,196,0.1)] hover:text-[#7ed8c4] hover:border-[rgba(126,216,196,0.35)] border border-[rgba(246,241,232,0.08)] px-2.5 py-1 font-mono text-xs text-[#f6f1e8] transition-colors"
            >
              {tech.name}
            </a>
          ))}
        </div>
      </header>

      <!-- Section 01: Question & Hypothesis -->
      <section class="mb-10 rounded-xl border border-[rgba(126,216,196,0.25)] bg-[rgba(126,216,196,0.05)] p-6 sm:p-8">
        <div class="flex items-center gap-2 text-xs font-mono text-[#7ed8c4] font-semibold uppercase tracking-wider mb-3">
          <span>01 / Core Question & Hypothesis</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-[#f6f1e8] mb-3">
          {item.question}
        </h2>
        {item.hypothesis && (
          <p class="text-sm text-[#f6f1e8] leading-relaxed font-mono bg-[rgba(16,26,23,0.85)] p-3.5 rounded border border-[rgba(126,216,196,0.2)] mt-4">
            <strong class="text-[#7ed8c4]">Hypothesis:</strong> {item.hypothesis}
          </p>
        )}
        {item.intent && (
          <p class="text-sm text-[#a9b8b1] leading-relaxed mt-4">
            <strong class="text-[#f6f1e8]">Intent:</strong> {item.intent}
          </p>
        )}
      </section>

      <!-- Section 02: Context & Motivation -->
      <section class="mb-12 space-y-4">
        <h2 class="text-xs font-mono text-[#83968e] uppercase tracking-widest">
          02 / Context & Technical Motivation
        </h2>
        <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 space-y-4 text-sm text-[#a9b8b1] leading-relaxed">
          <p>{item.context}</p>
          {item.motivation && <p class="text-[#83968e]">{item.motivation}</p>}
        </div>
      </section>

      <!-- Section 03: Experiment & Implementation -->
      <section class="mb-12 space-y-4">
        <h2 class="text-xs font-mono text-[#83968e] uppercase tracking-widest">
          03 / Experimentation & Implementation
        </h2>
        <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 space-y-4 text-sm text-[#a9b8b1] leading-relaxed">
          <p>{item.experiment}</p>
          {item.implementation && <p class="text-[#83968e]">{item.implementation}</p>}

          {item.technicalDecisions && item.technicalDecisions.length > 0 && (
            <div class="mt-4 pt-4 border-t border-[rgba(246,241,232,0.08)]">
              <h3 class="text-xs font-mono text-[#f6f1e8] uppercase tracking-wider mb-2">Key Technical Decisions:</h3>
              <ul class="space-y-2 list-disc list-inside text-xs font-mono text-[#83968e]">
                {item.technicalDecisions.map((decision) => (
                  <li>{decision}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Code Snippets if present -->
        {item.codeSnippets && item.codeSnippets.map((snippet) => (
          <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.9)] overflow-hidden my-6">
            {snippet.title && (
              <div class="bg-[rgba(7,17,15,0.95)] px-4 py-2 text-xs font-mono text-[#83968e] border-b border-[rgba(246,241,232,0.08)] flex items-center justify-between">
                <span>{snippet.title}</span>
                <span class="text-[10px] uppercase text-[#83968e]">{snippet.language}</span>
              </div>
            )}
            <pre class="p-4 overflow-x-auto text-xs font-mono text-[#f6f1e8] leading-relaxed bg-[rgba(7,17,15,0.95)]"><code>{snippet.code}</code></pre>
            {snippet.caption && (
              <div class="px-4 py-2 text-[11px] font-mono text-[#83968e] bg-[rgba(7,17,15,0.8)] border-t border-[rgba(246,241,232,0.06)]">
                {snippet.caption}
              </div>
            )}
          </div>
        ))}
      </section>

      <!-- Section 04: Visualizations & Architecture -->
      {item.visualizations && item.visualizations.length > 0 && (
        <section class="mb-12 space-y-4">
          <h2 class="text-xs font-mono text-[#83968e] uppercase tracking-widest">
            04 / Architecture & Flow Diagrams
          </h2>
          {item.visualizations.map((vis) => (
            <ProjectVisualization visualization={vis} />
          ))}
        </section>
      )}

      <!-- Section 05: Observations & Empirical Results -->
      <section class="mb-12 space-y-4">
        <h2 class="text-xs font-mono text-[#83968e] uppercase tracking-widest">
          05 / Observations & Empirical Results
        </h2>
        <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 space-y-4">
          <div class="flex items-center gap-3 border-b border-[rgba(246,241,232,0.08)] pb-3">
            <span class="text-xs font-mono text-[#83968e]">Outcome Classification:</span>
            <span class="text-xs font-mono font-semibold text-[#f6f1e8] bg-[rgba(255,255,255,0.04)] px-2.5 py-1 rounded border border-[rgba(246,241,232,0.08)]">
              {item.resultOutcome}
            </span>
          </div>

          <p class="text-sm text-[#a9b8b1] leading-relaxed">{item.result}</p>

          {item.observations && item.observations.length > 0 && (
            <div class="pt-2">
              <h3 class="text-xs font-mono text-[#f6f1e8] uppercase tracking-wider mb-2">Empirical Observations:</h3>
              <ul class="space-y-2 text-xs font-mono text-[#83968e]">
                {item.observations.map((obs) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#7ed8c4]">→</span>
                    <span>{obs}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>

      <!-- Section 06: Limitations & Lessons Learned -->
      <section class="mb-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {item.limitations && item.limitations.length > 0 && (
          <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 space-y-3">
            <h2 class="text-xs font-mono text-amber-400 uppercase tracking-wider font-semibold">
              Known Limitations & Caveats
            </h2>
            <ul class="space-y-2 text-xs font-mono text-[#83968e]">
              {item.limitations.map((lim) => (
                <li class="flex items-start gap-2">
                  <span class="text-amber-500">•</span>
                  <span>{lim}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {item.lessonsLearned && item.lessonsLearned.length > 0 && (
          <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 space-y-3">
            <h2 class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">
              Lessons Learned
            </h2>
            <ul class="space-y-2 text-xs font-mono text-[#83968e]">
              {item.lessonsLearned.map((lesson) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400">✓</span>
                  <span>{lesson}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <!-- Section 07: Next Steps -->
      {item.nextStep && (
        <section class="mb-12">
          <h2 class="text-xs font-mono text-[#83968e] uppercase tracking-widest mb-3">
            07 / Next Step & Evolution
          </h2>
          <div class="rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-5 text-xs font-mono text-[#a9b8b1]">
            <p><strong class="text-[#7ed8c4]">Workbench Action:</strong> {item.nextStep}</p>
          </div>
        </section>
      )}

      <!-- Section 08: Knowledge Graph & Cross-System Bidirectional Relationships -->
      <RelatedKnowledgeGrid
        type="lab"
        slug={item.slug}
        title="Knowledge Graph & Cross-System Connections"
        subtitle="Connected software implementations, research investigations, engineering notes, and foundational technologies."
      />

      <!-- Back Navigation Bar -->
      <div class="border-t border-[rgba(246,241,232,0.08)] pt-6 flex items-center justify-between text-xs font-mono">
        <a href="/lab" class="text-[#7ed8c4] hover:underline font-semibold">
          ← Back to Experimental Workbench
        </a>
        <a href="#top" class="text-[#83968e] hover:text-[#f6f1e8]">
          Back to Top ↑
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
