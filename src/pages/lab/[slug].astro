---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectVisualization from '@/components/visualizations/ProjectVisualization.astro';
import RelatedKnowledgeGrid from '@/components/knowledge/RelatedKnowledgeGrid.astro';
import VercelEvidenceBadge from '@/components/vercel/VercelEvidenceBadge.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { getVercelEvidenceForLab } from '@/lib/vercel/evidence';
import { getAllLabItems } from '@/data/lab';
import { projects } from '@/data/projects';
import { getTechnologyById } from '@/data/technologies';
import { siteConfig } from '@/data/site';
import type { LabItem } from '@/types/lab';
import type { Technology } from '@/types/technology';

export function getStaticPaths() {
  const items = getAllLabItems();
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

export interface Props {
  item: LabItem;
}

const { item } = Astro.props;

const technologyObjects: Technology[] = (item.technologies || [])
  .map((id) => getTechnologyById(id))
  .filter((t): t is Technology => Boolean(t));

const promotedProject = item.promotedToProject
  ? projects.find((p) => p.slug === item.promotedToProject)
  : undefined;

const statusClassMap: Record<string, string> = {
  Completed: 'status-completed',
  Active: 'status-active',
  Prototype: 'status-prototype',
  Validating: 'status-validating',
  Exploring: 'status-exploring',
  Paused: 'status-paused',
  Archived: 'status-archived',
  Abandoned: 'status-abandoned',
  Idea: 'status-idea',
};

const statusClass = statusClassMap[item.status] || 'status-default';

const seo = {
  title: `${item.title} | Lab Workbench | ${siteConfig.name}`,
  description: item.shortDescription,
  canonical: `${siteConfig.url}/lab/${item.slug}`,
};

const vercelEvidence = getVercelEvidenceForLab(item.id || item.slug);
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs
      items={[
        { label: 'Lab', href: '/lab' },
        { label: item.title, href: `/lab/${item.slug}` },
      ]}
    />

    <article class="lab-detail-container">
      <!-- Experiment Header -->
      <header class="lab-header">
        <div class="header-meta-row">
          <div class="header-badges">
            <span class:list={['status-pill', statusClass]}>
              {item.status.toUpperCase()}
            </span>
            <span class="type-pill">
              {item.type}
            </span>
            <span class="state-pill">
              STATE: {item.state.toUpperCase()}
            </span>
          </div>
          <span class="timestamp-label">
            {item.date} {item.updatedAt ? `(Updated: ${item.updatedAt})` : ''}
          </span>
        </div>

        <h1 class="lab-title">
          {item.title}
        </h1>

        <p class="lab-lead">
          {item.description}
        </p>

        <!-- Promoted Callout if applicable -->
        {promotedProject && (
          <div class="promoted-callout">
            <div class="promoted-content">
              <span class="promoted-icon" aria-hidden="true">🚀</span>
              <span class="promoted-text">
                <strong>Evolution:</strong> This experiment successfully graduated into the production system: <strong>{promotedProject.title}</strong>
              </span>
            </div>
            <a href={`/work/${promotedProject.slug}`} class="promoted-link">
              Inspect Project Case Study →
            </a>
          </div>
        )}

        {vercelEvidence && (
          <div class="evidence-wrapper">
            <VercelEvidenceBadge evidence={vercelEvidence} showGitLink={true} />
          </div>
        )}

        <!-- Technology Pills -->
        {technologyObjects.length > 0 && (
          <div class="ecosystem-strip">
            <span class="ecosystem-label">Ecosystem:</span>
            <div class="ecosystem-tags">
              {technologyObjects.map((tech) => (
                <a href={`/technology/${tech.id}`} class="ecosystem-tag">
                  {tech.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </header>

      <!-- Main Body Layout -->
      <div class="lab-body-layout">
        <!-- Section 01: Question & Hypothesis -->
        <section class="section-box hypothesis-box">
          <div class="section-eyebrow accent-text">
            01 / Core Question & Hypothesis
          </div>
          <h2 class="question-headline">
            {item.question}
          </h2>
          {item.hypothesis && (
            <div class="hypothesis-highlight">
              <strong class="highlight-label">Hypothesis:</strong>
              <p class="highlight-text">{item.hypothesis}</p>
            </div>
          )}
          {item.intent && (
            <p class="intent-text">
              <strong>Intent:</strong> {item.intent}
            </p>
          )}
        </section>

        <!-- Section 02: Context & Motivation -->
        <section class="section-box">
          <h2 class="section-heading">
            02 / Context & Technical Motivation
          </h2>
          <div class="section-card-body">
            <p>{item.context}</p>
            {item.motivation && <p class="muted-text">{item.motivation}</p>}
          </div>
        </section>

        <!-- Section 03: Experiment & Implementation -->
        <section class="section-box">
          <h2 class="section-heading">
            03 / Experimentation & Implementation
          </h2>
          <div class="section-card-body">
            <p>{item.experiment}</p>
            {item.implementation && <p class="muted-text">{item.implementation}</p>}

            {item.technicalDecisions && item.technicalDecisions.length > 0 && (
              <div class="decisions-block">
                <h3 class="decisions-title">Key Technical Decisions:</h3>
                <ul class="decisions-list">
                  {item.technicalDecisions.map((decision) => (
                    <li>{decision}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Code Snippets if present -->
          {item.codeSnippets && item.codeSnippets.map((snippet) => (
            <div class="code-snippet-box">
              {snippet.title && (
                <div class="snippet-header">
                  <span class="snippet-title">{snippet.title}</span>
                  <span class="snippet-lang">{snippet.language}</span>
                </div>
              )}
              <pre class="snippet-code"><code>{snippet.code}</code></pre>
              {snippet.caption && (
                <div class="snippet-caption">
                  {snippet.caption}
                </div>
              )}
            </div>
          ))}
        </section>

        <!-- Section 04: Visualizations & Architecture -->
        {item.visualizations && item.visualizations.length > 0 && (
          <section class="section-box">
            <h2 class="section-heading">
              04 / Architecture & Flow Diagrams
            </h2>
            {item.visualizations.map((vis) => (
              <ProjectVisualization visualization={vis} />
            ))}
          </section>
        )}

        <!-- Section 05: Observations & Empirical Results -->
        <section class="section-box">
          <h2 class="section-heading">
            05 / Observations & Empirical Results
          </h2>
          <div class="section-card-body">
            <div class="outcome-classification-row">
              <span class="classification-label">Outcome Classification:</span>
              <span class="classification-value">{item.resultOutcome}</span>
            </div>

            <p>{item.result}</p>

            {item.observations && item.observations.length > 0 && (
              <div class="observations-block">
                <h3 class="observations-title">Empirical Observations:</h3>
                <ul class="observations-list">
                  {item.observations.map((obs) => (
                    <li>
                      <span class="bullet-arrow">→</span>
                      <span>{obs}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>

        <!-- Section 06: Limitations & Lessons Learned -->
        <section class="outcomes-grid-section">
          {item.limitations && item.limitations.length > 0 && (
            <div class="outcome-panel limitations-panel">
              <h2 class="panel-heading limitations-heading">
                Known Limitations & Caveats
              </h2>
              <ul class="panel-list">
                {item.limitations.map((lim) => (
                  <li>
                    <span class="panel-bullet bullet-amber">•</span>
                    <span>{lim}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {item.lessonsLearned && item.lessonsLearned.length > 0 && (
            <div class="outcome-panel lessons-panel">
              <h2 class="panel-heading lessons-heading">
                Lessons Learned
              </h2>
              <ul class="panel-list">
                {item.lessonsLearned.map((lesson) => (
                  <li>
                    <span class="panel-bullet bullet-emerald">✓</span>
                    <span>{lesson}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <!-- Section 07: Next Steps -->
        {item.nextStep && (
          <section class="section-box">
            <h2 class="section-heading">
              07 / Next Step & Evolution
            </h2>
            <div class="action-card">
              <p><strong class="action-highlight">Workbench Action:</strong> {item.nextStep}</p>
            </div>
          </section>
        )}
      </div>

      <!-- Section 08: Knowledge Graph & Cross-System Bidirectional Relationships -->
      <RelatedKnowledgeGrid
        type="lab"
        slug={item.slug}
        title="Knowledge Graph & Cross-System Connections"
        subtitle="Connected software implementations, research investigations, engineering notes, and foundational technologies."
      />

      <!-- Back Navigation Bar -->
      <nav class="back-nav-bar" aria-label="Bottom Navigation">
        <a href="/lab" class="back-link">
          ← Back to Experimental Workbench
        </a>
        <a href="#top" class="top-link">
          Back to Top ↑
        </a>
      </nav>

      <ContactCallout
        title="Want to discuss this experiment?"
        subtitle="Open to reviewing results, reproducing benchmarks, or exploring extensions."
      />
    </article>
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .lab-detail-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .lab-header {
    padding: 1.5rem 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(246, 241, 232, 0.09);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .header-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .header-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .status-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid transparent;
  }

  .status-completed {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border-color: rgba(16, 185, 129, 0.35);
  }

  .status-active {
    background: rgba(126, 216, 196, 0.15);
    color: #7ed8c4;
    border-color: rgba(126, 216, 196, 0.4);
  }

  .status-prototype,
  .status-validating,
  .status-exploring {
    background: rgba(126, 216, 196, 0.1);
    color: #9bd8cf;
    border-color: rgba(126, 216, 196, 0.25);
  }

  .status-paused,
  .status-archived,
  .status-idea,
  .status-default {
    background: rgba(148, 163, 184, 0.12);
    color: #cbd5e1;
    border-color: rgba(148, 163, 184, 0.25);
  }

  .status-abandoned {
    background: rgba(239, 68, 68, 0.12);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .type-pill,
  .state-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.55rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: #83968e;
  }

  .timestamp-label {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .lab-title {
    font-size: var(--font-size-h1, clamp(2rem, 3.8vw, 2.75rem));
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 1.25rem 0;
  }

  .lab-lead {
    font-size: var(--font-size-lead, 1.15rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
    margin: 0;
  }

  .promoted-callout {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.1);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: #a7f3d0;
  }

  .promoted-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .promoted-icon {
    font-size: 1.15rem;
  }

  .promoted-link {
    color: #6ee7b7;
    text-decoration: underline;
    font-weight: 700;
    white-space: nowrap;
  }

  .promoted-link:hover {
    color: #a7f3d0;
  }

  .evidence-wrapper {
    margin-top: 1.25rem;
  }

  .ecosystem-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .ecosystem-label {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    margin-right: 0.25rem;
  }

  .ecosystem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ecosystem-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-text, #f6f1e8);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .ecosystem-tag:hover {
    background: rgba(126, 216, 196, 0.1);
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.35);
  }

  .lab-body-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .section-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hypothesis-box {
    background: rgba(126, 216, 196, 0.05);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .accent-text {
    color: var(--color-accent, #7ed8c4);
  }

  .question-headline {
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0;
    line-height: 1.35;
  }

  .hypothesis-highlight {
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(126, 216, 196, 0.2);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-top: 0.5rem;
  }

  .highlight-label {
    display: block;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .highlight-text {
    font-size: 0.95rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text, #f6f1e8);
    line-height: 1.55;
    margin: 0;
  }

  .intent-text {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0;
  }

  .section-heading {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #83968e;
    margin: 0;
  }

  .section-card-body {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
  }

  .section-card-body p {
    margin: 0;
  }

  .muted-text {
    color: #83968e;
  }

  .decisions-block {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .decisions-title {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .decisions-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .code-snippet-box {
    background: rgba(7, 17, 15, 0.95);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    overflow: hidden;
    margin-top: 0.5rem;
  }

  .snippet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    background: rgba(16, 26, 23, 0.8);
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .snippet-lang {
    text-transform: uppercase;
    font-size: 0.7rem;
    color: var(--color-accent, #7ed8c4);
  }

  .snippet-code {
    padding: 1.25rem;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: #f6f1e8;
    line-height: 1.6;
  }

  .snippet-caption {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    background: rgba(16, 26, 23, 0.6);
    border-top: 1px solid rgba(246, 241, 232, 0.06);
  }

  .outcome-classification-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
  }

  .classification-label {
    color: #83968e;
  }

  .classification-value {
    color: var(--color-text, #f6f1e8);
    font-weight: 700;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(246, 241, 232, 0.08);
  }

  .observations-block {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
  }

  .observations-title {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .observations-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .observations-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .bullet-arrow {
    color: var(--color-accent, #7ed8c4);
    font-weight: 800;
  }

  .outcomes-grid-section {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .outcome-panel {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .panel-heading {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .limitations-heading {
    color: #fbbf24;
  }

  .lessons-heading {
    color: #34d399;
  }

  .panel-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .panel-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .panel-bullet {
    font-weight: 800;
  }

  .bullet-amber {
    color: #f59e0b;
  }

  .bullet-emerald {
    color: #10b981;
  }

  .action-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #a9b8b1);
  }

  .action-card p {
    margin: 0;
  }

  .action-highlight {
    color: var(--color-accent, #7ed8c4);
