---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import DiscoveryResultCard from '@/components/cards/DiscoveryResultCard.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { discoveryItems, discoveryTaxonomy } from '@/data/discovery';
import { siteConfig } from '@/data/site';

const seo = {
  title: `Discovery & Engineering Search | ${siteConfig.name}`,
  description: `Discover projects, quantitative research inquiries, experimental prototypes, engineering notes, and technologies across Uzair Ahmad’s personal platform.`,
  canonical: `${siteConfig.url}/discover`,
};

// Serialize initial items and taxonomy for instant client-side execution
const discoveryDataJson = JSON.stringify({
  items: discoveryItems,
  taxonomy: discoveryTaxonomy,
});
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={[{ label: 'Discover', href: '/discover' }]} />

    <!-- Discovery Header -->
    <section class="discovery-hero">
      <SectionHeader
        eyebrow="Discovery & Relational Search"
        title="Discover Engineering Work & Research"
        subtitle="Search across production software, quantitative research inquiries, experimental workbench prototypes, technical decision logs, and foundational technologies without generic algorithmic rankings."
      />
    </section>

    <!-- Search & Filter Controls Workspace -->
    <section class="controls-section" aria-label="Search and Filter Controls">
      <div class="search-panel">
        <!-- Primary Search Bar -->
        <div class="search-input-wrap">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <input
            type="search"
            id="discovery-search-input"
            placeholder="Search by keyword, technology (e.g. FastAPI, PyTorch), topic, or problem... (Press '/' to focus)"
            class="search-input"
            aria-label="Search all engineering platform content"
            autocomplete="off"
          />
          <div class="shortcut-badge">
            <kbd class="shortcut-key">/</kbd>
          </div>
        </div>

        <!-- Facet Filter Bar -->
        <div class="facet-bar">
          <!-- Content Type Filter Pills -->
          <div class="type-filter-pills" id="type-filter-group" role="group" aria-label="Filter by Content Type">
            <button
              type="button"
              data-type-filter="all"
              class="type-pill active"
              aria-pressed="true"
            >
              All ({discoveryItems.length})
            </button>
            {discoveryTaxonomy.types.map((t) => (
              <button
                type="button"
                data-type-filter={t.type}
                class="type-pill"
                aria-pressed="false"
              >
                {t.label} ({t.count})
              </button>
            ))}
          </div>

          <!-- Dropdown Filters: Technology, Topic -->
          <div class="dropdown-filters">
            <!-- Technology Select -->
            <select
              id="tech-filter-select"
              class="filter-select"
              aria-label="Filter by technology"
            >
              <option value="">All Technologies</option>
              {discoveryTaxonomy.technologies.map((tech) => (
                <option value={tech.id}>
                  {tech.name} ({tech.count})
                </option>
              ))}
            </select>

            <!-- Topic Select -->
            <select
              id="topic-filter-select"
              class="filter-select"
              aria-label="Filter by topic"
            >
              <option value="">All Topics</option>
              {discoveryTaxonomy.topics.map((tp) => (
                <option value={tp.name}>
                  {tp.name} ({tp.count})
                </option>
              ))}
            </select>

            <!-- Reset Action -->
            <button
              type="button"
              id="reset-filters-btn"
              class="reset-btn"
            >
              Reset All
            </button>
          </div>
        </div>
      </div>

      <!-- Active Filters Strip & Results Count Announcer -->
      <div class="results-meta-strip">
        <div id="results-count-announcer" class="count-announcer" aria-live="polite">
          Showing <strong id="results-count-number">{discoveryItems.length}</strong> engineering entities
        </div>
        <div class="match-mode-label">
          <span>Deterministic Keyword & Facet Match</span>
        </div>
      </div>
    </section>

    <!-- Discovery Results Grid -->
    <section class="results-section" aria-label="Search Results">
      <div class="results-grid" id="discovery-results-grid">
        {discoveryItems.map((item) => (
          <DiscoveryResultCard item={item} />
        ))}
      </div>

      <!-- Empty State (Shown when zero results match) -->
      <div id="empty-state-box" class="empty-state-box hidden">
        <div class="empty-icon" aria-hidden="true">🔍</div>
        <h2 class="empty-title">No matching work found</h2>
        <p class="empty-desc">
          No engineering projects, research inquiries, prototypes, or notes match the current search query and filter criteria.
        </p>
        <div class="empty-actions">
          <button
            type="button"
            id="empty-clear-btn"
            class="btn-primary"
          >
            Clear Search & Filters
          </button>
          <a href="/work" class="btn-secondary">
            Browse Projects →
          </a>
          <a href="/knowledge" class="btn-secondary">
            Explore Knowledge Graph ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Knowledge Graph Bridge Callout -->
    <section class="knowledge-bridge-section">
      <div class="bridge-card">
        <div>
          <span class="bridge-eyebrow">Connected Knowledge Layer</span>
          <h2 class="bridge-title">Prefer exploring via topological graph?</h2>
          <p class="bridge-desc">
            The Knowledge Graph provides an interactive visual map of all 46 entities and 172 deterministic bidirectional connections.
          </p>
        </div>
        <a href="/knowledge" class="bridge-btn">
          <span>Open Knowledge Graph</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <ContactCallout
      title="Looking for a specific system or inquiry?"
      subtitle="Open to discussing system specifications, research methodologies, and architecture patterns."
    />
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .discovery-hero {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .controls-section {
    margin-bottom: 2.5rem;
  }

  .search-panel {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    pointer-events: none;
    font-size: 0.95rem;
  }

  .search-input {
    width: 100%;
    background: rgba(7, 17, 15, 0.95);
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 0.5rem;
    padding: 0.75rem 3rem 0.75rem 2.75rem;
    font-size: 0.875rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text, #f6f1e8);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent, #7ed8c4);
    box-shadow: 0 0 16px rgba(126, 216, 196, 0.2);
  }

  .search-input::placeholder {
    color: #83968e;
  }

  .shortcut-badge {
    position: absolute;
    right: 0.85rem;
    pointer-events: none;
  }

  .shortcut-key {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.25rem;
  }

  .facet-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .type-filter-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .type-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-text-muted, #a9b8b1);
    cursor: pointer;
    transition: all 150ms ease;
    min-height: 34px;
  }

  .type-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-text, #f6f1e8);
    border-color: rgba(126, 216, 196, 0.25);
  }

  .type-pill.active {
    background: rgba(126, 216, 196, 0.15);
    border-color: rgba(126, 216, 196, 0.4);
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .dropdown-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-select {
    background: rgba(7, 17, 15, 0.95);
    border: 1px solid rgba(246, 241, 232, 0.12);
    color: var(--color-text, #f6f1e8);
    border-radius: 0.375rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    min-height: 34px;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--color-accent, #7ed8c4);
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--color-accent, #7ed8c4);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    text-decoration: underline;
    padding: 0.25rem 0.5rem;
  }

  .reset-btn:hover {
    color: #9bd8cf;
  }

  .results-meta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.25rem 0;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .count-announcer strong {
    color: var(--color-text, #f6f1e8);
  }

  .results-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .empty-state-box {
    text-align: center;
    padding: 4rem 1.5rem;
    border: 1px dashed rgba(246, 241, 232, 0.12);
    border-radius: 0.875rem;
    background: rgba(16, 26, 23, 0.5);
  }

  .empty-state-box.hidden {
    display: none;
  }

  .empty-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .empty-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 460px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.55;
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.5rem 1rem;
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    font-weight: 700;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .btn-primary:hover {
    background: #9bd8cf;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.12);
    color: var(--color-text, #f6f1e8);
    font-weight: 600;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    border-radius: 0.375rem;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn-secondary:hover {
    border-color: rgba(126, 216, 196, 0.3);
    color: var(--color-accent, #7ed8c4);
  }

  .knowledge-bridge-section {
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .bridge-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(126, 216, 196, 0.2);
    border-radius: 0.875rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .bridge-eyebrow {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .bridge-title {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .bridge-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 620px;
    line-height: 1.55;
    margin: 0;
  }

  .bridge-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    padding: 0.6rem 1.25rem;
    background: rgba(126, 216, 196, 0.15);
    border: 1px solid rgba(126, 216, 196, 0.35);
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    border-radius: 0.5rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 150ms ease;
  }

  .bridge-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
  }

  @media (max-width: 1024px) {
    .results-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-theme="light"]) .search-panel,
  :global([data-theme="light"]) .search-panel,
  :global(html[data-theme="light"]) .bridge-card,
  :global([data-theme="light"]) .bridge-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  :global(html[data-theme="light"]) .search-input,
  :global([data-theme="light"]) .search-input,
  :global(html[data-theme="light"]) .filter-select,
  :global([data-theme="light"]) .filter-select {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.15);
    color: #141f1c;
  }

  :global(html[data-theme="light"]) .search-input::placeholder,
  :global([data-theme="light"]) .search-input::placeholder {
    color: #5c7068;
  }

  :global(html[data-theme="light"]) .bridge-desc,
  :global([data-theme="light"]) .bridge-desc {
    color: #35453f;
  }

  :global(html[data-theme="light"]) .bridge-btn,
  :global([data-theme="light"]) .bridge-btn {
    background: rgba(13, 118, 99, 0.12);
    border-color: rgba(13, 118, 99, 0.35);
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .bridge-btn:hover,
  :global([data-theme="light"]) .bridge-btn:hover {
    background: #0d7663;
    color: #ffffff;
  }

  :global(html[data-theme="light"]) .type-pill,
  :global([data-theme="light"]) .type-pill {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.09);
    color: #35453f;
  }

  :global(html[data-theme="light"]) .type-pill.active,
  :global([data-theme="light"]) .type-pill.active {
    background: rgba(13, 118, 99, 0.12);
    border-color: rgba(13, 118, 99, 0.35);
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .empty-state-box,
  :global([data-theme="light"]) .empty-state-box {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
  }

  :global(html[data-theme="light"]) .empty-title,
  :global([data-theme="light"]) .empty-title {
    color: #141f1c;
  }

  :global(html[data-theme="light"]) .empty-desc,
  :global([data-theme="light"]) .empty-desc {
    color: #4e6059;
  }
</style>

<!-- Client-side Search and Discovery Engine Script -->
<script define:vars={{ discoveryDataJson }}>
  const data = JSON.parse(discoveryDataJson);
  const allItems = data.items;

  // Search state
  let currentQuery = '';
  let currentType = 'all';
  let currentTech = '';
  let currentTopic = '';

  function setupDiscoveryEngine() {
    const searchInput = document.getElementById('discovery-search-input');
    const typeButtons = document.querySelectorAll('#type-filter-group button');
    const techSelect = document.getElementById('tech-filter-select');
    const topicSelect = document.getElementById('topic-filter-select');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyClearBtn = document.getElementById('empty-clear-btn');
    const countNumber = document.getElementById('results-count-number');
    const emptyBox = document.getElementById('empty-state-box');
    const cards = document.querySelectorAll('.discovery-result-card');

    if (!searchInput) return;

    // Alias dictionary for search expansion
    const TECH_ALIASES = {
      postgres: 'postgresql',
      pgsql: 'postgresql',
      py: 'python',
      ts: 'typescript',
      js: 'javascript',
      reactjs: 'react',
      'react.js': 'react',
      tf: 'pytorch',
      torch: 'pytorch',
      scikit: 'scikit-learn',
      sklearn: 'scikit-learn',
      ml: 'scikit-learn',
      tailwind: 'tailwindcss',
      node: 'nodejs',
    };

    function normalizeQuery(q) {
      const trimmed = q.trim().toLowerCase();
      return TECH_ALIASES[trimmed] || trimmed;
    }

    function runFilter() {
      const q = normalizeQuery(currentQuery);
      let matchCount = 0;

      cards.forEach((card) => {
        const id = card.getAttribute('data-item-id') || '';
        const type = card.getAttribute('data-item-type') || '';
        const techs = (card.getAttribute('data-item-techs') || '').toLowerCase().split(',');
        const topics = (card.getAttribute('data-item-topics') || '').toLowerCase().split(',');
        const cardText = card.textContent?.toLowerCase() || '';

        // Check Type Filter
        if (currentType !== 'all' && type !== currentType) {
          card.style.display = 'none';
          return;
        }

        // Check Tech Select Filter
        if (currentTech && !techs.includes(currentTech.toLowerCase())) {
          card.style.display = 'none';
          return;
        }

        // Check Topic Select Filter
        if (currentTopic && !topics.includes(currentTopic.toLowerCase())) {
          card.style.display = 'none';
          return;
        }

        // Check Text Search Query
        if (q) {
          const matchTitleOrDesc = cardText.includes(q);
          const matchTech = techs.some((t) => t.includes(q));
          const matchTopic = topics.some((tp) => tp.includes(q));
          if (!matchTitleOrDesc && !matchTech && !matchTopic) {
            card.style.display = 'none';
            return;
          }
        }

        // If all conditions pass:
        card.style.display = 'flex';
        matchCount++;
      });

      if (countNumber) countNumber.textContent = matchCount.toString();
      if (emptyBox) {
        if (matchCount === 0) {
          emptyBox.classList.remove('hidden');
        } else {
          emptyBox.classList.add('hidden');
        }
      }
    }

    // Event Listeners
    searchInput.addEventListener('input', (e) => {
      currentQuery = e.target.value;
      runFilter();
    });

    typeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        typeButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        currentType = btn.getAttribute('data-type-filter') || 'all';
        runFilter();
      });
    });

    if (techSelect) {
      techSelect.addEventListener('change', (e) => {
        currentTech = e.target.value;
        runFilter();
      });
    }

    if (topicSelect) {
      topicSelect.addEventListener('change', (e) => {
        currentTopic = e.target.value;
        runFilter();
      });
    }

    function resetAll() {
      currentQuery = '';
      currentType = 'all';
      currentTech = '';
      currentTopic = '';

      if (searchInput) searchInput.value = '';
      if (techSelect) techSelect.value = '';
      if (topicSelect) topicSelect.value = '';

      typeButtons.forEach((b) => {
        const isAll = b.getAttribute('data-type-filter') === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
      });

      runFilter();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyClearBtn) emptyClearBtn.addEventListener('click', resetAll);

    // Global keyboard shortcut '/' to focus search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Handle initial URL queries
    const params = new URLSearchParams(window.location.search);
    const qParam = params.get('q');
    const typeParam = params.get('type');
    const techParam = params.get('tech');

    if (qParam && searchInput) {
      searchInput.value = qParam;
      currentQuery = qParam;
    }

    if (typeParam) {
      currentType = typeParam;
      typeButtons.forEach((b) => {
        const matches = b.getAttribute('data-type-filter') === typeParam;
        b.classList.toggle('active', matches);
        b.setAttribute('aria-pressed', matches ? 'true' : 'false');
      });
    }

    if (techParam && techSelect) {
      techSelect.value = techParam;
      currentTech = techParam;
    }

    runFilter();
  }

  setupDiscoveryEngine();
  document.addEventListener('astro:page-load', setupDiscoveryEngine);
</script>
