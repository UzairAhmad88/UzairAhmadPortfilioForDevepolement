---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import DirectChannelCard from '@/components/cards/DirectChannelCard.astro';
import { siteConfig } from '@/data/site';

const seo = {
  title: 'Contact Uzair Ahmad — Engineering, Research & Collaboration',
  description: 'Direct communication channels for engineering roles, technical consulting, and quantitative AI research discussions with Uzair Ahmad.',
  canonical: `${siteConfig.url}/contact`,
};

const channels = [
  {
    title: 'Direct Email',
    description: 'Best for engineering roles, technical inquiries, and project specifications.',
    actionLabel: 'Send an Email',
    href: `mailto:${siteConfig.email}?subject=Inquiry%20for%20Uzair%20Ahmad`,
  },
  {
    title: 'LinkedIn',
    description: 'Connect professionally and message for recruitment or collaboration.',
    actionLabel: 'Connect on LinkedIn',
    href: siteConfig.socialLinks.linkedin.url,
    isExternal: true,
  },
  {
    title: 'GitHub',
    description: 'Inspect public repositories, code contributions, and project stars.',
    actionLabel: 'Explore Repositories',
    href: siteConfig.socialLinks.github.url,
    isExternal: true,
  },
  {
    title: 'WhatsApp',
    description: 'Quick messaging for active project discussions and rapid inquiries.',
    actionLabel: 'Message on WhatsApp',
    href: siteConfig.socialLinks.whatsapp.url,
    isExternal: true,
  },
];

const contactPageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Uzair Ahmad',
  description: 'Communication channels for technical roles, consulting, and quantitative AI research.',
  url: `${siteConfig.url}/contact`,
  mainEntity: {
    '@type': 'Person',
    name: 'Uzair Ahmad',
    jobTitle: 'Quantitative AI & Product Engineer',
    email: siteConfig.email,
    url: siteConfig.url,
    sameAs: [
      siteConfig.socialLinks.github.url,
      siteConfig.socialLinks.linkedin.url,
    ],
  },
});
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" set:html={contactPageSchema} />

  <div class="page-container">
    <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />

    <section class="contact-hero">
      <SectionHeader
        eyebrow="Communication Channels"
        title="Start a Technical Conversation"
        subtitle="Open to full-time engineering roles, quantitative AI research collaborations, and specialized software consulting."
      />
    </section>

    <div class="contact-main-grid">
      <!-- Left Column: Structured Inquiry Form -->
      <section class="form-section">
        <div class="form-card">
          <div class="form-header">
            <h2 class="form-title">Send a Structured Inquiry</h2>
            <p class="form-subtitle">
              Fill in your problem statement, role description, or research context below.
            </p>
          </div>

          <form
            id="contact-form"
            class="inquiry-form"
            action="/contact/success"
            method="GET"
          >
            <!-- Honeypot field for automated spam protection -->
            <div class="honeypot-field" style="display: none !important;" aria-hidden="true">
              <label for="_gotcha">Leave this field blank</label>
              <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="inquiry_type" class="field-label">
                  Inquiry Type <span class="required" aria-hidden="true">*</span>
                </label>
                <select id="inquiry_type" name="inquiry_type" class="form-select" required>
                  <option value="project">Project / Product Engineering</option>
                  <option value="employment">Full-Time / Contract Role</option>
                  <option value="research">Quantitative / AI Research</option>
                  <option value="consulting">Technical Architecture & Consulting</option>
                  <option value="general">General Professional Inquiry</option>
                </select>
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="name" class="field-label">
                  Your Name <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-input"
                  placeholder="e.g. Jane Doe"
                  required
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                />
              </div>

              <div class="form-group">
                <label for="email" class="field-label">
                  Email Address <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder="name@company.com"
                  required
                  maxlength="100"
                  autocomplete="email"
                />
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="organization" class="field-label">
                  Organization / Team <span class="optional">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="organization"
                  name="organization"
                  class="form-input"
                  placeholder="e.g. Acme Corp / Lab"
                  maxlength="100"
                  autocomplete="organization"
                />
              </div>

              <div class="form-group">
                <label for="timeline" class="field-label">
                  Target Timeline / Stage <span class="optional">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="timeline"
                  name="timeline"
                  class="form-input"
                  placeholder="e.g. Q2 2026 / Immediate"
                  maxlength="50"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="message" class="field-label">
                Scope / Message Details <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-textarea"
                rows="5"
                placeholder="Describe your project requirements, job role parameters, or research topic..."
                required
                minlength="10"
                maxlength="3000"
              ></textarea>
              <div class="field-hint" id="message-hint">
                Tip: Include specific tech constraints, target deliverables, or relevant repository links.
              </div>
            </div>

            <div class="form-footer">
              <button type="submit" class="submit-btn">
                Send Inquiry →
              </button>
              <p class="privacy-note">
                Your details are used solely to respond to your inquiry. No marketing lists or spam.
              </p>
            </div>
          </form>
        </div>
      </section>

      <!-- Right Column: Direct Channels & Context -->
      <aside class="channels-sidebar">
        <div class="channels-container">
          <h2 class="sidebar-heading">Direct Channels</h2>
          <div class="channels-list">
            {channels.map((channel) => (
              <DirectChannelCard {...channel} />
            ))}
          </div>
        </div>

        <div class="response-card">
          <div class="status-indicator-box">
            <span class="status-dot"></span>
            <span class="status-text">Status: Actively Reviewing Inquiries</span>
          </div>
          <h3 class="response-heading">Response Commitment</h3>
          <p class="response-text">
            I review technical inquiries daily and reply within <strong>24–48 business hours</strong>.
          </p>
          <div class="direct-fallback">
            Prefer direct email? Reach me at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Progressive hint adjustments based on selected inquiry type
  const inquirySelect = document.getElementById('inquiry_type') as HTMLSelectElement | null;
  const messageHint = document.getElementById('message-hint');

  if (inquirySelect && messageHint) {
    inquirySelect.addEventListener('change', () => {
      const val = inquirySelect.value;
      if (val === 'employment') {
        messageHint.textContent = 'Tip: Please include the role title, team domain, technical stack, and remote/location details.';
      } else if (val === 'research') {
        messageHint.textContent = 'Tip: Reference the specific statistical hypothesis, dataset, or paper of interest.';
      } else if (val === 'project') {
        messageHint.textContent = 'Tip: Describe the core deliverables, expected user volume, and current architecture stage.';
      } else {
        messageHint.textContent = 'Tip: Include specific tech constraints, target deliverables, or relevant repository links.';
      }
    });

    // Check URL parameters for pre-selected type
    const urlParams = new URLSearchParams(window.location.search);
    const typeParam = urlParams.get('type');
    if (typeParam && ['project', 'employment', 'research', 'consulting', 'general'].includes(typeParam)) {
      inquirySelect.value = typeParam;
      inquirySelect.dispatchEvent(new Event('change'));
    }
  }
</script>

<style>
  .page-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(3rem, 6vw, 5rem);
    padding-left: max(0.5rem, env(safe-area-inset-left));
    padding-right: max(0.5rem, env(safe-area-inset-right));
  }

  .contact-hero {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .contact-main-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .form-card {
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .form-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .form-title {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 800;
    color: var(--ink, #f6f1e8);
    margin: 0 0 0.5rem 0;
    text-wrap: balance;
  }

  .form-subtitle {
    font-size: 0.95rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink, #f6f1e8);
  }

  .required {
    color: #ef4444;
  }

  .optional {
    font-size: 0.8rem;
    color: var(--muted, #a9b8b1);
    font-weight: 400;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(7, 17, 15, 0.7);
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 0.5rem;
    color: var(--ink, #f6f1e8);
    font-family: inherit;
    font-size: 1rem; /* 16px to prevent iOS Safari auto-zoom */
    min-height: var(--touch-target-min, 44px);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--teal, #7ed8c4);
    box-shadow: 0 0 0 3px rgba(126, 216, 196, 0.25);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  .field-hint {
    font-size: 0.8rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.4;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.95rem 2rem;
    background: var(--teal, #7ed8c4);
    color: #07110f;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 150ms ease, transform 150ms ease, box-shadow 150ms ease;
  }

  .submit-btn:hover {
    background: #9bd8cf;
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(126, 216, 196, 0.35);
  }

  .submit-btn:focus-visible {
    outline: 2px solid var(--teal, #7ed8c4);
    outline-offset: 2px;
  }

  .privacy-note {
    font-size: 0.8rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.4;
    margin: 0;
    text-align: center;
  }

  .channels-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-heading {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--ink, #f6f1e8);
    margin: 0 0 1rem 0;
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .response-card {
    background: linear-gradient(135deg, rgba(16, 26, 23, 0.95), rgba(11, 20, 18, 0.85));
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: 0.85rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .status-indicator-box {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--teal, #7ed8c4);
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal, #7ed8c4);
    box-shadow: 0 0 8px rgba(126, 216, 196, 0.6);
  }

  .response-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .response-text {
    font-size: 0.9rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.5;
    margin: 0 0 1rem 0;
    text-wrap: pretty;
  }

  .direct-fallback {
    font-size: 0.85rem;
    color: var(--muted, #a9b8b1);
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    padding-top: 0.75rem;
    word-break: break-word;
  }

  .direct-fallback a {
    color: var(--teal, #7ed8c4);
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
  }

  .direct-fallback a:hover {
    color: #9bd8cf;
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .contact-main-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
