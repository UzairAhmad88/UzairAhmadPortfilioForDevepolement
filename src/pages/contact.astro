---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import DirectChannelCard from '@/components/cards/DirectChannelCard.astro';
import { siteConfig } from '@/data/site';

const seo = {
  title: 'Contact Uzair Ahmad — Start a Conversation',
  description: 'Direct communication channels for engineering opportunities, technical consulting, and quantitative AI research discussions with Uzair Ahmad.',
  canonical: `${siteConfig.url}/contact`,
};

const channels = [
  {
    title: 'Direct Email',
    description: 'Best for engineering roles, technical inquiries, and project specifications.',
    actionLabel: 'Send an Email',
    href: `mailto:${siteConfig.email}?subject=Inquiry%20for%20Uzair%20Ahmad`,
  },
  {
    title: 'LinkedIn',
    description: 'Connect professionally and message for recruitment or collaboration.',
    actionLabel: 'Connect on LinkedIn',
    href: siteConfig.socialLinks.linkedin.url,
    isExternal: true,
  },
  {
    title: 'GitHub',
    description: 'Inspect public repositories, code contributions, and project stars.',
    actionLabel: 'Explore Repositories',
    href: siteConfig.socialLinks.github.url,
    isExternal: true,
  },
  {
    title: 'WhatsApp',
    description: 'Quick messaging for active project discussions and rapid inquiries.',
    actionLabel: 'Message on WhatsApp',
    href: siteConfig.socialLinks.whatsapp.url,
    isExternal: true,
  },
];
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />

    <section class="contact-hero">
      <SectionHeader
        eyebrow="Communication Channels"
        title="Let's Start a Conversation"
        subtitle="Open to full-time engineering roles, quantitative AI research discussions, and select technical consulting."
      />
    </section>

    <section class="channels-section">
      <div class="channels-grid">
        {channels.map((channel) => (
          <DirectChannelCard {...channel} />
        ))}
      </div>
    </section>

    <div class="contact-context-grid">
      <section class="context-card">
        <h3 class="context-title">What to Include in Your Message</h3>
        <ul class="context-list">
          <li>
            <strong>For Hiring Managers / Recruiters:</strong> Please include the role scope, team domain, technical stack, and location/remote details.
          </li>
          <li>
            <strong>For Founders / Clients:</strong> Please describe the problem statement, expected deliverables, timeline, and any existing technical constraints.
          </li>
          <li>
            <strong>For Researchers / Engineers:</strong> Reference the specific model, pipeline, or topic you would like to explore.
          </li>
        </ul>
      </section>

      <section class="context-card highlight">
        <h3 class="context-title">Response Commitment</h3>
        <p class="sla-text">
          I review messages daily and typically respond within <strong>24–48 business hours</strong>.
        </p>
        <div class="status-box">
          <span class="status-dot"></span>
          <span>Status: Actively reviewing high-impact opportunities</span>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1rem 0 5rem;
  }

  .contact-hero {
    margin-bottom: 3rem;
  }

  .channels-section {
    margin-bottom: 4rem;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .contact-context-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
  }

  .context-card {
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 0.85rem;
    padding: 2.25rem;
  }

  .context-card.highlight {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.75));
    border-color: rgba(59, 130, 246, 0.3);
  }

  .context-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 1.25rem 0;
  }

  .context-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .context-list li {
    font-size: 0.95rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.6;
  }

  .context-list strong {
    color: var(--color-accent, #60a5fa);
  }

  .sla-text {
    font-size: 1rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .sla-text strong {
    color: var(--text-primary, #f8fafc);
  }

  .status-box {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.5rem 0.85rem;
    border-radius: 0.375rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success, #10b981);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  @media (max-width: 768px) {
    .channels-grid, .contact-context-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
