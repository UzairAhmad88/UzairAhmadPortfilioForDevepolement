---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import FeaturedProjectCard from '@/components/cards/FeaturedProjectCard.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { featuredProject, projectFilters, getActiveProjects } from '@/data/projects';
import { siteConfig } from '@/data/site';



const seo = {
  title: 'Work & Systems — Uzair Ahmad | Engineering Portfolio',
  description: 'A catalog of production web applications, quantitative trading engines, and machine learning systems engineered by Uzair Ahmad.',
  canonical: `${siteConfig.url}/work`,
};

const activeProjects = getActiveProjects();
const otherProjects = activeProjects.filter((p) => p.slug !== featuredProject.slug);
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <Breadcrumbs items={[{ label: 'Work', href: '/work' }]} />

    <section class="work-hero-section">
      <SectionHeader
        eyebrow="Portfolio & Systems"
        title="Engineering Systems, Products & Research"
        subtitle="A catalog of production web platforms, quantitative models, and software architectures. Every featured project contains public, inspectable code."
      />

      <div class="filters-container" aria-label="Filter projects by discipline">
        {
          projectFilters.map((f, index) => (
            <button
              type="button"
              class:list={['filter-pill', { active: index === 0 }]}
              data-filter={f.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </section>

    <section class="featured-section" aria-label="Flagship Case Study">
      <FeaturedProjectCard project={featuredProject} />
    </section>

    <section class="projects-catalog-section" aria-label="All Projects Catalog">
      <h3 class="catalog-heading">Current Active Systems</h3>
      <div class="project-grid" id="project-grid">
        {otherProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div id="no-projects-message" class="empty-state" style="display: none;">
        <p>No projects found in this category.</p>
        <button type="button" id="reset-filters-btn" class="reset-btn">Reset Filters</button>
      </div>

      <div class="archive-access-card">
        <div class="archive-access-info">
          <span class="archive-access-eyebrow">HISTORICAL ENGINEERING RECORD</span>
          <h4 class="archive-access-title">Looking for earlier architectures & legacy systems?</h4>
          <p class="archive-access-desc">Explore the Project Archive for superseded prototypes, completed historical web platforms, and system evolution retrospectives.</p>
        </div>
        <a href="/archive" class="archive-access-btn">
          Browse Project Archive →
        </a>
      </div>
    </section>

    <ContactCallout
      title="Have an ambitious technical build?"
      subtitle="Open to discussing high-impact engineering roles, full-stack product development, and quantitative system architecture."
    />
  </div>
</BaseLayout>


<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 4rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .work-hero-section {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .filters-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid rgba(246, 241, 232, 0.12);
    background: rgba(16, 26, 23, 0.75);
    color: var(--color-text-muted, #a9b8b1);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .filter-pill:hover,
  .filter-pill:focus-visible {
    color: var(--color-text, #f6f1e8);
    border-color: var(--color-accent, #7ed8c4);
    outline: none;
  }

  .filter-pill.active {
    background: rgba(126, 216, 196, 0.15);
    border-color: var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
  }

  .catalog-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 2.5rem 0 1.25rem 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--bg-surface, #101a17);
    border: 1px dashed rgba(246, 241, 232, 0.15);
    border-radius: 0.75rem;
    color: var(--color-text-muted, #a9b8b1);
  }

  .reset-btn {
    margin-top: 1rem;
    min-height: var(--touch-target-min, 44px);
    padding: 0.5rem 1.25rem;
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    border: none;
    border-radius: 0.375rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .reset-btn:hover {
    background: #9bd8cf;
  }

  .archive-access-card {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: rgba(16, 26, 23, 0.7);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.75rem;
  }

  .archive-access-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 650px;
  }

  .archive-access-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent, #7ed8c4);
  }

  .archive-access-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0;
  }

  .archive-access-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
  }

  .archive-access-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.25rem;
    background: rgba(126, 216, 196, 0.12);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.3);
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease, color 150ms ease;
  }

  .archive-access-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
  }

  @media (max-width: 820px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .archive-access-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .archive-access-btn {
      width: 100%;
    }
  }

</style>

<script>
  function setupFilters() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const emptyState = document.getElementById('no-projects-message');
    const resetBtn = document.getElementById('reset-filters-btn');

    function applyFilter(filterId: string) {
      let visibleCount = 0;
      pills.forEach((p) => {
        const isActive = p.dataset.filter === filterId;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      cards.forEach((card) => {
        const categories = (card.dataset.category || '').split(' ');
        const matches = filterId === 'all' || categories.includes(filterId);
        card.style.display = matches ? 'flex' : 'none';
        if (matches) visibleCount++;
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        applyFilter(pill.dataset.filter || 'all');
      });
    });

    resetBtn?.addEventListener('click', () => {
      applyFilter('all');
    });
  }

  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>
