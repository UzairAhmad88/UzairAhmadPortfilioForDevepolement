---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import SimpleContactCallout from '@/components/sections/SimpleContactCallout.astro';
import { projects, projectFilters } from '@/data/projects';
import { siteConfig } from '@/data/site';

const seo = {
  title: 'Work & Systems — Uzair Ahmad',
  description: 'A curated portfolio of software platforms, quantitative models, and machine learning systems engineered by Uzair Ahmad.',
  canonical: `${siteConfig.url}/work`,
};
---

<BaseLayout seo={seo}>
  <div class="work-page-container">
    <Breadcrumbs items={[{ label: 'Work', href: '/work' }]} />

    <header class="work-hero-header">
      <span class="page-eyebrow">PORTFOLIO</span>
      <h1 class="page-title">Selected Work & Systems</h1>
      <p class="page-subtitle">
        A catalog of production software, quantitative research tools, and client web platforms. Every featured project contains public, inspectable code.
      </p>

      <div class="filters-row" aria-label="Filter projects">
        {projectFilters.map((f, index) => (
          <button
            type="button"
            class:list={['filter-btn', { active: index === 0 }]}
            data-filter={f.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>
    </header>

    <div class="projects-grid" id="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <div id="no-projects-msg" class="empty-state" style="display: none;">
      <p>No projects match the selected filter.</p>
      <button type="button" id="reset-filter-btn" class="btn secondary">Reset Filters</button>
    </div>

    <SimpleContactCallout />
  </div>
</BaseLayout>

<style>
  .work-page-container {
    width: min(var(--container-max, 1100px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .work-hero-header {
    margin: 1.5rem 0 2.5rem 0;
  }

  .page-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    display: block;
    margin-bottom: 0.5rem;
  }

  :global(html[data-theme="light"]) .page-eyebrow,
  :global([data-theme="light"]) .page-eyebrow {
    color: #0d7663;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.85rem 0;
  }

  :global(html[data-theme="light"]) .page-title,
  :global([data-theme="light"]) .page-title {
    color: #141f1c;
  }

  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    max-width: 680px;
    margin: 0 0 1.75rem 0;
  }

  :global(html[data-theme="light"]) .page-subtitle,
  :global([data-theme="light"]) .page-subtitle {
    color: #4a5c55;
  }

  .filters-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 40px);
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    background: var(--color-surface, #0c1815);
    color: var(--color-text-secondary, #a9b8b1);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 150ms ease;
  }

  :global(html[data-theme="light"]) .filter-btn,
  :global([data-theme="light"]) .filter-btn {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    color: #4a5c55;
  }

  .filter-btn:hover,
  .filter-btn:focus-visible {
    color: var(--color-text-primary, #f6f1e8);
    border-color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .filter-btn:hover,
  :global([data-theme="light"]) .filter-btn:hover {
    color: #141f1c;
    border-color: #0d7663;
  }

  .filter-btn.active {
    background: rgba(126, 216, 196, 0.12);
    border-color: var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  :global(html[data-theme="light"]) .filter-btn.active,
  :global([data-theme="light"]) .filter-btn.active {
    background: rgba(13, 118, 99, 0.1);
    border-color: #0d7663;
    color: #0d7663;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: 3rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--color-surface, #0c1815);
    border: 1px dashed var(--color-border-subtle, rgba(246, 241, 232, 0.15));
    border-radius: var(--radius-lg, 10px);
    color: var(--color-text-secondary, #a9b8b1);
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    margin-top: 1rem;
    transition: all 150ms ease;
  }

  .btn.secondary {
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    color: var(--color-accent, #7ed8c4);
  }

  .btn.secondary:hover {
    background: rgba(126, 216, 196, 0.15);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupWorkFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectCards = document.querySelectorAll<HTMLElement>('.simple-project-card');
    const emptyState = document.getElementById('no-projects-msg');
    const resetBtn = document.getElementById('reset-filter-btn');

    function applyFilter(filterId: string) {
      let visibleCount = 0;

      filterButtons.forEach((btn) => {
        const isActive = btn.dataset.filter === filterId;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      projectCards.forEach((card) => {
        const categories = (card.dataset.category || '').split(' ');
        const matches = filterId === 'all' || categories.includes(filterId);
        card.style.display = matches ? 'flex' : 'none';
        if (matches) visibleCount++;
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.dataset.filter || 'all');
      });
    });

    resetBtn?.addEventListener('click', () => {
      applyFilter('all');
    });
  }

  setupWorkFilters();
  document.addEventListener('astro:after-swap', setupWorkFilters);
</script>
