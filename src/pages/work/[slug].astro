---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import SimpleContactCallout from '@/components/sections/SimpleContactCallout.astro';
import { projects } from '@/data/projects';
import { siteConfig } from '@/data/site';
import type { Project } from '@/types/project';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const caseStudy = project.caseStudy;

const seo = {
  title: `${project.title} — Uzair Ahmad`,
  description: project.shortDescription || project.problem,
  canonical: `${siteConfig.url}/work/${project.slug}`,
};

const relatedProjects = (project.relatedProjects || [])
  .map((slug) => projects.find((p) => p.slug === slug || p.id === slug))
  .filter((p): p is Project => Boolean(p))
  .slice(0, 2);

const fallbackRelated = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
const finalRelated = relatedProjects.length > 0 ? relatedProjects : fallbackRelated;
---

<BaseLayout seo={seo}>
  <article class="project-detail-container">
    <Breadcrumbs
      items={[
        { label: 'Work', href: '/work' },
        { label: project.title, href: `/work/${project.slug}` },
      ]}
    />

    <header class="detail-hero">
      <div class="meta-strip">
        <span class="domain-tag">{project.domain || project.projectType}</span>
        {project.status === 'completed' && <span class="status-badge completed">Completed</span>}
        {project.status === 'active' && <span class="status-badge active">Active Development</span>}
        {project.status === 'academic' && <span class="status-badge academic">Academic (FYP)</span>}
      </div>

      <h1 class="project-title">{project.title}</h1>
      <p class="project-summary">{project.shortDescription || project.problem}</p>

      {project.technologies && project.technologies.length > 0 && (
        <div class="tech-row">
          <span class="tech-label">Stack:</span>
          {project.technologies.map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>
      )}

      <div class="hero-actions">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn primary">
            View on GitHub ↗
          </a>
        )}
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn secondary">
            Launch Live Demo ↗
          </a>
        )}
      </div>
    </header>

    <div class="content-body">
      {caseStudy?.overview && (
        <section class="content-section">
          <h2 class="section-title">Overview</h2>
          <p class="section-text">{caseStudy.overview}</p>
        </section>
      )}

      {project.problem && (
        <section class="content-section">
          <h2 class="section-title">The Problem</h2>
          <p class="section-text">{project.problem}</p>
        </section>
      )}

      {project.solution && (
        <section class="content-section">
          <h2 class="section-title">What I Built</h2>
          <p class="section-text">{project.solution}</p>
        </section>
      )}

      {caseStudy?.objectives && caseStudy.objectives.length > 0 && (
        <section class="content-section">
          <h2 class="section-title">Key Objectives</h2>
          <ul class="bullet-list">
            {caseStudy.objectives.map((obj) => (
              <li>{obj}</li>
            ))}
          </ul>
        </section>
      )}

      {caseStudy?.architectureDiagram && (
        <section class="content-section">
          <h2 class="section-title">Architecture & Data Flow</h2>
          <pre class="ascii-diagram"><code>{caseStudy.architectureDiagram}</code></pre>
        </section>
      )}

      {caseStudy?.outcomes && caseStudy.outcomes.length > 0 && (
        <section class="content-section">
          <h2 class="section-title">Results & Outcomes</h2>
          <ul class="bullet-list">
            {caseStudy.outcomes.map((outcome) => (
              <li>{outcome}</li>
            ))}
          </ul>
        </section>
      )}

      {caseStudy?.lessonsLearned && caseStudy.lessonsLearned.length > 0 && (
        <section class="content-section">
          <h2 class="section-title">What I Learned</h2>
          <ul class="bullet-list">
            {caseStudy.lessonsLearned.map((lesson) => (
              <li>{lesson}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="content-section links-section">
        <h2 class="section-title">Project Verification & Evidence</h2>
        <div class="evidence-links">
          {project.githubUrl && (
            <div class="evidence-item">
              <span class="ev-label">Source Code:</span>
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="ev-link">
                {project.githubRepo || project.githubUrl} ↗
              </a>
            </div>
          )}
          {project.liveUrl && (
            <div class="evidence-item">
              <span class="ev-label">Live Deployment:</span>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="ev-link">
                {project.liveUrl} ↗
              </a>
            </div>
          )}
          <div class="evidence-item">
            <span class="ev-label">Development Context:</span>
            <span class="ev-val">{project.context || 'Engineering Project'}</span>
          </div>
        </div>
      </section>
    </div>

    {finalRelated.length > 0 && (
      <section class="related-projects-section">
        <h2 class="related-title">Related Projects</h2>
        <div class="related-grid">
          {finalRelated.map((rel) => (
            <ProjectCard project={rel} />
          ))}
        </div>
      </section>
    )}

    <SimpleContactCallout />
  </article>
</BaseLayout>

<style>
  .project-detail-container {
    width: min(var(--container-max, 900px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .detail-hero {
    padding: 1.5rem 0 2.5rem 0;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    margin-bottom: 2.5rem;
  }

  .meta-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .domain-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .domain-tag,
  :global([data-theme="light"]) .domain-tag {
    color: #0d7663;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary, #a9b8b1);
  }

  .status-badge.completed {
    color: var(--color-accent, #7ed8c4);
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
  }

  :global(html[data-theme="light"]) .status-badge.completed,
  :global([data-theme="light"]) .status-badge.completed {
    color: #0d7663;
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
  }

  .project-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 1rem 0;
  }

  :global(html[data-theme="light"]) .project-title,
  :global([data-theme="light"]) .project-title {
    color: #141f1c;
  }

  .project-summary {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1.5rem 0;
  }

  :global(html[data-theme="light"]) .project-summary,
  :global([data-theme="light"]) .project-summary {
    color: #4a5c55;
  }

  .tech-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }

  .tech-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted, #73847b);
    margin-right: 0.25rem;
  }

  .tech-tag {
    font-size: 0.82rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
    color: var(--color-text-primary, #f6f1e8);
  }

  :global(html[data-theme="light"]) .tech-tag,
  :global([data-theme="light"]) .tech-tag {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    color: #141f1c;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn.primary {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    border: 1px solid var(--color-accent, #7ed8c4);
  }

  .btn.primary:hover {
    background: var(--color-accent-hover, #9bd8cf);
    transform: translateY(-1px);
  }

  .btn.secondary {
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    color: var(--color-accent, #7ed8c4);
  }

  .btn.secondary:hover {
    background: rgba(126, 216, 196, 0.15);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .btn.secondary,
  :global([data-theme="light"]) .btn.secondary {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }

  .content-body {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .section-title,
  :global([data-theme="light"]) .section-title {
    color: #141f1c;
  }

  .section-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .section-text,
  :global([data-theme="light"]) .section-text {
    color: #4a5c55;
  }

  .bullet-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bullet-list li {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .bullet-list li,
  :global([data-theme="light"]) .bullet-list li {
    color: #4a5c55;
  }

  .ascii-diagram {
    padding: 1.25rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
    border-radius: var(--radius-md, 8px);
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: var(--color-accent, #7ed8c4);
    line-height: 1.45;
  }

  :global(html[data-theme="light"]) .ascii-diagram,
  :global([data-theme="light"]) .ascii-diagram {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    color: #0d7663;
  }

  .evidence-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    border-radius: var(--radius-md, 8px);
  }

  :global(html[data-theme="light"]) .evidence-links,
  :global([data-theme="light"]) .evidence-links {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
  }

  .evidence-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .ev-label {
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    min-width: 160px;
  }

  :global(html[data-theme="light"]) .ev-label,
  :global([data-theme="light"]) .ev-label {
    color: #141f1c;
  }

  .ev-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    word-break: break-all;
  }

  :global(html[data-theme="light"]) .ev-link,
  :global([data-theme="light"]) .ev-link {
    color: #0d7663;
  }

  .ev-link:hover {
    text-decoration: underline;
  }

  .ev-val {
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .ev-val,
  :global([data-theme="light"]) .ev-val {
    color: #4a5c55;
  }

  .related-projects-section {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .related-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 1.5rem 0;
  }

  :global(html[data-theme="light"]) .related-title,
  :global([data-theme="light"]) .related-title {
    color: #141f1c;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .evidence-item {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
