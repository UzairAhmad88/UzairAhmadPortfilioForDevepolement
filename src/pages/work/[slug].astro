---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectDNA from '@/components/common/ProjectDNA.astro';
import ProjectVisualization from '@/components/visualizations/ProjectVisualization.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import RelatedKnowledgeGrid from '@/components/knowledge/RelatedKnowledgeGrid.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import GitHubEvidenceBadge from '@/components/github/GitHubEvidenceBadge.astro';
import { getProjectGitHubEvidence } from '@/lib/github/evidence';
import { projects } from '@/data/projects';
import { siteConfig } from '@/data/site';
import type { Project } from '@/types/project';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const caseStudy = project.caseStudy;

const seo = {
  title: `${project.title} — Uzair Ahmad | Technical Case Study`,
  description: project.problem || `${project.title} architecture, decisions, and outcomes by Uzair Ahmad.`,
  canonical: `${siteConfig.url}/work/${project.slug}`,
};

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': project.type === 'Research' || project.type === 'Academic' ? 'SoftwareSourceCode' : 'SoftwareApplication',
  name: project.title,
  description: project.problem || project.shortDescription,
  applicationCategory: project.domain || 'DeveloperApplication',
  programmingLanguage: project.technologies || ['TypeScript', 'Python'],
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  ...(project.githubUrl ? { codeRepository: project.githubUrl } : {}),
};

const relatedProjects = (project.relatedProjects || [])
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is Project => Boolean(p));

const fallbackRelated = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
const finalRelatedProjects = relatedProjects.length > 0 ? relatedProjects : fallbackRelated;

const gitHubEvidence = getProjectGitHubEvidence(project);
const isPrivateRepo = project.repositoryStatus === 'private';
---

<BaseLayout seo={seo}>
  <div class="case-study-page">
    <Breadcrumbs
      items={[
        { label: 'Work', href: '/work' },
        { label: project.title, href: `/work/${project.slug}` },
      ]}
    />

    <article class="case-study-container">
      <header class="case-study-header">
        <h1 class="project-headline">{project.title}</h1>
        {project.solution && <p class="lead-summary">{project.solution}</p>}

        <ProjectDNA project={project} variant="detail" />

        <div class="header-action-links">
          {project.githubUrl && (
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="cta-primary">
              View Repository on GitHub ↗
            </a>
          )}
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="cta-secondary">
              Launch Live Demo ↗
            </a>
          )}
        </div>
      </header>

      <div class="case-study-grid">
        <main class="case-study-main">
          {caseStudy?.overview && (
            <section class="study-section">
              <h2 class="section-title">01 — Executive Overview</h2>
              <p>{caseStudy.overview}</p>
            </section>
          )}

          {caseStudy?.context && (
            <section class="study-section">
              <h2 class="section-title">02 — Context & Motivation</h2>
              <p>{caseStudy.context}</p>
            </section>
          )}

          {project.problem && (
            <section class="study-section">
              <h2 class="section-title">03 — Problem Statement</h2>
              <p>{project.problem}</p>
            </section>
          )}

          {caseStudy?.objectives && caseStudy.objectives.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">04 — Core Objectives</h2>
              <ul class="bullet-list">
                {caseStudy.objectives.map((obj) => (
                  <li>{obj}</li>
                ))}
              </ul>
            </section>
          )}

          {caseStudy?.approach && (
            <section class="study-section">
              <h2 class="section-title">05 — Engineering Approach</h2>
              <p>{caseStudy.approach}</p>
            </section>
          )}

          {(caseStudy?.visualizations && caseStudy.visualizations.length > 0) ? (
            <section class="study-section">
              <h2 class="section-title">06 — System Architecture & Topology</h2>
              {caseStudy.visualizations.map((vis) => (
                <ProjectVisualization visualization={vis} />
              ))}
              {caseStudy.architectureNotes && <p class="caption-text">{caseStudy.architectureNotes}</p>}
            </section>
          ) : caseStudy?.architectureDiagram ? (
            <section class="study-section">
              <h2 class="section-title">06 — System Architecture</h2>
              <pre class="diagram-block" aria-label="System Architecture Topology"><code>{caseStudy.architectureDiagram}</code></pre>
              {caseStudy.architectureNotes && <p class="caption-text">{caseStudy.architectureNotes}</p>}
            </section>
          ) : null}

          {caseStudy?.implementationHighlights && caseStudy.implementationHighlights.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">07 — Implementation Highlights</h2>
              <ul class="bullet-list">
                {caseStudy.implementationHighlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            </section>
          )}

          {caseStudy?.keyDecisions && caseStudy.keyDecisions.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">08 — Technical Decisions & Trade-offs</h2>
              <div class="decision-stack">
                {caseStudy.keyDecisions.map((dec) => (
                  <div class="decision-item">
                    <h3 class="decision-heading">Decision: {dec.decision}</h3>
                    {dec.context && (
                      <p class="decision-sub"><strong>Context:</strong> {dec.context}</p>
                    )}
                    <p class="decision-body"><strong>Rationale:</strong> {dec.rationale}</p>
                    {dec.tradeOff && (
                      <p class="decision-tradeoff"><strong>Trade-off:</strong> {dec.tradeOff}</p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          {caseStudy?.challenges && caseStudy.challenges.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">09 — Technical Challenges & Solutions</h2>
              <div class="challenge-stack">
                {caseStudy.challenges.map((item) => (
                  <div class="challenge-item">
                    <h3 class="challenge-heading">Challenge: {item.challenge}</h3>
                    <p class="challenge-body"><strong>Solution:</strong> {item.solution}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {caseStudy?.results && caseStudy.results.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">10 — Verifiable Results & Current State</h2>
              <div class="results-stack">
                {caseStudy.results.map((res) => (
                  <div class="result-item">
                    <span class:list={['result-badge', `res-${res.status.toLowerCase()}`]}>
                      {res.status}
                    </span>
                    <p class="result-desc">{res.description}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {caseStudy?.limitations && caseStudy.limitations.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">11 — Known Limitations</h2>
              <ul class="bullet-list">
                {caseStudy.limitations.map((lim) => (
                  <li>{lim}</li>
                ))}
              </ul>
            </section>
          )}

          {caseStudy?.lessonsLearned && caseStudy.lessonsLearned.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">12 — Lessons Learned & Retrospective</h2>
              <ul class="bullet-list">
                {caseStudy.lessonsLearned.map((lesson) => (
                  <li>{lesson}</li>
                ))}
              </ul>
            </section>
          )}

          {caseStudy?.futureWork && caseStudy.futureWork.length > 0 && (
            <section class="study-section">
              <h2 class="section-title">13 — Future Directions</h2>
              <ul class="bullet-list">
                {caseStudy.futureWork.map((fw) => (
                  <li>{fw}</li>
                ))}
              </ul>
            </section>
          )}
        </main>

        <aside class="case-study-sidebar">
          <div class="sticky-sidebar-card">
            <h3 class="sidebar-heading">Project Profile & Specs</h3>
            <dl class="sidebar-specs">
              <dt>Classification</dt>
              <dd>{project.projectType}</dd>
              <dt>Domain</dt>
              <dd>{project.domain || 'Software Engineering'}</dd>
              <dt>Lifecycle Status</dt>
              <dd>{project.status === 'active' ? 'Active Research' : project.status === 'academic' ? 'Academic FYP' : 'Completed'}</dd>
              {project.role && (
                <>
                  <dt>Role</dt>
                  <dd>{project.role}</dd>
                </>
              )}
              {project.context && (
                <>
                  <dt>Context</dt>
                  <dd>{project.context}</dd>
                </>
              )}
              {project.deployment && (
                <>
                  <dt>Deployment Runtime</dt>
                  <dd>{project.deployment}</dd>
                </>
              )}
              <dt>Source Code</dt>
              <dd>
                {project.githubUrl ? (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link">
                    Public GitHub Repository ↗
                  </a>
                ) : (
                  'Private Codebase'
                )}
              </dd>
            </dl>

            <div class="sidebar-evidence-wrapper" style="margin-top: 1.25rem;">
              <GitHubEvidenceBadge
                evidence={gitHubEvidence}
                entityTitle={project.title}
                isPrivateOrUnavailable={isPrivateRepo || !project.githubUrl}
              />
            </div>

            <div class="sidebar-cta-box">
              <p class="sidebar-cta-text">Have questions or want to discuss this architecture?</p>
              <a href="/contact" class="sidebar-btn">
                Start a Conversation →
              </a>
            </div>
          </div>
        </aside>
      </div>

      <section class="related-work-section">
        <h2 class="related-heading">Related Systems & Projects</h2>
        <div class="related-grid">
          {finalRelatedProjects.map((rel) => (
            <ProjectCard project={rel} />
          ))}
        </div>
      </section>

      <RelatedKnowledgeGrid
        type="project"
        slug={project.slug}
        title="Knowledge Graph & System Connections"
        subtitle="Explore connected research investigations, lab prototypes, engineering notes, and technologies."
      />

      <ContactCallout />
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  </div>
</BaseLayout>

<style>
  .case-study-page {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .case-study-header {
    padding: 1.5rem 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(246, 241, 232, 0.1);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .project-headline {
    font-size: var(--font-size-h1, clamp(2rem, 4vw, 3rem));
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .lead-summary {
    font-size: var(--font-size-lead, 1.15rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .header-action-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    text-align: center;
    transition: background 150ms ease;
  }

  .cta-primary:hover {
    background: #9bd8cf;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--color-text, #f6f1e8);
    border: 1px solid rgba(246, 241, 232, 0.15);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    text-align: center;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .cta-secondary:hover {
    border-color: var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
  }

  .case-study-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .study-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(1.2rem, 2vw + 0.1rem, 1.45rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .study-section p {
    font-size: var(--font-size-body, 1.05rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.75;
    margin: 0 0 1rem 0;
  }

  .bullet-list {
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bullet-list li {
    font-size: 1.025rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
  }

  .diagram-block {
    background: #050d0b;
    border: 1px solid rgba(126, 216, 196, 0.2);
    border-radius: 0.5rem;
    padding: 1.25rem;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: #7ed8c4;
    line-height: 1.5;
  }

  .caption-text {
    font-size: 0.85rem;
    color: var(--color-text-muted, #83968e);
    margin-top: 0.5rem;
    font-style: italic;
  }

  .decision-stack, .challenge-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .decision-item, .challenge-item {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.65rem;
    padding: clamp(1.25rem, 2.5vw, 1.5rem);
  }

  .decision-heading, .challenge-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.75rem 0;
    line-height: 1.35;
  }

  .decision-sub, .decision-body, .decision-tradeoff, .challenge-body {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
  }

  .decision-sub:last-child, .decision-body:last-child, .decision-tradeoff:last-child, .challenge-body:last-child {
    margin-bottom: 0;
  }

  .decision-tradeoff {
    color: #d2a071;
  }

  .results-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }

  .result-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .res-implemented {
    background: rgba(126, 216, 196, 0.12);
    color: #7ed8c4;
    border: 1px solid rgba(126, 216, 196, 0.25);
  }

  .res-measured {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .res-experimental {
    background: rgba(189, 166, 255, 0.15);
    color: #bda6ff;
    border: 1px solid rgba(189, 166, 255, 0.3);
  }

  .result-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
  }

  .sticky-sidebar-card {
    position: sticky;
    top: 5.5rem;
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .sidebar-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.09);
  }

  .sidebar-specs {
    margin: 0 0 1.5rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .sidebar-specs dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted, #83968e);
  }

  .sidebar-specs dd {
    font-size: 0.95rem;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .ext-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
  }

  .ext-link:hover {
    text-decoration: underline;
  }

  .sidebar-cta-box {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.09);
  }

  .sidebar-cta-text {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    margin-bottom: 1rem;
  }

  .sidebar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(126, 216, 196, 0.12);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.3);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .sidebar-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
  }

  .related-work-section {
    margin: 4rem 0 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(246, 241, 232, 0.1);
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 2rem 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .case-study-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .sticky-sidebar-card {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .header-action-links {
      flex-direction: column;
      width: 100%;
    }

    .cta-primary, .cta-secondary {
      width: 100%;
    }

    .result-item {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
