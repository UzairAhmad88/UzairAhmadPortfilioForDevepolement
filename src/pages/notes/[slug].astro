---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import ResearchInquiryCard from '@/components/cards/ResearchInquiryCard.astro';
import RelatedKnowledgeGrid from '@/components/knowledge/RelatedKnowledgeGrid.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { engineeringNotes } from '@/data/notes';
import { projects } from '@/data/projects';
import { researchItems } from '@/data/research';
import { technologies } from '@/data/technologies';
import { siteConfig } from '@/data/site';
import type { EngineeringNote } from '@/types/note';

export function getStaticPaths() {
  return engineeringNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

export interface Props {
  note: EngineeringNote;
}

const { note } = Astro.props;

const seo = {
  title: `${note.title} — Engineering Notes | ${siteConfig.name}`,
  description: note.summary,
  canonical: `${siteConfig.url}/notes/${note.slug}`,
};

const noteSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: note.title,
  description: note.summary,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  datePublished: note.publishedAt,
  dateModified: note.updatedAt || note.publishedAt,
};

const relatedProjects = (note.relatedProjects || [])
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => Boolean(p));

const relatedResearch = (note.relatedResearch || [])
  .map((slug) => researchItems.find((r) => r.slug === slug))
  .filter((r) => Boolean(r));

const linkedTechnologies = (note.technologies || [])
  .map((techId) => technologies.find((t) => t.id === techId))
  .filter((t) => Boolean(t));
---

<BaseLayout seo={seo}>
  <div class="note-detail-page">
    <Breadcrumbs
      items={[
        { label: 'Notes', href: '/notes' },
        { label: note.title, href: `/notes/${note.slug}` },
      ]}
    />

    <article class="note-container">
      <header class="note-header">
        <div class="badge-row">
          <span class="topic-pill">{note.topic}</span>
          <span class="type-pill">{note.type}</span>
          <span class="reading-pill">{note.readingTimeMinutes} min read</span>
        </div>
        <h1 class="note-headline">{note.title}</h1>
        <p class="lead-summary">{note.summary}</p>

        <div class="meta-strip">
          <div class="meta-block">
            <span class="meta-label">Topic</span>
            <span class="meta-val">{note.topic}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Classification</span>
            <span class="meta-val">{note.type}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Published</span>
            <span class="meta-val">{note.publishedAt}</span>
          </div>
          {note.updatedAt && (
            <div class="meta-block">
              <span class="meta-label">Updated</span>
              <span class="meta-val">{note.updatedAt}</span>
            </div>
          )}
        </div>
      </header>

      <div class="note-layout-grid">
        <main class="note-main">
          <!-- 01: Context & Problem Statement -->
          <section class="note-section">
            <h2 class="section-title">01 — Context & Problem Statement</h2>
            {note.context && <p>{note.context}</p>}
            {note.problem && (
              <div class="problem-callout">
                <span class="problem-label">Core Problem</span>
                <p class="problem-text">{note.problem}</p>
              </div>
            )}
          </section>

          <!-- 02: Observed Error & Investigation (if present) -->
          {(note.observedError || note.investigation) && (
            <section class="note-section">
              <h2 class="section-title">02 — Investigation & Root Cause</h2>
              {note.observedError && (
                <div class="error-block">
                  <span class="error-label">Observed Error / Stack Trace</span>
                  <pre class="error-code"><code>{note.observedError}</code></pre>
                </div>
              )}
              {note.investigation && (
                <p class="investigation-text">{note.investigation}</p>
              )}
            </section>
          )}

          <!-- 03: Solution & Code Snippets -->
          {note.solution && (
            <section class="note-section">
              <h2 class="section-title">03 — Implementation & Solution</h2>
              <p>{note.solution}</p>
            </section>
          )}

          <!-- Sectional Deep Dives -->
          {note.sections && note.sections.map((sec, idx) => (
            <section class="note-section">
              <h3 class="subsection-title">0{idx + 4} — {sec.heading}</h3>
              <p>{sec.body}</p>
              {sec.mathFormula && (
                <pre class="math-block"><code>{sec.mathFormula}</code></pre>
              )}
              {sec.codeSnippet && (
                <div class="code-container">
                  {sec.codeTitle && <span class="code-title">{sec.codeTitle}</span>}
                  <pre class="code-block"><code class={`language-${sec.codeLang || 'text'}`}>{sec.codeSnippet}</code></pre>
                </div>
              )}
            </section>
          ))}

          <!-- Trade-offs -->
          {note.tradeoffs && note.tradeoffs.length > 0 && (
            <section class="note-section">
              <h2 class="section-title">Trade-Offs & Architectural Constraints</h2>
              <ul class="bullet-list">
                {note.tradeoffs.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </section>
          )}

          <!-- Lessons Learned -->
          {note.lessons && note.lessons.length > 0 && (
            <section class="note-section">
              <h2 class="section-title">Lessons Learned & Key Takeaways</h2>
              <div class="lessons-stack">
                {note.lessons.map((lesson) => (
                  <div class="lesson-card">
                    <span class="lesson-bullet" aria-hidden="true">✓</span>
                    <p class="lesson-text">{lesson}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Sources -->
          {note.sources && note.sources.length > 0 && (
            <section class="note-section">
              <h2 class="section-title">Technical Sources & References</h2>
              <ul class="sources-list">
                {note.sources.map((src) => (
                  <li class="source-item">
                    <span>{src.title}</span>
                    {src.year && <span class="src-year">({src.year})</span>}
                    {src.url && (
                      <a href={src.url} target="_blank" rel="noopener noreferrer" class="src-link">
                        [Link ↗]
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </main>

        <aside class="note-sidebar">
          <div class="sticky-sidebar-card">
            <h3 class="sidebar-heading">Note Metadata</h3>
            <dl class="sidebar-specs">
              <dt>Topic</dt>
              <dd>{note.topic}</dd>
              <dt>Classification</dt>
              <dd>{note.type}</dd>
              <dt>Published</dt>
              <dd>{note.publishedAt}</dd>
              <dt>Reading Time</dt>
              <dd>{note.readingTimeMinutes} min</dd>
            </dl>

            {linkedTechnologies.length > 0 && (
              <div class="sidebar-tech-list">
                <span class="sidebar-tech-label">Referenced Technologies:</span>
                <div class="sidebar-tags">
                  {linkedTechnologies.map((t) => (
                    <a href={`/technology/${t!.id}`} class="sidebar-tag-link">
                      {t!.name}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div class="sidebar-cta-box">
              <p class="sidebar-cta-text">Questions about this engineering note?</p>
              <a href="/contact" class="sidebar-btn">
                Contact Uzair →
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- Cross-System Relationships: Related Projects & Research -->
      {relatedProjects.length > 0 && (
        <section class="related-section">
          <h2 class="related-heading">Related Systems & Implementations</h2>
          <div class="related-grid">
            {relatedProjects.map((rel) => (
              <ProjectCard project={rel!} />
            ))}
          </div>
        </section>
      )}

      {relatedResearch.length > 0 && (
        <section class="related-section">
          <h2 class="related-heading">Related Research Inquiries</h2>
          <div class="related-grid">
            {relatedResearch.map((res) => (
              <ResearchInquiryCard item={res!} />
            ))}
          </div>
        </section>
      )}

      <RelatedKnowledgeGrid
        type="note"
        slug={note.slug}
        title="Knowledge Graph & System References"
        subtitle="Connected software systems, research investigations, lab workbench experiments, and technologies."
      />

      <ContactCallout
        title="Discuss technical implementations or architecture?"
        subtitle="Open to technical deep dives, code reviews, and discussions on systems design."
      />
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(noteSchema)} />
  </div>
</BaseLayout>

<style>
  .note-detail-page {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .note-header {
    padding: 1.5rem 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(246, 241, 232, 0.09);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .topic-pill {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
  }

  .type-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(126, 216, 196, 0.15);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.3);
  }

  .reading-pill {
    font-size: 0.75rem;
    color: var(--color-text-muted, #a9b8b1);
    font-family: var(--font-mono, monospace);
  }

  .note-headline {
    font-size: var(--font-size-h1, clamp(2rem, 3.8vw, 2.75rem));
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .lead-summary {
    font-size: var(--font-size-lead, 1.15rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .meta-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
  }

  .meta-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
  }

  .note-layout-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .note-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(1.2rem, 2vw + 0.1rem, 1.45rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .subsection-title {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1rem 0;
  }

  .note-section p {
    font-size: var(--font-size-body, 1.05rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.75;
    margin: 0 0 1rem 0;
  }

  .problem-callout {
    background: rgba(126, 216, 196, 0.08);
    border-left: 3px solid var(--color-accent, #7ed8c4);
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 0 0.5rem 0.5rem 0;
    margin-top: 1rem;
  }

  .problem-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, monospace);
  }

  .problem-text {
    font-size: 1.05rem !important;
    font-weight: 600;
    color: var(--color-text, #f6f1e8) !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  .error-block {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .error-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fca5a5;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono, monospace);
  }

  .error-code {
    background: #090303;
    border-radius: 0.35rem;
    padding: 0.85rem;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: #fca5a5;
    line-height: 1.5;
  }

  .code-container {
    background: #060911;
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    margin: 1.25rem 0;
    overflow: hidden;
  }

  .code-title {
    display: block;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(246, 241, 232, 0.09);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #7ed8c4);
  }

  .code-block {
    padding: 1.25rem;
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    color: #e2e8f0;
    line-height: 1.6;
  }

  .math-block {
    background: #060911;
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.5rem;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    color: #7ed8c4;
    line-height: 1.6;
    margin: 1rem 0;
  }

  .bullet-list {
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bullet-list li {
    font-size: 1.025rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
  }

  .lessons-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .lesson-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }

  .lesson-bullet {
    color: var(--color-accent, #7ed8c4);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1;
  }

  .lesson-text {
    font-size: 0.95rem;
    color: var(--color-text, #f6f1e8);
    line-height: 1.55;
    margin: 0 !important;
  }

  .sources-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .source-item {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    padding-left: 1.5rem;
    position: relative;
  }

  .source-item::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent, #7ed8c4);
  }

  .src-year {
    color: #83968e;
    margin-left: 0.25rem;
  }

  .src-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    margin-left: 0.5rem;
  }

  .src-link:hover {
    text-decoration: underline;
  }

  .sticky-sidebar-card {
    position: sticky;
    top: 5.5rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .sidebar-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.09);
  }

  .sidebar-specs {
    margin: 0 0 1.25rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .sidebar-specs dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
  }

  .sidebar-specs dd {
    font-size: 0.95rem;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .sidebar-tech-list {
    margin-bottom: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(246, 241, 232, 0.09);
  }

  .sidebar-tech-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono, monospace);
  }

  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sidebar-tag-link {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.25rem;
    color: var(--color-text-muted, #a9b8b1);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .sidebar-tag-link:hover {
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .sidebar-cta-box {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.09);
  }

  .sidebar-cta-text {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    margin-bottom: 1rem;
  }

  .sidebar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(126, 216, 196, 0.15);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.3);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .sidebar-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #0d1512;
  }

  .related-section {
    margin: 4rem 0 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(246, 241, 232, 0.09);
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 2rem 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .note-layout-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .sticky-sidebar-card {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
