---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { siteConfig } from '@/data/site';

const seo = {
  title: 'Engineering Collaboration & Technical Opportunities — Uzair Ahmad',
  description: 'Specialized engineering collaboration across full-stack web platforms, multi-agent AI systems, and quantitative data architectures.',
  canonical: `${siteConfig.url}/collaborate`,
};
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }]} />

    <section class="redirect-card">
      <span class="redirect-badge">SYSTEMS & COLLABORATION</span>
      <h1 class="redirect-title">Engineering Collaboration</h1>
      <p class="redirect-desc">
        Our engineering capabilities and collaboration pathways have moved to the dedicated Collaboration Platform.
      </p>

      <div class="redirect-actions">
        <a href="/collaborate" class="redirect-btn">
          Proceed to Collaboration Platform →
        </a>
        <a href="/work" class="secondary-btn">
          View Projects & Systems ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .redirect-card {
    background: rgba(16, 26, 23, 0.9);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: 1rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    margin: clamp(2rem, 4vw, 3.5rem) 0;
    max-width: 800px;
  }

  .redirect-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--teal, #7ed8c4);
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.08em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .redirect-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--ink, #f6f1e8);
    margin: 0 0 1rem 0;
    line-height: 1.25;
  }

  .redirect-desc {
    font-size: 1.05rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .redirect-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .redirect-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: var(--teal, #7ed8c4);
    color: #07110f;
    border-radius: var(--radius-full, 9999px);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }

  .redirect-btn:hover {
    background: #9bd8cf;
    transform: translateY(-1px);
  }

  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.25rem;
    color: var(--muted, #a9b8b1);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid rgba(246, 241, 232, 0.15);
    border-radius: var(--radius-full, 9999px);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .secondary-btn:hover {
    color: var(--teal, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.4);
  }
</style>
