---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  methodologyManifest,
  methodologySteps,
  engineeringDecisions,
  buildPrinciples,
  projectPathFlows,
} from '@/data/methodology';
import { projects } from '@/data/projects';
import { siteConfig } from '@/data/site';

const seo = {
  title: `How I Build Systems — Engineering Methodology & Decision System | ${siteConfig.name}`,
  description: 'An evidence-grounded engineering methodology and technical decision framework spanning problem understanding, systems modeling, interface design, incremental builds, empirical validation, and controlled iteration.',
  canonical: `${siteConfig.url}/how-i-build`,
};

function getProjectBySlug(slug: string) {
  return projects.find((p) => p.slug === slug);
}
---

<BaseLayout seo={seo}>
  <main id="top" class="methodology-page">
    <!-- Hero Section -->
    <header class="methodology-hero">
      <div class="container">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span class="badge-text">Personal Engineering Methodology</span>
        </div>
        <h1 class="hero-title">{methodologyManifest.headline}</h1>
        <p class="hero-lead">
          {methodologyManifest.subheading}
        </p>
        <p class="hero-philosophy">
          {methodologyManifest.philosophy}
        </p>

        <!-- Quick Lifecycle Bar -->
        <div class="lifecycle-bar" aria-label="Methodology Overview Steps">
          {
            methodologySteps.map((step, idx) => (
              <a href={`#step-${step.id}`} class="lifecycle-node">
                <span class="node-num">{step.number}</span>
                <span class="node-title">{step.title}</span>
                {idx < methodologySteps.length - 1 && <span class="node-connector" aria-hidden="true">→</span>}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <!-- Core Methodology Steps Deep-Dive -->
    <section class="section-shell methodology-steps-section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Six-Stage Engineering Framework</p>
          <h2 class="section-title">The Recurring Engineering Approach</h2>
          <p class="section-desc">
            Derived directly from public case studies, quantitative pipelines, multi-agent state graphs, and full-stack software.
          </p>
        </div>

        <div class="steps-grid">
          {
            methodologySteps.map((step) => {
              const evidenceProjects = step.projectSlugs
                .map((slug) => getProjectBySlug(slug))
                .filter(Boolean);

              return (
                <article id={`step-${step.id}`} class="step-card">
                  <header class="step-card-header">
                    <div class="step-num-pill">{step.number}</div>
                    <div class="step-titles">
                      <h3 class="step-title">{step.title}</h3>
                      <p class="step-tagline">{step.tagline}</p>
                    </div>
                  </header>

                  <div class="step-card-body">
                    <p class="step-description">{step.description}</p>

                    <div class="step-subgrid">
                      <!-- Questions asked -->
                      <div class="step-subcol">
                        <h4 class="subcol-heading">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                          </svg>
                          Questions I Ask
                        </h4>
                        <ul class="subcol-list questions-list">
                          {step.questions.map((q) => (
                            <li>{q}</li>
                          ))}
                        </ul>
                      </div>

                      <!-- Practices & Artifacts -->
                      <div class="step-subcol">
                        <h4 class="subcol-heading">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                          </svg>
                          Practices & Artifacts
                        </h4>
                        <ul class="subcol-list practices-list">
                          {step.practices.map((p) => (
                            <li>{p}</li>
                          ))}
                        </ul>
                        <div class="artifacts-box">
                          <span class="artifacts-label">Typical Artifacts:</span>
                          <div class="artifact-tags">
                            {step.artifacts.map((a) => (
                              <span class="artifact-tag">{a}</span>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Project Evidence -->
                    {evidenceProjects.length > 0 && (
                      <div class="step-evidence">
                        <span class="evidence-label">Demonstrated in Project Case Studies:</span>
                        <div class="evidence-links">
                          {evidenceProjects.map((proj) => (
                            <a href={`/work/${proj?.slug}`} class="evidence-link">
                              <span class="evidence-dot"></span>
                              <span class="evidence-title">{proj?.title}</span>
                              <span class="evidence-arrow">↗</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Context-Dependent Nonlinear Process Flows -->
    <section class="section-shell flows-section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Nonlinear Adaptability</p>
          <h2 class="section-title">The Method Changes by Problem Domain</h2>
          <p class="section-desc">
            Real engineering is not a rigid waterfall. Quantitative research, agentic AI, full-stack SaaS, and statistical algorithms follow specialized execution paths.
          </p>
        </div>

        <div class="flows-grid">
          {
            projectPathFlows.map((flow) => {
              const proj = getProjectBySlug(flow.projectSlug);
              return (
                <div class="flow-card">
                  <div class="flow-header">
                    <span class="flow-domain">{flow.domain}</span>
                    <h3 class="flow-name">{flow.name}</h3>
                    <p class="flow-desc">{flow.description}</p>
                  </div>

                  <ol class="flow-steps-list">
                    {flow.steps.map((st, i) => (
                      <li class="flow-step-item">
                        <span class="flow-step-num">0{i + 1}</span>
                        <span class="flow-step-label">{st}</span>
                      </li>
                    ))}
                  </ol>

                  {proj && (
                    <div class="flow-footer">
                      <a href={`/work/${proj.slug}`} class="flow-project-link">
                        View Case Study: {proj.title} →
                      </a>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Engineering Decision Patterns & Trade-offs -->
    <section class="section-shell decisions-section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Trade-off Rigor</p>
          <h2 class="section-title">Documented Technical Decisions</h2>
          <p class="section-desc">
            Architecture is defined by the alternatives rejected and trade-offs embraced. Every decision here is drawn from actual project repositories.
          </p>
        </div>

        <div class="decisions-grid">
          {
            engineeringDecisions.map((dec) => {
              const evidenceProjects = dec.projectSlugs
                .map((slug) => getProjectBySlug(slug))
                .filter(Boolean);

              return (
                <article class="decision-card">
                  <header class="decision-header">
                    <span class="decision-badge">Architecture Decision</span>
                    <h3 class="decision-title">{dec.title}</h3>
                  </header>

                  <div class="decision-body">
                    <div class="decision-block">
                      <span class="block-label">Problem Context:</span>
                      <p class="block-text">{dec.context}</p>
                    </div>

                    <div class="decision-block highlight-block">
                      <span class="block-label">Decision & Rationale:</span>
                      <p class="block-text bold-text">{dec.decision}</p>
                      <p class="block-subtext">{dec.rationale}</p>
                    </div>

                    <div class="decision-subgrid">
                      <div class="decision-subcol">
                        <span class="block-label">Alternatives Evaluated:</span>
                        <ul class="compact-list">
                          {dec.alternatives.map((alt) => (
                            <li>{alt}</li>
                          ))}
                        </ul>
                      </div>

                      <div class="decision-subcol">
                        <span class="block-label">Accepted Trade-offs:</span>
                        <ul class="compact-list tradeoff-list">
                          {dec.tradeoffs.map((tf) => (
                            <li>{tf}</li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    {evidenceProjects.length > 0 && (
                      <div class="decision-footer">
                        <span class="evidence-mini-label">Evidence:</span>
                        {evidenceProjects.map((p) => (
                          <a href={`/work/${p?.slug}`} class="decision-evidence-link">
                            {p?.title} ↗
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Core Build Principles -->
    <section class="section-shell principles-section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Operating Axioms</p>
          <h2 class="section-title">Core Engineering Principles</h2>
          <p class="section-desc">
            Non-negotiable standards upheld across independent research and production codebases.
          </p>
        </div>

        <div class="principles-grid">
          {
            buildPrinciples.map((pr, idx) => {
              const evidence = pr.evidenceSlugs
                .map((slug) => getProjectBySlug(slug))
                .filter(Boolean);

              return (
                <div class="principle-card">
                  <div class="principle-idx">0{idx + 1}</div>
                  <h3 class="principle-title">{pr.title}</h3>
                  <p class="principle-statement">"{pr.statement}"</p>
                  <p class="principle-desc">{pr.description}</p>
                  {evidence.length > 0 && (
                    <div class="principle-evidence">
                      <span class="principle-evidence-label">Supported by:</span>
                      <div class="principle-evidence-tags">
                        {evidence.map((p) => (
                          <a href={`/work/${p?.slug}`} class="principle-tag">
                            {p?.title}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Closing & Navigation Section -->
    <section class="section-shell closing-section">
      <div class="container text-center">
        <h2 class="closing-title">Explore Systems Engineered with this Methodology</h2>
        <p class="closing-desc">
          Browse full case studies, inspect architectural topologies, and review public GitHub repositories.
        </p>
        <div class="closing-cta-group">
          <a href="/work" class="btn-primary">
            Explore All Case Studies →
          </a>
          <a href="/research" class="btn-secondary">
            View Quantitative Research →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .methodology-page {
    color: var(--ink, #f6f1e8);
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  /* Hero Section */
  .methodology-hero {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal, #7ed8c4);
    box-shadow: 0 0 10px rgba(126, 216, 196, 0.7);
  }

  .badge-text {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal, #7ed8c4);
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink, #f6f1e8);
    margin: 0 0 1.25rem 0;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted, #a9b8b1);
    max-width: 820px;
    margin: 0 0 1rem 0;
  }

  .hero-philosophy {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(169, 184, 177, 0.8);
    max-width: 780px;
    margin: 0 0 2.5rem 0;
  }

  /* Lifecycle Bar */
  .lifecycle-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.75rem;
    width: fit-content;
  }

  .lifecycle-node {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink, #f6f1e8);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .lifecycle-node:hover,
  .lifecycle-node:focus-visible {
    color: var(--teal, #7ed8c4);
  }

  .node-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--teal, #7ed8c4);
    font-weight: 800;
  }

  .node-title {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .node-connector {
    color: rgba(169, 184, 177, 0.4);
    font-weight: 300;
    margin-left: 0.45rem;
  }

  /* Section Shells */
  .section-shell {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .section-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    max-width: 760px;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal, #7ed8c4);
    margin: 0 0 0.5rem 0;
  }

  .section-title {
    font-size: clamp(1.65rem, 3.2vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 0.85rem 0;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.6;
    margin: 0;
  }

  /* Steps Grid */
  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .step-card {
    background: rgba(16, 26, 23, 0.65);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    transition: border-color 200ms ease;
  }

  .step-card:hover {
    border-color: rgba(126, 216, 196, 0.3);
  }

  .step-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .step-num-pill {
    font-family: var(--font-mono, monospace);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--teal, #7ed8c4);
    background: rgba(126, 216, 196, 0.12);
    border: 1px solid rgba(126, 216, 196, 0.3);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .step-titles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .step-title {
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .step-tagline {
    font-size: 0.9rem;
    color: var(--teal, #7ed8c4);
    margin: 0;
    font-weight: 600;
  }

  .step-description {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(246, 241, 232, 0.9);
    margin: 0 0 1.75rem 0;
  }

  .step-subgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-bottom: 1.75rem;
  }

  .step-subcol {
    background: rgba(7, 17, 15, 0.6);
    border: 1px solid rgba(246, 241, 232, 0.06);
    border-radius: 0.65rem;
    padding: 1.15rem 1.25rem;
  }

  .subcol-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal, #7ed8c4);
    margin: 0 0 0.85rem 0;
  }

  .subcol-list {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .subcol-list li {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted, #a9b8b1);
  }

  .questions-list li {
    font-style: italic;
    color: rgba(246, 241, 232, 0.85);
  }

  .artifacts-box {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(246, 241, 232, 0.06);
  }

  .artifacts-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(169, 184, 177, 0.7);
    margin-bottom: 0.45rem;
  }

  .artifact-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .artifact-tag {
    font-size: 0.775rem;
    font-family: var(--font-mono, monospace);
    background: rgba(246, 241, 232, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--ink, #f6f1e8);
  }

  .step-evidence {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .evidence-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted, #a9b8b1);
  }

  .evidence-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .evidence-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    color: var(--teal, #7ed8c4);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .evidence-link:hover,
  .evidence-link:focus-visible {
    background: rgba(126, 216, 196, 0.18);
    border-color: var(--teal, #7ed8c4);
  }

  .evidence-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--teal, #7ed8c4);
  }

  .evidence-arrow {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  /* Flows Section */
  .flows-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .flow-card {
    background: rgba(16, 26, 23, 0.65);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .flow-domain {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal, #7ed8c4);
    margin-bottom: 0.4rem;
  }

  .flow-name {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.45rem 0;
  }

  .flow-desc {
    font-size: 0.9rem;
    color: var(--muted, #a9b8b1);
    margin: 0 0 1.25rem 0;
    line-height: 1.5;
  }

  .flow-steps-list {
    margin: 0 0 1.5rem 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-grow: 1;
  }

  .flow-step-item {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--ink, #f6f1e8);
  }

  .flow-step-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--teal, #7ed8c4);
    flex-shrink: 0;
  }

  .flow-step-label {
    line-height: 1.4;
    color: rgba(246, 241, 232, 0.85);
  }

  .flow-footer {
    padding-top: 1rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .flow-project-link {
    color: var(--teal, #7ed8c4);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .flow-project-link:hover,
  .flow-project-link:focus-visible {
    text-decoration: underline;
  }

  /* Decisions Section */
  .decisions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .decision-card {
    background: rgba(16, 26, 23, 0.65);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .decision-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal, #7ed8c4);
    margin-bottom: 0.4rem;
  }

  .decision-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 1.15rem 0;
  }

  .decision-body {
    display: flex;
