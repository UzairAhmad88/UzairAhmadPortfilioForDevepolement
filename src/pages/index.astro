---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Ticker from '@/components/sections/Ticker.astro';
import Systems from '@/components/sections/Systems.astro';
import TechStack from '@/components/sections/TechStack.astro';
import Work from '@/components/sections/Work.astro';
import ResearchLab from '@/components/sections/ResearchLab.astro';
import ArchitectureSection from '@/components/sections/ArchitectureSection.astro';
import About from '@/components/sections/About.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Contact from '@/components/sections/Contact.astro';
import { getProfilePageSchema, getWebSiteSchema } from '@/lib/seo/jsonld';
import { siteConfig } from '@/data/site';

const seo = {
  title: siteConfig.title,
  description: siteConfig.description,
  keywords: siteConfig.keywords,
  canonical: siteConfig.url,
  schema: [getWebSiteSchema(), getProfilePageSchema()],
};
---

<BaseLayout seo={seo}>
  <main id="top">
    <Hero />
    <Ticker />
    <Systems />
    <TechStack />
    <Work />
    <ResearchLab />
    <ArchitectureSection />
    <About />
    <Timeline />
    <Contact />
  </main>
</BaseLayout>
