---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import ContactCallout from '@/components/sections/ContactCallout.astro';
import { knowledgeGraph, knowledgeGraphValidation } from '@/data/knowledgeGraph';
import { siteConfig } from '@/data/site';
import type { KnowledgeNodeType } from '@/types/knowledge';

const nodes = knowledgeGraph.nodes;
const edges = knowledgeGraph.edges;
const validation = knowledgeGraphValidation;

const entityTypes: { type: KnowledgeNodeType | 'all'; label: string; count: number; icon: string }[] = [
  { type: 'all', label: 'All Entities', count: nodes.length, icon: '🌐' },
  { type: 'project', label: 'Projects', count: validation.nodesByType.project, icon: '⚡' },
  { type: 'research', label: 'Research', count: validation.nodesByType.research, icon: '🔬' },
  { type: 'lab', label: 'Lab Experiments', count: validation.nodesByType.lab, icon: '🧪' },
  { type: 'note', label: 'Engineering Notes', count: validation.nodesByType.note, icon: '📝' },
  { type: 'technology', label: 'Technologies', count: validation.nodesByType.technology, icon: '🛠️' },
  { type: 'methodology', label: 'Methodology', count: validation.nodesByType.methodology, icon: '📐' },
];

const seo = {
  title: `Knowledge Graph & Connected Engineering System | ${siteConfig.name}`,
  description: `Interactive knowledge graph representing deterministic bidirectional relationships across Uzair Ahmad’s production software systems, research inquiries, laboratory experiments, technical notes, and technologies.`,
  canonical: `${siteConfig.url}/knowledge`,
};

// Serialize graph data for client-side interactive exploration
const graphDataJson = JSON.stringify({
  nodes: knowledgeGraph.nodes,
  edges: knowledgeGraph.edges,
});
---

<BaseLayout seo={seo}>
  <div class="page-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={[{ label: 'Knowledge Graph', href: '/knowledge' }]} />

    <!-- Knowledge Header -->
    <section class="knowledge-hero">
      <SectionHeader
        eyebrow="Connected Engineering Knowledge Layer"
        title="Knowledge Graph & System Topology"
        subtitle="A structured, deterministic relationship layer connecting everything I build, research, experiment with, and document. Projects are not isolated codebases; research is not disconnected theory; notes are not random blog posts. They form one unified body of engineering work."
      />

      <!-- Audit & Stats Summary Strip -->
      <div class="stats-summary-ribbon" aria-label="Knowledge Graph Validation Metrics">
        <div class="stat-block">
          <span class="stat-label">Canonical Nodes</span>
          <span class="stat-value">{validation.totalNodes}</span>
          <span class="stat-sub">Verified Entities</span>
        </div>
        <div class="stat-block">
          <span class="stat-label">Validated Edges</span>
          <span class="stat-value accent-text">{validation.totalEdges}</span>
          <span class="stat-sub">Semantic Relationships</span>
        </div>
        <div class="stat-block">
          <span class="stat-label">Integrity Status</span>
          <span class="stat-value success-text">100% Valid</span>
          <span class="stat-sub">0 Broken References</span>
        </div>
        <div class="stat-block">
          <span class="stat-label">Derivation</span>
          <span class="stat-value">Build-Time</span>
          <span class="stat-sub">Zero Runtime Latency</span>
        </div>
      </div>
    </section>

    <!-- Filter and Exploration Controls -->
    <section class="controls-section" aria-label="Knowledge Graph Controls">
      <div class="controls-panel">
        <!-- Search input & Discovery Link -->
        <div class="search-wrap">
          <div class="input-inner">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="graph-search-input"
              placeholder="Search graph entities..."
              class="graph-search-input"
              aria-label="Filter knowledge graph nodes"
            />
          </div>
          <a
            href="/discover"
            class="discover-btn"
            title="Full Platform Discovery Search"
          >
            Discover ↗
          </a>
        </div>

        <!-- Type filter buttons -->
        <div class="filter-pills" id="type-filters" role="group" aria-label="Filter by Entity Type">
          {entityTypes.map((item) => (
            <button
              type="button"
              data-type-filter={item.type}
              class:list={['filter-pill', item.type === 'all' ? 'active' : '']}
              aria-pressed={item.type === 'all' ? 'true' : 'false'}
            >
              <span aria-hidden="true">{item.icon}</span>
              <span>{item.label}</span>
              <span class="pill-count">({item.count})</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Main Explorer Workspace: Visual Network Canvas + Inspector Panel -->
    <div class="explorer-grid">
      <!-- Interactive Graph / Matrix Visualizer -->
      <div class="visualizer-card">
        <!-- Canvas Toolbar Header -->
        <div class="visualizer-toolbar">
          <div class="toolbar-left">
            <span class="live-dot" aria-hidden="true"></span>
            <span class="toolbar-title">Relational Matrix & Topological Network</span>
          </div>
          <div class="toolbar-right">
            <span id="visible-nodes-counter" class="visible-counter">{nodes.length} Nodes Rendered</span>
            <button id="reset-focus-btn" class="reset-focus-btn">
              Reset Focus
            </button>
          </div>
        </div>

        <!-- Interactive SVG Network Container -->
        <div class="svg-container" id="graph-container">
          <svg
            id="graph-svg"
            class="graph-svg"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Interactive visual representation of the Knowledge Graph"
          >
            <defs>
              <marker
                id="edge-arrow"
                viewBox="0 0 10 10"
                refX="18"
                refY="5"
                markerWidth="5"
                markerHeight="5"
                orient="auto-start-reverse"
              >
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="rgba(246, 241, 232, 0.2)" />
              </marker>
              <marker
                id="edge-arrow-active"
                viewBox="0 0 10 10"
                refX="18"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 9 5 L 0 9 z" fill="#7ed8c4" />
              </marker>
            </defs>
            <g id="edges-group"></g>
            <g id="nodes-group"></g>
          </svg>

          <!-- Legend Overlay -->
          <div class="graph-legend">
            <span class="legend-item"><span class="dot dot-project"></span> Project</span>
            <span class="legend-item"><span class="dot dot-research"></span> Research</span>
            <span class="legend-item"><span class="dot dot-lab"></span> Lab</span>
            <span class="legend-item"><span class="dot dot-note"></span> Note</span>
            <span class="legend-item"><span class="dot dot-tech"></span> Technology</span>
            <span class="legend-item"><span class="dot dot-method"></span> Methodology</span>
          </div>
        </div>
      </div>

      <!-- Node Inspector / Focus Detail Panel -->
      <aside class="inspector-card">
        <div id="inspector-content">
          <div class="inspector-header">
            <div class="inspector-badge-row">
              <span id="inspector-type-badge" class="inspector-type-badge">
                Select a Node
              </span>
              <span id="inspector-id" class="inspector-id-label">
                graph://topology
              </span>
            </div>
            <h2 id="inspector-title" class="inspector-title">
              Click any node to inspect relationships
            </h2>
            <p id="inspector-summary" class="inspector-summary">
              Explore how projects originate from lab prototypes, research questions inform architectural choices, notes capture debugging discoveries, and technologies tie them together.
            </p>
            <div id="inspector-action-wrap" class="inspector-action-wrap hidden">
              <a
                id="inspector-canonical-link"
                href="#"
                class="btn-primary"
              >
                <span>Open Canonical Page</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- Connected Relationships Section -->
          <div class="inspector-connections">
            <h3 class="connections-heading">
              <span>Direct Connections</span>
              <span id="inspector-connections-count" class="connections-count">(0)</span>
            </h3>
            <div id="inspector-connections-list" class="connections-list">
              <p class="empty-hint">
                Select an entity in the graph or the directory below to view its direct incoming and outgoing connections.
              </p>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Semantic Relationship Directory -->
    <section class="directory-section" aria-label="Structured Knowledge Directory">
      <div class="directory-header">
        <span class="directory-eyebrow">Accessible Directory</span>
        <h2 class="directory-title">Structured Relationship Directory</h2>
        <p class="directory-subtitle">
          Semantic, fully accessible catalog of all verified knowledge entities and their explicit connections.
        </p>
      </div>

      <div class="directory-grid" id="directory-grid">
        {nodes.map((node) => {
          const directEdges = edges.filter((e) => e.source === node.id || e.target === node.id);
          return (
            <article
              class="directory-card"
              data-node-id={node.id}
              data-node-type={node.type}
              data-node-title={node.title.toLowerCase()}
            >
              <div class="dir-card-body">
                <div class="dir-card-meta">
                  <span class="node-type-tag">
                    {node.type}
                  </span>
                  <span class="dir-connections-count">
                    {directEdges.length} connections
                  </span>
                </div>

                <h3 class="dir-card-title">
                  <a href={node.href} class="dir-card-link">{node.title}</a>
                </h3>

                {node.summary && (
                  <p class="dir-card-summary">
                    {node.summary}
                  </p>
                )}
              </div>

              <div class="dir-card-footer">
                <button
                  type="button"
                  class="select-node-btn"
                  data-node-id={node.id}
                >
                  Focus in Graph ⊕
                </button>
                <a href={node.href} class="dir-view-link">
                  View Entity →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <ContactCallout
      title="Questions on the knowledge graph architecture?"
      subtitle="Open to discussing bidirectional ontology mapping, static relational indices, and graph visualization models."
    />
  </div>
</BaseLayout>

<style>
  .page-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1rem 0 5rem;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .knowledge-hero {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .stats-summary-ribbon {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-top: 1.5rem;
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-label {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: #83968e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    color: var(--color-text, #f6f1e8);
  }

  .accent-text {
    color: var(--color-accent, #7ed8c4);
  }

  .success-text {
    color: #6ee7b7;
  }

  .stat-sub {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .controls-section {
    margin-bottom: 2rem;
  }

  .controls-panel {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .input-inner {
    position: relative;
    flex: 1;
    min-width: 240px;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    pointer-events: none;
    font-size: 0.85rem;
  }

  .graph-search-input {
    width: 100%;
    background: rgba(7, 17, 15, 0.95);
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem 0.6rem 2.25rem;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text, #f6f1e8);
    transition: border-color 150ms ease;
  }

  .graph-search-input:focus {
    outline: none;
    border-color: var(--color-accent, #7ed8c4);
  }

  .discover-btn {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 0.375rem;
    color: var(--color-accent, #7ed8c4);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .discover-btn:hover {
    background: rgba(126, 216, 196, 0.1);
    border-color: rgba(126, 216, 196, 0.35);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-text-muted, #a9b8b1);
    cursor: pointer;
    transition: all 150ms ease;
    min-height: 34px;
  }

  .filter-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-text, #f6f1e8);
  }

  .filter-pill.active {
    background: rgba(126, 216, 196, 0.15);
    border-color: rgba(126, 216, 196, 0.4);
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .pill-count {
    font-size: 0.65rem;
    opacity: 0.75;
  }

  .explorer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .visualizer-card {
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .visualizer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: rgba(7, 17, 15, 0.95);
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #7ed8c4;
    box-shadow: 0 0 8px #7ed8c4;
  }

  .toolbar-title {
    color: var(--color-text, #f6f1e8);
    font-weight: 600;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
  }

  .visible-counter {
    color: #83968e;
  }

  .reset-focus-btn {
    background: none;
    border: none;
    color: var(--color-accent, #7ed8c4);
    text-decoration: underline;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    padding: 0;
  }

  .svg-container {
    position: relative;
    width: 100%;
    height: clamp(480px, 55vw, 600px);
    background: #070a0e;
    overflow: hidden;
  }

  .graph-svg {
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .graph-svg:active {
    cursor: grabbing;
  }

  .graph-legend {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(16, 26, 23, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text, #f6f1e8);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    pointer-events: none;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .dot-project { background: #6ee7b7; }
  .dot-research { background: #7ed8c4; }
  .dot-lab { background: #9bd8cf; }
  .dot-note { background: #cbd5e1; }
  .dot-tech { background: #f6f1e8; }
  .dot-method { background: #3ca691; }

  .inspector-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    padding: 1.25rem;
    position: sticky;
    top: 5.5rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .inspector-header {
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .inspector-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .inspector-type-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(126, 216, 196, 0.15);
    border: 1px solid rgba(126, 216, 196, 0.3);
    color: var(--color-accent, #7ed8c4);
  }

  .inspector-id-label {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .inspector-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  .inspector-summary {
    font-size: 0.85rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
    margin: 0;
  }

  .inspector-action-wrap {
    margin-top: 1rem;
  }

  .inspector-action-wrap.hidden {
    display: none;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 0.375rem;
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .btn-primary:hover {
    background: #9bd8cf;
  }

  .connections-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #83968e;
    margin: 0 0 0.75rem 0;
  }

  .connections-count {
    color: var(--color-accent, #7ed8c4);
  }

  .connections-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 320px;
    overflow-y: auto;
  }

  .empty-hint {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    font-style: italic;
    margin: 0;
  }

  .directory-section {
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .directory-header {
    margin-bottom: 1.5rem;
  }

  .directory-eyebrow {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .directory-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  .directory-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 650px;
    line-height: 1.55;
    margin: 0;
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .directory-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .directory-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .directory-card.hidden {
    display: none;
  }

  .dir-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dir-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .node-type-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-accent, #7ed8c4);
  }

  .dir-connections-count {
    color: #83968e;
    font-size: 0.7rem;
  }

  .dir-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
  }

  .dir-card-link {
    color: var(--color-text, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .dir-card-link:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .dir-card-summary {
    font-size: 0.8rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dir-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .select-node-btn {
    background: none;
    border: none;
    color: var(--color-accent, #7ed8c4);
    font-weight: 600;
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
    padding: 0;
  }

  .select-node-btn:hover {
    text-decoration: underline;
  }

  .dir-view-link {
    color: var(--color-text-muted, #a9b8b1);
    text-decoration: none;
  }

  .dir-view-link:hover {
    color: var(--color-text, #f6f1e8);
  }

  @media (max-width: 1024px) {
    .explorer-grid {
      grid-template-columns: 1fr;
    }

    .inspector-card {
      position: static;
    }

    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats-summary-ribbon {
      grid-template-columns: repeat(2, 1fr);
    }

    .directory-grid {
      grid-template-columns: 1fr;
    }
  }

  [data-theme="light"] .stats-summary-ribbon,
  [data-theme="light"] .controls-panel,
  [data-theme="light"] .visualizer-card,
  [data-theme="light"] .inspector-card,
  [data-theme="light"] .directory-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
  }

  [data-theme="light"] .graph-search-input {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.15);
    color: #141f1c;
  }

  [data-theme="light"] .filter-pill {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.09);
    color: #465751;
  }

  [data-theme="light"] .filter-pill.active {
    background: rgba(13, 118, 99, 0.12);
    border-color: rgba(13, 118, 99, 0.35);
    color: #0d7663;
  }

  [data-theme="light"] .svg-container {
    background: #fbf9f5;
  }

  [data-theme="light"] .visualizer-toolbar {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.1);
  }

  [data-theme="light"] .graph-legend {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(20, 31, 28, 0.15);
    color: #141f1c;
  }
</style>

<!-- Client-side Graph Exploration Script -->
<script define:vars={{ graphDataJson }}>
  const graph = JSON.parse(graphDataJson);
  let activeFilter = 'all';
  let searchQuery = '';
  let selectedNodeId = null;

  const colorMap = {
    project: '#6ee7b7',
    research: '#7ed8c4',
    lab: '#9bd8cf',
    note: '#cbd5e1',
    technology: '#f6f1e8',
    methodology: '#3ca691',
  };

  const svg = document.getElementById('graph-svg');
  const nodesGroup = document.getElementById('nodes-group');
  const edgesGroup = document.getElementById('edges-group');
  const searchInput = document.getElementById('graph-search-input');
  const filterButtons = document.querySelectorAll('#type-filters button');
  const resetBtn = document.getElementById('reset-focus-btn');
  const visibleCounter = document.getElementById('visible-nodes-counter');
  const directoryCards = document.querySelectorAll('.directory-card');

  // Inspector Elements
  const inspectorTypeBadge = document.getElementById('inspector-type-badge');
  const inspectorId = document.getElementById('inspector-id');
  const inspectorTitle = document.getElementById('inspector-title');
  const inspectorSummary = document.getElementById('inspector-summary');
  const inspectorActionWrap = document.getElementById('inspector-action-wrap');
  const inspectorCanonicalLink = document.getElementById('inspector-canonical-link');
  const inspectorConnectionsCount = document.getElementById('inspector-connections-count');
  const inspectorConnectionsList = document.getElementById('inspector-connections-list');

  // Compute Layout Positions
  const nodePositions = new Map();
  const width = 800;
  const height = 600;
  const centerX = width / 2;
  const centerY = height / 2;

  const typeGroups = {
    project: [],
    research: [],
    lab: [],
    note: [],
    technology: [],
    methodology: [],
  };

  graph.nodes.forEach((n) => {
    if (typeGroups[n.type]) {
      typeGroups[n.type].push(n);
    }
  });

  const typeRadius = {
    methodology: 80,
    technology: 160,
    project: 230,
    research: 240,
    lab: 250,
    note: 260,
  };

  Object.entries(typeGroups).forEach(([type, nodesInType]) => {
    const r = typeRadius[type] || 200;
    const count = nodesInType.length;
    nodesInType.forEach((node, idx) => {
      const angle = (idx / (count || 1)) * Math.PI * 2 + (type.charCodeAt(0) % 5);
      const x = centerX + r * Math.cos(angle) + (Math.sin(idx * 3) * 15);
      const y = centerY + r * Math.sin(angle) + (Math.cos(idx * 3) * 15);
      nodePositions.set(node.id, { x, y });
    });
  });

  function renderGraph() {
    if (!svg || !nodesGroup || !edgesGroup) return;

    const filteredNodes = graph.nodes.filter((node) => {
      const matchesType = activeFilter === 'all' || node.type === activeFilter;
      const matchesSearch =
        !searchQuery ||
        node.title.toLowerCase().includes(searchQuery) ||
        node.slug.toLowerCase().includes(searchQuery) ||
        node.type.toLowerCase().includes(searchQuery);
      return matchesType && matchesSearch;
    });

    const visibleNodeIds = new Set(filteredNodes.map((n) => n.id));
    if (visibleCounter) {
      visibleCounter.textContent = `${filteredNodes.length} Nodes Rendered`;
    }

    const filteredEdges = graph.edges.filter(
      (e) => visibleNodeIds.has(e.source) && visibleNodeIds.has(e.target)
    );

    // Render Edges
    edgesGroup.innerHTML = '';
    filteredEdges.forEach((edge) => {
      const p1 = nodePositions.get(edge.source);
      const p2 = nodePositions.get(edge.target);
      if (!p1 || !p2) return;

      const isConnectedToSelected =
        selectedNodeId &&
        (edge.source === selectedNodeId || edge.target === selectedNodeId);

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', p1.x);
      line.setAttribute('y1', p1.y);
      line.setAttribute('x2', p2.x);
      line.setAttribute('y2', p2.y);
      line.setAttribute(
        'stroke',
        isConnectedToSelected ? '#7ed8c4' : 'rgba(126, 216, 196, 0.2)'
      );
      line.setAttribute('stroke-width', isConnectedToSelected ? '2' : '1');
      if (isConnectedToSelected) {
        line.setAttribute('marker-end', 'url(#edge-arrow-active)');
      }
      edgesGroup.appendChild(line);
    });

    // Render Nodes
    nodesGroup.innerHTML = '';
    filteredNodes.forEach((node) => {
      const pos = nodePositions.get(node.id);
      if (!pos) return;

      const isSelected = selectedNodeId === node.id;
      const isConnected =
        selectedNodeId &&
        graph.edges.some(
          (e) =>
            (e.source === selectedNodeId && e.target === node.id) ||
            (e.target === selectedNodeId && e.source === node.id)
        );

      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('transform', `translate(${pos.x}, ${pos.y})`);
      g.setAttribute('class', 'cursor-pointer group');
      g.setAttribute('data-node-id', node.id);

      if (isSelected || isConnected) {
        const ring = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        ring.setAttribute('r', isSelected ? '14' : '10');
        ring.setAttribute('fill', 'none');
        ring.setAttribute('stroke', isSelected ? '#7ed8c4' : 'rgba(126, 216, 196, 0.5)');
        ring.setAttribute('stroke-width', '1.5');
        ring.setAttribute('stroke-dasharray', isSelected ? 'none' : '2,2');
        g.appendChild(ring);
      }

      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('r', isSelected ? '7' : '5');
      circle.setAttribute('fill', colorMap[node.type] || '#7ed8c4');
      circle.setAttribute('stroke', '#070a0e');
      circle.setAttribute('stroke-width', '1.5');
      g.appendChild(circle);

      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', '9');
      text.setAttribute('y', '3');
      text.setAttribute('font-family', 'monospace');
      text.setAttribute('font-size', isSelected ? '11px' : '9px');
      text.setAttribute('font-weight', isSelected ? 'bold' : 'normal');
      text.setAttribute('fill', isSelected ? '#f6f1e8' : '#a9b8b1');
      text.textContent = node.title.length > 22 ? node.title.slice(0, 20) + '…' : node.title;
      g.appendChild(text);

      g.addEventListener('click', (e) => {
        e.stopPropagation();
        selectNode(node.id);
      });

      nodesGroup.appendChild(g);
    });

    directoryCards.forEach((card) => {
      const cardType = card.getAttribute('data-node-type');
      const cardTitle = card.getAttribute('data-node-title') || '';
      const matchesType = activeFilter === 'all' || cardType === activeFilter;
      const matchesSearch = !searchQuery || cardTitle.includes(searchQuery);
      if (matchesType && matchesSearch) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function selectNode(nodeId) {
    selectedNodeId = nodeId;
    const node = graph.nodes.find((n) => n.id === nodeId);
    if (!node) return;

    const url = new URL(window.location);
    url.searchParams.set('focus', nodeId);
    window.history.replaceState({}, '', url);

    if (inspectorTypeBadge) {
      inspectorTypeBadge.textContent = node.type.toUpperCase();
      inspectorTypeBadge.style.borderColor = colorMap[node.type] || '#7ed8c4';
      inspectorTypeBadge.style.color = colorMap[node.type] || '#7ed8c4';
    }
    if (inspectorId) inspectorId.textContent = node.id;
    if (inspectorTitle) inspectorTitle.textContent = node.title;
    if (inspectorSummary) inspectorSummary.textContent = node.summary || 'No summary available.';
    if (inspectorCanonicalLink) inspectorCanonicalLink.setAttribute('href', node.href);
    if (inspectorActionWrap) inspectorActionWrap.classList.remove('hidden');

    const connectedEdges = graph.edges.filter(
      (e) => e.source === nodeId || e.target === nodeId
    );
    const connectedNodeIds = new Set();
    connectedEdges.forEach((e) => {
      connectedNodeIds.add(e.source === nodeId ? e.target : e.source);
    });

    const connectedNodes = graph.nodes.filter((n) => connectedNodeIds.has(n.id));

    if (inspectorConnectionsCount) {
      inspectorConnectionsCount.textContent = `(${connectedNodes.length})`;
    }

    if (inspectorConnectionsList) {
      if (connectedNodes.length === 0) {
        inspectorConnectionsList.innerHTML =
          '<p class="empty-hint">No direct connections recorded.</p>';
      } else {
        inspectorConnectionsList.innerHTML = connectedNodes
          .map((cn) => {
            const edge = connectedEdges.find(
              (e) =>
                (e.source === nodeId && e.target === cn.id) ||
                (e.target === nodeId && e.source === cn.id)
            );
            return `
              <div style="padding: 0.5rem; border-radius: 0.375rem; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(246, 241, 232, 0.08); font-size: 0.75rem; font-family: monospace;">
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.65rem; color: #83968e; margin-bottom: 0.25rem;">
                  <span style="color: #7ed8c4; font-weight: 600;">${edge ? edge.label : 'Related'}</span>
                  <span style="text-transform: uppercase;">${cn.type}</span>
                </div>
                <a href="${cn.href}" style="color: #f6f1e8; text-decoration: none; font-weight: 500; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  ${cn.title} →
                </a>
              </div>
            `;
          })
          .join('');
      }
    }

    renderGraph();
  }

  function resetFocus() {
    selectedNodeId = null;
    const url = new URL(window.location);
    url.searchParams.delete('focus');
    window.history.replaceState({}, '', url);

    if (inspectorTypeBadge) inspectorTypeBadge.textContent = 'SELECT A NODE';
    if (inspectorId) inspectorId.textContent = 'graph://topology';
    if (inspectorTitle) inspectorTitle.textContent = 'Click any node to inspect relationships';
    if (inspectorSummary) {
      inspectorSummary.textContent =
        'Explore how projects originate from lab prototypes, research questions inform architectural choices, notes capture debugging discoveries, and technologies tie them together.';
    }
    if (inspectorActionWrap) inspectorActionWrap.classList.add('hidden');
    if (inspectorConnectionsCount) inspectorConnectionsCount.textContent = '(0)';
    if (inspectorConnectionsList) {
      inspectorConnectionsList.innerHTML =
        '<p class="empty-hint">Select an entity in the graph or the directory below to view its direct incoming and outgoing connections.</p>';
    }

    renderGraph();
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      activeFilter = btn.getAttribute('data-type-filter') || 'all';
      renderGraph();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      renderGraph();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', resetFocus);
  }

  document.querySelectorAll('.select-node-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nodeId = btn.getAttribute('data-node-id');
      if (nodeId) {
        selectNode(nodeId);
        window.scrollTo({ top: 300, behavior: 'smooth' });
      }
    });
  });

  const urlParams = new URLSearchParams(window.location.search);
  const initialFocus = urlParams.get('focus');
  if (initialFocus) {
    selectNode(initialFocus);
  } else {
    renderGraph();
  }
</script>
