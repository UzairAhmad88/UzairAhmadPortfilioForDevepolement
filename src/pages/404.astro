---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: 'Page Not Found',
  description: 'The requested page could not be found.',
  noindex: true,
  nofollow: true,
};
---

<BaseLayout seo={seo}>
  <main id="top" class="not-found-container section-shell">
    <div class="not-found-card reveal">
      <p class="eyebrow">404 Error</p>
      <h1>Page Not Found</h1>
      <p class="not-found-lede">
        The system path you requested does not exist or has been relocated.
      </p>
      <div class="actions">
        <a class="button primary" href="/">Return to Homepage</a>
        <a class="button ghost" href="/#work">View Projects</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-container {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 12rem);
    padding: 6rem 0;
  }

  .not-found-card {
    max-width: 600px;
    padding: 3rem 2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    text-align: center;
    box-shadow: var(--shadow);
  }

  .not-found-card h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
  }

  .not-found-lede {
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
