---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: '404: Page Not Found — Uzair Ahmad',
  description: 'The requested system path does not exist or has been relocated.',
  noindex: true,
  nofollow: true,
};
---

<BaseLayout seo={seo}>
  <div class="error-container">
    <div class="error-card">
      <span class="error-code">404</span>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">
        The system route you requested does not exist or has been moved.
      </p>

      <div class="recovery-links">
        <span class="recovery-label">Quick Navigation:</span>
        <div class="links-row">
          <a href="/" class="quick-link">Home</a>
          <a href="/work" class="quick-link">Work</a>
          <a href="/research" class="quick-link">Research</a>
          <a href="/about" class="quick-link">About</a>
          <a href="/contact" class="quick-link">Contact</a>
        </div>
      </div>

      <a href="/" class="return-btn">
        ← Return to Homepage
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 20rem);
    padding: 4rem 1rem;
  }

  .error-card {
    max-width: 580px;
    width: 100%;
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 1rem;
    padding: 3.5rem 2.5rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .error-code {
    display: block;
    font-size: 3.5rem;
    font-weight: 900;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #60a5fa);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 1rem 0;
  }

  .error-message {
    font-size: 1.05rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .recovery-links {
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 0.5rem;
  }

  .recovery-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.75rem;
  }

  .links-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .quick-link {
    color: var(--color-accent, #60a5fa);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 150ms ease;
  }

  .quick-link:hover {
    color: #93c5fd;
    text-decoration: underline;
  }

  .return-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .return-btn:hover {
    background: #2563eb;
  }
</style>
