---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: '404: Page Not Found — Uzair Ahmad',
  description: 'The requested system path does not exist or has been relocated.',
  noindex: true,
  nofollow: true,
};
---

<BaseLayout seo={seo}>
  <div class="error-container">
    <div class="error-card">
      <span class="error-code">404</span>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">
        The system route you requested does not exist or has been moved.
      </p>

      <div class="recovery-links">
        <span class="recovery-label">Quick Navigation:</span>
        <div class="links-row">
          <a href="/" class="quick-link">Home</a>
          <a href="/work" class="quick-link">Work</a>
          <a href="/research" class="quick-link">Research</a>
          <a href="/about" class="quick-link">About</a>
          <a href="/contact" class="quick-link">Contact</a>
        </div>
      </div>

      <a href="/" class="return-btn">
        ← Return to Homepage
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 20rem);
    padding: clamp(2rem, 5vw, 4rem) 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }

  .error-card {
    max-width: 580px;
    width: 100%;
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 1rem;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 2.5rem);
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .error-code {
    display: block;
    font-size: clamp(2.75rem, 6vw, 3.5rem);
    font-weight: 900;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #7ed8c4);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .error-message {
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0 0 clamp(1.5rem, 3vw, 2rem) 0;
    text-wrap: pretty;
  }

  .recovery-links {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    padding: clamp(1rem, 2.5vw, 1.25rem);
    background: rgba(246, 241, 232, 0.03);
    border: 1px solid rgba(246, 241, 232, 0.06);
    border-radius: 0.5rem;
  }

  .recovery-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #83968e);
    margin-bottom: 0.75rem;
  }

  .links-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .quick-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.25rem 0.5rem;
    transition: color 150ms ease;
  }

  .quick-link:hover {
    color: #9bd8cf;
    text-decoration: underline;
  }

  .return-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.875rem 1.75rem;
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    font-weight: 700;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .return-btn:hover {
    background: #9bd8cf;
  }

  @media (max-width: 480px) {
    .return-btn {
      width: 100%;
    }
  }

  :global(html[data-theme="light"]) .error-card,
  :global([data-theme="light"]) .error-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.06);
  }

  :global(html[data-theme="light"]) .error-code,
  :global([data-theme="light"]) .error-code {
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .error-title,
  :global([data-theme="light"]) .error-title {
    color: #141f1c;
  }

  :global(html[data-theme="light"]) .error-message,
  :global([data-theme="light"]) .error-message,
  :global(html[data-theme="light"]) .recovery-label,
  :global([data-theme="light"]) .recovery-label {
    color: #35453f;
  }

  :global(html[data-theme="light"]) .recovery-links,
  :global([data-theme="light"]) .recovery-links {
    background: #f7f4ec;
    border-color: rgba(20, 31, 28, 0.1);
  }

  :global(html[data-theme="light"]) .quick-link,
  :global([data-theme="light"]) .quick-link {
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .quick-link:hover,
  :global([data-theme="light"]) .quick-link:hover {
    color: #0a5c4d;
  }

  :global(html[data-theme="light"]) .return-btn,
  :global([data-theme="light"]) .return-btn {
    background: #0d7663;
    color: #ffffff;
  }

  :global(html[data-theme="light"]) .return-btn:hover,
  :global([data-theme="light"]) .return-btn:hover {
    background: #0a5c4d;
  }
</style>
