---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import SimpleContactCallout from '@/components/sections/SimpleContactCallout.astro';
import { researchItems } from '@/data/research';
import { siteConfig } from '@/data/site';

const seo = {
  title: `Research — ${siteConfig.name}`,
  description: 'A collection of quantitative, machine-learning, time-series, and financial engineering investigations by Uzair Ahmad.',
  canonical: `${siteConfig.url}/research`,
};
---

<BaseLayout seo={seo}>
  <div class="research-page-container">
    <Breadcrumbs items={[{ label: 'Research', href: '/research' }]} />

    <header class="research-hero-header">
      <span class="page-eyebrow">RESEARCH</span>
      <h1 class="page-title">Quantitative & Applied AI Inquiries</h1>
      <p class="page-subtitle">
        A collection of quantitative finance, machine-learning, time-series, and financial engineering investigations. Each inquiry is formulated with formal hypotheses, empirical validation, and explicit limitations.
      </p>
    </header>

    <div class="research-catalog">
      {researchItems.map((item) => (
        <article class="research-card">
          <div class="card-top">
            <span class="topic-tag">{item.domain || 'Quantitative AI'}</span>
            <span class="status-pill">{item.status || 'Active'}</span>
          </div>

          <h2 class="card-title">
            <a href={`/research/${item.slug}`} class="title-link">
              {item.title}
            </a>
          </h2>

          <p class="card-summary">{item.summary}</p>

          {item.hypothesis && (
            <div class="hypothesis-box">
              <span class="box-label">Central Hypothesis:</span>
              <p class="box-text">{item.hypothesis}</p>
            </div>
          )}

          {item.technologies && item.technologies.length > 0 && (
            <div class="tech-row">
              <span class="tech-label">Methods:</span>
              {item.technologies.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          )}

          <div class="card-bottom">
            <a href={`/research/${item.slug}`} class="read-btn">
              Read Technical Inquiry →
            </a>
          </div>
        </article>
      ))}
    </div>

    <SimpleContactCallout />
  </div>
</BaseLayout>

<style>
  .research-page-container {
    width: min(var(--container-max, 1000px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .research-hero-header {
    margin: 1.5rem 0 2.5rem 0;
  }

  .page-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    display: block;
    margin-bottom: 0.5rem;
  }

  :global(html[data-theme="light"]) .page-eyebrow,
  :global([data-theme="light"]) .page-eyebrow {
    color: #0d7663;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.85rem 0;
  }

  :global(html[data-theme="light"]) .page-title,
  :global([data-theme="light"]) .page-title {
    color: #141f1c;
  }

  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    max-width: 720px;
    margin: 0;
  }

  :global(html[data-theme="light"]) .page-subtitle,
  :global([data-theme="light"]) .page-subtitle {
    color: #4a5c55;
  }

  .research-catalog {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .research-card {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    border-radius: var(--radius-lg, 12px);
    transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
  }

  .research-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent, #7ed8c4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  :global(html[data-theme="light"]) .research-card,
  :global([data-theme="light"]) .research-card {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  :global(html[data-theme="light"]) .research-card:hover,
  :global([data-theme="light"]) .research-card:hover {
    border-color: #0d7663;
    box-shadow: 0 12px 30px rgba(20, 31, 28, 0.08);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .topic-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .topic-tag,
  :global([data-theme="light"]) .topic-tag {
    color: #0d7663;
  }

  .status-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary, #a9b8b1);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.65rem 0;
    line-height: 1.35;
  }

  .title-link {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  :global(html[data-theme="light"]) .title-link,
  :global([data-theme="light"]) .title-link {
    color: #141f1c;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .title-link:hover,
  :global([data-theme="light"]) .title-link:hover {
    color: #0d7663;
  }

  .card-summary {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1.25rem 0;
  }

  :global(html[data-theme="light"]) .card-summary,
  :global([data-theme="light"]) .card-summary {
    color: #4a5c55;
  }

  .hypothesis-box {
    padding: 1rem 1.25rem;
    background: rgba(126, 216, 196, 0.05);
    border-left: 3px solid var(--color-accent, #7ed8c4);
    border-radius: 0 6px 6px 0;
    margin-bottom: 1.25rem;
  }

  :global(html[data-theme="light"]) .hypothesis-box,
  :global([data-theme="light"]) .hypothesis-box {
    background: rgba(13, 118, 99, 0.05);
    border-left-color: #0d7663;
  }

  .box-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent, #7ed8c4);
    display: block;
    margin-bottom: 0.25rem;
  }

  :global(html[data-theme="light"]) .box-label,
  :global([data-theme="light"]) .box-label {
    color: #0d7663;
  }

  .box-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .box-text,
  :global([data-theme="light"]) .box-text {
    color: #141f1c;
  }

  .tech-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tech-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted, #73847b);
    margin-right: 0.25rem;
  }

  .tech-tag {
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 4px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .tech-tag,
  :global([data-theme="light"]) .tech-tag {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.1);
    color: #4a5c55;
  }

  .card-bottom {
    display: flex;
    justify-content: flex-start;
  }

  .read-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    transition: transform 150ms ease;
  }

  :global(html[data-theme="light"]) .read-btn,
  :global([data-theme="light"]) .read-btn {
    color: #0d7663;
  }

  .read-btn:hover,
  .read-btn:focus-visible {
    transform: translateX(3px);
  }
</style>
