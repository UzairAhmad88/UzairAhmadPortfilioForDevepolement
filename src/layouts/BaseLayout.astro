---
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BackgroundEffects from '@/components/common/BackgroundEffects.astro';
import WhatsAppFloat from '@/components/common/WhatsAppFloat.astro';
import { siteConfig } from '@/data/site';
import { getThemeInitScript } from '@/lib/theme/themeManager';
import '@/styles/global.css';
import type { SEOProps } from '@/types/seo';

export interface Props {
  seo?: SEOProps;
}

const { seo = {} } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getThemeInitScript()} />
    <SEO {...seo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <BackgroundEffects />
    <Header currentPath={currentPath} />
    <main id="main-content" class="page-main" tabindex="-1">
      <slot />
    </main>
    <WhatsAppFloat />
    <Footer />

  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    z-index: 1000;
    padding: 0.75rem 1.25rem;
    background: var(--color-accent, #7ed8c4);
    color: var(--color-background, #07110f);
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: top var(--motion-duration-fast, 120ms) var(--motion-ease-standard);
  }

  .skip-link:focus-visible,
  .skip-link:focus {
    top: 1rem;
    outline: 2px solid var(--color-text-primary, #f6f1e8);
    outline-offset: 3px;
  }

  .page-main {
    min-height: calc(100vh - 350px);
    width: 100%;
  }
</style>
