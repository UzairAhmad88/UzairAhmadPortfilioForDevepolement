---
import type { SignatureInteractionPayload, EngineeringLensId } from '@/types/signatureInteraction';
import { engineeringLenses, signatureConfig } from '@/data/signatureInteraction';
import { projects } from '@/data/projects';
import { buildSignaturePayload } from '@/lib/signature/interactionBuilder';

export interface Props {
  payload?: SignatureInteractionPayload;
  projectSlug?: string;
  initialLens?: EngineeringLensId;
  showProjectSelector?: boolean;
  variant?: 'full' | 'compact' | 'embedded';
}

const {
  payload: passedPayload,
  projectSlug,
  initialLens = 'architecture',
  showProjectSelector = false,
  variant = 'full',
} = Astro.props;

// Resolve payload
let payload = passedPayload;
if (!payload) {
  if (projectSlug) {
    const proj = projects.find((p) => p.slug === projectSlug);
    if (proj) payload = buildSignaturePayload(proj);
  }
}
if (!payload) {
  const featured = projects.find((p) => p.featured) || projects[0];
  payload = buildSignaturePayload(featured);
}

const allProjects = projects.filter((p) => p.presentationLevel === 'A' || p.featured || p.status === 'academic');
const uniqueId = `lens-nav-${payload.projectSlug.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<div class:list={['signature-interaction-root', `variant-${variant}`]} id={uniqueId} data-project-slug={payload.projectSlug} data-active-lens={initialLens}>
  <!-- Header Bar / Context Strip -->
  <div class="interaction-header-bar">
    <div class="header-left">
      <span class="interaction-pill">
        <span class="pulse-indicator"></span>
        {signatureConfig.badgeText}
      </span>
      <h3 class="interaction-system-title">
        <span class="sys-label">SYSTEM:</span> {payload.projectTitle}
      </h3>
      <span class="sys-domain-badge">{payload.domain}</span>
    </div>

    {showProjectSelector && (
      <div class="project-selector-wrapper">
        <label for={`${uniqueId}-project-select`} class="sr-only">Switch Inspected System</label>
        <select id={`${uniqueId}-project-select`} class="project-dropdown" aria-label="Select System to Inspect">
          {allProjects.map((p) => (
            <option value={p.slug} selected={p.slug === payload.projectSlug}>
              {p.title} ({p.domain || 'Engineering'})
            </option>
          ))}
        </select>
      </div>
    )}
  </div>

  <!-- Lens Navigation Tabs (WCAG 2.2 AA compliant tablist) -->
  <div class="lens-tablist-wrapper">
    <div class="lens-tablist" role="tablist" aria-label="Engineering Perspective Lenses">
      {engineeringLenses.map((lens) => {
        const isActive = lens.id === initialLens;
        return (
          <button
            type="button"
            class:list={['lens-tab-btn', { 'is-active': isActive }]}
            role="tab"
            id={`${uniqueId}-tab-${lens.id}`}
            aria-selected={isActive ? 'true' : 'false'}
            aria-controls={`${uniqueId}-panel-${lens.id}`}
            data-lens-id={lens.id}
            tabindex={isActive ? 0 : -1}
          >
            <span class="lens-tab-badge">{lens.badge}</span>
            <span class="lens-tab-name">{lens.name}</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Perspective Banner -->
  <div class="lens-perspective-banner" aria-live="polite">
    <div class="perspective-left">
      <span class="perspective-tag" id={`${uniqueId}-active-tagline`}>
        {engineeringLenses.find((l) => l.id === initialLens)?.tagline}
      </span>
      <p class="perspective-question" id={`${uniqueId}-active-question`}>
        <em>Perspective Query:</em> "{engineeringLenses.find((l) => l.id === initialLens)?.question}"
      </p>
    </div>
  </div>

  <!-- Lens Panels Container -->
  <div class="lens-panels-container">
    <!-- LENS 01: ARCHITECTURE & TOPOLOGY -->
    <div
      id={`${uniqueId}-panel-architecture`}
      class:list={['lens-panel', { 'is-active': initialLens === 'architecture' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-architecture`}
      hidden={initialLens !== 'architecture'}
    >
      <div class="panel-inner-grid">
        <div class="panel-left-col">
          <div class="schematic-header">
            <h4 class="schematic-title">System Pipeline & Execution Stages</h4>
            <span class="schematic-sub">Decoupled execution boundaries</span>
          </div>

          <div class="stage-flow-pipeline">
            {payload.lenses.architecture.stages.map((st, i) => (
              <div class="stage-flow-card">
                <div class="flow-step-num">{st.step}</div>
                <div class="flow-content">
                  <h5 class="flow-label">{st.label}</h5>
                  <p class="flow-role">{st.role}</p>
                  {st.technologies && st.technologies.length > 0 && (
                    <div class="flow-tech-tags">
                      {st.technologies.map((t) => <span class="flow-tag">{t}</span>)}
                    </div>
                  )}
                </div>
                {i < payload.lenses.architecture.stages.length - 1 && (
                  <div class="flow-arrow" aria-hidden="true">↓</div>
                )}
              </div>
            ))}
          </div>
        </div>

        <div class="panel-right-col">
          <div class="topology-nodes-box">
            <h4 class="topology-title">Execution Topologies & Storage Nodes</h4>
            <div class="nodes-grid">
              {payload.lenses.architecture.nodes.map((node) => (
                <div class:list={['node-card', `node-type-${node.type}`]}>
                  <div class="node-badge">{node.type.toUpperCase()}</div>
                  <h5 class="node-title">{node.title}</h5>
                  {node.subtitle && <p class="node-sub">{node.subtitle}</p>}
                  <ul class="node-details-list">
                    {node.details.map((d) => <li>{d}</li>)}
                  </ul>
                </div>
              ))}
            </div>

            <div class="state-model-callout">
              <span class="callout-label">State Model:</span>
              <span class="callout-val">{payload.lenses.architecture.stateModel}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- LENS 02: PROBLEM & CONSTRAINTS -->
    <div
      id={`${uniqueId}-panel-constraints`}
      class:list={['lens-panel', { 'is-active': initialLens === 'constraints' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-constraints`}
      hidden={initialLens !== 'constraints'}
    >
      <div class="panel-inner-grid">
        <div class="panel-left-col">
          <div class="constraint-block">
            <h4 class="block-title">Formal Problem Statement</h4>
            <p class="problem-statement-text">{payload.lenses.constraints.problemStatement}</p>
          </div>

          <div class="constraint-block">
            <h4 class="block-title">Mathematical & Physical Boundaries</h4>
            <ul class="constraint-list">
              {payload.lenses.constraints.mathematicalBoundaries.map((mb) => (
                <li>
                  <span class="bullet-icon">∑</span>
                  <span class="bullet-text">{mb}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="panel-right-col">
          <div class="constraint-block">
            <h4 class="block-title">Operational & Performance Latencies</h4>
            <div class="latency-pill">
              <span class="lat-label">Budget:</span>
              <span class="lat-val">{payload.lenses.constraints.latencyAndThroughput}</span>
            </div>
            <ul class="constraint-list">
              {payload.lenses.constraints.operationalConstraints.map((oc) => (
                <li>
                  <span class="bullet-icon">⚡</span>
                  <span class="bullet-text">{oc}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="constraint-block">
            <h4 class="block-title">Guarded Failure Modes</h4>
            <ul class="constraint-list failure-list">
              {payload.lenses.constraints.failureModesGuarded.map((fm) => (
                <li>
                  <span class="bullet-icon">🛡️</span>
                  <span class="bullet-text">{fm}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- LENS 03: CORE STACK & CODE -->
    <div
      id={`${uniqueId}-panel-implementation`}
      class:list={['lens-panel', { 'is-active': initialLens === 'implementation' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-implementation`}
      hidden={initialLens !== 'implementation'}
    >
      <div class="panel-inner-grid">
        <div class="panel-left-col">
          <h4 class="block-title">Verified Core Stack</h4>
          <div class="stack-grid">
            {payload.lenses.implementation.coreStack.map((tech) => (
              <a href={`/technology/${tech.id}`} class="tech-stack-card" title={`View ${tech.name} in Technology Matrix`}>
                <span class="tech-name">{tech.name}</span>
                <span class="tech-role">{tech.role}</span>
                <span class="tech-category">{tech.category}</span>
              </a>
            ))}
          </div>

          <div class="highlights-box">
            <h5 class="highlights-title">Engineering Highlights</h5>
            <ul class="highlights-list">
              {payload.lenses.implementation.keyHighlights.map((kh) => <li>{kh}</li>)}
            </ul>
          </div>
        </div>

        <div class="panel-right-col">
          {payload.lenses.implementation.codeOrContractSnippet && (
            <div class="code-snippet-box">
              <div class="code-snippet-bar">
                <span class="code-filename">{payload.lenses.implementation.codeOrContractSnippet.filename}</span>
                <span class="code-lang">{payload.lenses.implementation.codeOrContractSnippet.language.toUpperCase()}</span>
              </div>
              <pre class="code-content"><code>{payload.lenses.implementation.codeOrContractSnippet.code}</code></pre>
              <p class="code-caption">{payload.lenses.implementation.codeOrContractSnippet.caption}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- LENS 04: EMPIRICAL EVIDENCE -->
    <div
      id={`${uniqueId}-panel-evidence`}
      class:list={['lens-panel', { 'is-active': initialLens === 'evidence' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-evidence`}
      hidden={initialLens !== 'evidence'}
    >
      <div class="panel-inner-grid">
        <div class="panel-left-col">
          <h4 class="block-title">Verifiable Outcomes & Results</h4>
          <div class="results-stack">
            {payload.lenses.evidence.verifiableResults.map((res) => (
              <div class="result-box">
                <span class:list={['res-status-tag', `status-${res.status.toLowerCase()}`]}>
                  {res.status}
                </span>
                <p class="res-desc">{res.description}</p>
              </div>
            ))}
          </div>

          <div class="outcomes-block">
            <h5 class="outcomes-title">Documented Achievements</h5>
            <ul class="outcomes-list">
              {payload.lenses.evidence.outcomes.map((oc) => <li>{oc}</li>)}
            </ul>
          </div>
        </div>

        <div class="panel-right-col">
          <h4 class="block-title">Provenance & Telemetry Audit</h4>
          <div class="telemetry-table-wrapper">
            <table class="telemetry-table">
              <thead>
                <tr>
                  <th scope="col">Telemetry Dimension</th>
                  <th scope="col">Observed State</th>
                  <th scope="col">Validation</th>
                </tr>
              </thead>
              <tbody>
                {payload.lenses.evidence.auditMetrics.map((met) => (
                  <tr>
                    <td class="met-label">{met.label}</td>
                    <td class="met-value">{met.value}</td>
                    <td>
                      <span class:list={['met-status', `met-${met.status}`]}>
                        {met.status.toUpperCase()}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="evidence-links-strip">
            {payload.lenses.evidence.githubUrl && (
              <a href={payload.lenses.evidence.githubUrl} target="_blank" rel="noopener noreferrer" class="evidence-btn git-btn">
                <span>GitHub Source</span>
                <span class="btn-arrow">↗</span>
              </a>
            )}
            {payload.lenses.evidence.vercelUrl && (
              <a href={payload.lenses.evidence.vercelUrl} target="_blank" rel="noopener noreferrer" class="evidence-btn vercel-btn">
                <span>Live Deployment</span>
                <span class="btn-arrow">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- LENS 05: TRADE-OFFS & LESSONS -->
    <div
      id={`${uniqueId}-panel-tradeoffs`}
      class:list={['lens-panel', { 'is-active': initialLens === 'tradeoffs' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-tradeoffs`}
      hidden={initialLens !== 'tradeoffs'}
    >
      <div class="panel-inner-grid">
        <div class="panel-left-col">
          <h4 class="block-title">Key Architectural Decisions & Sacrifices</h4>
          <div class="decisions-stack">
            {payload.lenses.tradeoffs.decisions.map((dec) => (
              <div class="decision-card">
                <h5 class="dec-title">{dec.decision}</h5>
                {dec.context && <p class="dec-context"><strong>Context:</strong> {dec.context}</p>}
                <p class="dec-rationale"><strong>Rationale:</strong> {dec.rationale}</p>
                {dec.tradeOff && (
                  <p class="dec-tradeoff">
                    <span class="tradeoff-pill">Trade-off</span> {dec.tradeOff}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>

        <div class="panel-right-col">
          <div class="challenges-block">
            <h4 class="block-title">Overcome Engineering Challenges</h4>
            {payload.lenses.tradeoffs.challenges.map((ch) => (
              <div class="challenge-box">
                <h5 class="ch-problem">{ch.challenge}</h5>
                <p class="ch-solution"><strong>Engineered Solution:</strong> {ch.solution}</p>
              </div>
            ))}
          </div>

          <div class="lessons-block">
            <h4 class="block-title">Postmortem Lessons Learned</h4>
            <ul class="lessons-list">
              {payload.lenses.tradeoffs.lessonsLearned.map((ll) => <li>{ll}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- LENS 06: CONNECTED KNOWLEDGE -->
    <div
      id={`${uniqueId}-panel-connections`}
      class:list={['lens-panel', { 'is-active': initialLens === 'connections' }]}
      role="tabpanel"
      aria-labelledby={`${uniqueId}-tab-connections`}
      hidden={initialLens !== 'connections'}
    >
      <div class="connections-wrapper">
        <div class="connections-summary-strip">
          <span class="con-count">
            <strong>{payload.lenses.connections.totalConnectedEntities}</strong> Verified Connected Entities
          </span>
          <a href="/knowledge" class="graph-link">Explore Full Knowledge Graph →</a>
        </div>

        <div class="connections-three-col">
          <!-- Research Connections -->
          <div class="con-column">
            <h5 class="con-col-title">🔬 Connected Research ({payload.lenses.connections.connectedResearch.length})</h5>
            {payload.lenses.connections.connectedResearch.length > 0 ? (
              <div class="con-cards-list">
                {payload.lenses.connections.connectedResearch.map((res) => (
                  <a href={`/research/${res.slug}`} class="con-item-card">
                    <span class="con-rel">{res.relationship}</span>
                    <h6 class="con-title">{res.title}</h6>
                    {res.summary && <p class="con-desc">{res.summary.slice(0, 100)}...</p>}
                  </a>
                ))}
              </div>
            ) : (
              <p class="con-empty">No direct research papers linked to this specific codebase.</p>
            )}
          </div>

          <!-- Lab Experiments -->
          <div class="con-column">
            <h5 class="con-col-title">🧪 Connected Lab ({payload.lenses.connections.connectedLab.length})</h5>
            {payload.lenses.connections.connectedLab.length > 0 ? (
              <div class="con-cards-list">
                {payload.lenses.connections.connectedLab.map((lab) => (
                  <a href={`/lab/${lab.slug}`} class="con-item-card">
                    <span class="con-rel">{lab.relationship}</span>
                    <h6 class="con-title">{lab.title}</h6>
                    <span class="con-status-badge">{lab.status}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="con-empty">No precursor lab prototypes directly linked.</p>
            )}
          </div>

          <!-- Engineering Notes -->
          <div class="con-column">
            <h5 class="con-col-title">📝 Engineering Notes ({payload.lenses.connections.connectedNotes.length})</h5>
            {payload.lenses.connections.connectedNotes.length > 0 ? (
              <div class="con-cards-list">
                {payload.lenses.connections.connectedNotes.map((note) => (
                  <a href={`/notes/${note.slug}`} class="con-item-card">
                    <span class="con-rel">{note.relationship}</span>
                    <h6 class="con-title">{note.title}</h6>
                    <span class="con-topic-tag">{note.topic}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="con-empty">No debugging or architecture notes directly linked.</p>
            )}
          </div>
        </div>

        {payload.lenses.connections.historicalEvolution && (
          <div class="evolution-footprint-box">
            <h5 class="evo-title">Historical Architecture Lineage</h5>
            <div class="evo-links-grid">
              {payload.lenses.connections.historicalEvolution.predecessorSlug && (
                <div class="evo-node">
                  <span class="evo-tag">↰ Predecessor Prototype:</span>
                  <a href={`/work/${payload.lenses.connections.historicalEvolution.predecessorSlug}`} class="evo-anchor">
                    {payload.lenses.connections.historicalEvolution.predecessorTitle || payload.lenses.connections.historicalEvolution.predecessorSlug} →
                  </a>
                </div>
              )}
              {payload.lenses.connections.historicalEvolution.successorSlug && (
                <div class="evo-node">
                  <span class="evo-tag">↳ Successor System:</span>
                  <a href={`/work/${payload.lenses.connections.historicalEvolution.successorSlug}`} class="evo-anchor">
                    {payload.lenses.connections.historicalEvolution.successorTitle || payload.lenses.connections.historicalEvolution.successorSlug} →
                  </a>
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<script>
  function setupEngineeringLensNavigators() {
    const roots = document.querySelectorAll('.signature-interaction-root');

    roots.forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>('.lens-tab-btn');
      const panels = root.querySelectorAll<HTMLElement>('.lens-panel');
      const taglineElem = root.querySelector<HTMLElement>('[id$="-active-tagline"]');
      const questionElem = root.querySelector<HTMLElement>('[id$="-active-question"]');
      const projectSelect = root.querySelector<HTMLSelectElement>('.project-dropdown');

      const lensTaglines: Record<string, { tagline: string; question: string }> = {
        architecture: {
          tagline: 'Component hierarchy, dataflow pipelines & system boundaries',
          question: 'How do the components interconnect and route state under load?'
        },
        constraints: {
          tagline: 'Mathematical boundaries, non-stationarity & latency limits',
          question: 'What physical, mathematical, and latency boundaries dictate the design?'
        },
        implementation: {
          tagline: 'Tensors, data contracts, and algorithmic implementation',
          question: 'What technologies, schemas, and algorithms execute the business logic?'
        },
        evidence: {
          tagline: 'Out-of-sample metrics, benchmarks & verified telemetry',
          question: 'What verifiable empirical proofs and metrics validate this system?'
        },
        tradeoffs: {
          tagline: 'Technical decisions, postmortems & what was sacrificed',
          question: 'What alternative designs were rejected and what constraints were accepted?'
        },
        connections: {
          tagline: 'Linked research, lab experiments, notes & system evolution',
          question: 'How does this system connect to the broader body of research and lab experiments?'
        }
      };

      function switchLens(targetLensId: string, updateUrl: boolean = true) {
        tabs.forEach((tab) => {
          const isTarget = tab.getAttribute('data-lens-id') === targetLensId;
          tab.classList.toggle('is-active', isTarget);
          tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          tab.setAttribute('tabindex', isTarget ? '0' : '-1');
        });

        panels.forEach((panel) => {
          const panelLensId = panel.id.split('-panel-')[1];
          const isTarget = panelLensId === targetLensId;
          panel.classList.toggle('is-active', isTarget);
          panel.hidden = !isTarget;
        });

        root.setAttribute('data-active-lens', targetLensId);

        if (taglineElem && lensTaglines[targetLensId]) {
          taglineElem.textContent = lensTaglines[targetLensId].tagline;
        }
        if (questionElem && lensTaglines[targetLensId]) {
          questionElem.innerHTML = `<em>Perspective Query:</em> "${lensTaglines[targetLensId].question}"`;
        }

        if (updateUrl && typeof window !== 'undefined' && window.history) {
          const url = new URL(window.location.href);
          url.searchParams.set('lens', targetLensId);
          window.history.replaceState({}, '', url.toString());
        }
      }

      // Check URL search parameter on initial load
      if (typeof window !== 'undefined') {
        const urlParams = new URLSearchParams(window.location.search);
        const urlLens = urlParams.get('lens');
        if (urlLens && lensTaglines[urlLens]) {
          switchLens(urlLens, false);
        }
      }

      // Click Event
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const lensId = tab.getAttribute('data-lens-id');
          if (lensId) switchLens(lensId, true);
        });

        // Keyboard Navigation (ArrowLeft, ArrowRight, Home, End)
        tab.addEventListener('keydown', (e) => {
          const tabArray = Array.from(tabs);
          const currentIndex = tabArray.indexOf(tab);

          let newIndex = currentIndex;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            newIndex = (currentIndex + 1) % tabArray.length;
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            newIndex = (currentIndex - 1 + tabArray.length) % tabArray.length;
          } else if (e.key === 'Home') {
            e.preventDefault();
            newIndex = 0;
          } else if (e.key === 'End') {
            e.preventDefault();
            newIndex = tabArray.length - 1;
          }

          if (newIndex !== currentIndex) {
            const nextTab = tabArray[newIndex];
            nextTab.focus();
            const lensId = nextTab.getAttribute('data-lens-id');
            if (lensId) switchLens(lensId, true);
          }
        });
      });

      // Project Selector Event
      if (projectSelect) {
        projectSelect.addEventListener('change', () => {
          const targetSlug = projectSelect.value;
          if (targetSlug) {
            window.location.href = `/work/${targetSlug}?lens=${root.getAttribute('data-active-lens') || 'architecture'}`;
          }
        });
      }
    });
  }

  // Execute on initial page load and on client-side router navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupEngineeringLensNavigators);
  } else {
    setupEngineeringLensNavigators();
  }
  document.addEventListener('astro:page-load', setupEngineeringLensNavigators);
</script>

<style>
  .signature-interaction-root {
    background: #0d1117;
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 12px;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    color: #e6edf3;
    font-family: inherit;
    margin: 2rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Header Bar */
  .interaction-header-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    margin-bottom: 1.25rem;
  }

  .header-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .interaction-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(88, 166, 255, 0.1);
    border: 1px solid rgba(88, 166, 255, 0.3);
    color: #58a6ff;
