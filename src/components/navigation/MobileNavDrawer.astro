---
import { primaryNavigation } from '@/data/navigation';
import { siteConfig } from '@/data/site';
import ThemeToggle from '@/components/common/ThemeToggle.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<div
  id="mobile-nav-drawer"
  class="mobile-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <span class="drawer-brand">{siteConfig.name}</span>
      <div class="drawer-header-actions">
        <ThemeToggle />
        <button
          type="button"
          class="drawer-close"
          id="drawer-close-btn"
          aria-label="Close navigation menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <nav class="drawer-nav" aria-label="Mobile Primary Navigation">
      <ul class="nav-list">
        {
          primaryNavigation.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['drawer-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="drawer-footer">
      <a href="/contact" class="drawer-cta-button">
        Start a Conversation
      </a>
      <div class="drawer-socials">
        <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="social-link">GitHub</a>
        <a href={siteConfig.socialLinks.linkedin.url} target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn</a>
        <a href={`mailto:${siteConfig.email}`} class="social-link">Email</a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .mobile-drawer.is-open {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 10, 18, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  [data-theme="light"] .drawer-backdrop {
    background: rgba(20, 31, 28, 0.5);
  }

  .drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 88vw);
    background: var(--color-background-subtle, #0b1513);
    border-left: 1px solid var(--color-border, rgba(126, 216, 196, 0.2));
    padding: max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1), background-color var(--transition-fast);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.4);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-drawer.is-open .drawer-content {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
  }

  .drawer-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text-primary, #f6f1e8);
  }

  .drawer-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-close {
    background: transparent;
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.15));
    color: var(--color-text-secondary, #a9b8b1);
    width: 2.75rem;
    height: 2.75rem;
    min-width: var(--touch-target-min, 44px);
    min-height: var(--touch-target-min, 44px);
    border-radius: var(--radius-md, 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .drawer-close:hover,
  .drawer-close:focus-visible {
    color: var(--color-accent, #7ed8c4);
    border-color: var(--color-accent, #7ed8c4);
    outline: none;
  }

  .nav-list {
    list-style: none;
    padding: 1.5rem 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md, 8px);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-secondary, #a9b8b1);
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .drawer-link:hover,
  .drawer-link:focus-visible {
    background: var(--color-surface-hover, rgba(126, 216, 196, 0.08));
    color: var(--color-text-primary, #f6f1e8);
    outline: none;
  }

  .drawer-link.active {
    background: var(--color-accent-muted, rgba(126, 216, 196, 0.14));
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
  }

  .drawer-cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md, 8px);
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .drawer-cta-button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .drawer-socials {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 0.5rem;
  }

  .social-link {
    color: var(--color-text-muted, #a9b8b1);
    font-size: 0.85rem;
    text-decoration: none;
    padding: 0.5rem;
    min-height: var(--touch-target-min, 44px);
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: var(--color-accent, #7ed8c4);
  }
</style>

<script>
  function setupMobileDrawer() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('drawer-close-btn');
    const backdrop = document.getElementById('drawer-backdrop');

    if (!trigger || !drawer || !closeBtn || !backdrop) return;

    function openDrawer() {
      if (!drawer || !trigger) return;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      if (!drawer || !trigger) return;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger.focus();
    }

    trigger.onclick = openDrawer;
    closeBtn.onclick = closeDrawer;
    backdrop.onclick = closeDrawer;

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
        closeDrawer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileDrawer);
  } else {
    setupMobileDrawer();
  }
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
