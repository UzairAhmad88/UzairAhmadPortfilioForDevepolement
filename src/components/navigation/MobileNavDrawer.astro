---
import { primaryNavigation } from '@/data/navigation';
import { siteConfig } from '@/data/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<div
  id="mobile-nav-drawer"
  class="mobile-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <span class="drawer-brand">{siteConfig.name}</span>
      <button
        type="button"
        class="drawer-close"
        id="drawer-close-btn"
        aria-label="Close navigation menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="drawer-nav" aria-label="Mobile Primary Navigation">
      <ul class="nav-list">
        {
          primaryNavigation.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['drawer-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="drawer-footer">
      <a href="/contact" class="drawer-cta-button">
        Start a Conversation
      </a>
      <div class="drawer-socials">
        <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="social-link">GitHub</a>
        <a href={siteConfig.socialLinks.linkedin.url} target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn</a>
        <a href={`mailto:${siteConfig.email}`} class="social-link">Email</a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .mobile-drawer.is-open {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 10, 18, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 88vw);
    background: var(--color-canvas-card, #0f172a);
    border-left: 1px solid var(--border-subtle, #1e293b);
    padding: max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-drawer.is-open .drawer-content {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle, #1e293b);
  }

  .drawer-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary, #f8fafc);
  }

  .drawer-close {
    background: transparent;
    border: 1px solid var(--border-subtle, #334155);
    color: var(--text-secondary, #94a3b8);
    width: 2.75rem;
    height: 2.75rem;
    min-width: var(--touch-target-min, 44px);
    min-height: var(--touch-target-min, 44px);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .drawer-close:hover,
  .drawer-close:focus-visible {
    color: var(--text-primary, #f8fafc);
    border-color: var(--color-accent, #3b82f6);
    outline: none;
  }

  .nav-list {
    list-style: none;
    padding: 1.5rem 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-secondary, #94a3b8);
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .drawer-link:hover,
  .drawer-link:focus-visible {
    background: rgba(59, 130, 246, 0.1);
    color: var(--text-primary, #f8fafc);
    outline: none;
  }

  .drawer-link.active {
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-accent, #60a5fa);
    font-weight: 700;
  }

  .drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle, #1e293b);
  }

  .drawer-cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    text-align: center;
    padding: 0.85rem 1rem;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .drawer-cta-button:hover,
  .drawer-cta-button:focus-visible {
    background: #2563eb;
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  .drawer-socials {
    display: flex;
    justify-content: space-around;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.5rem 0.75rem;
    color: var(--text-muted, #94a3b8);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--text-primary, #f8fafc);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .drawer-content {
      transition: none !important;
    }
  }
</style>

<script>
  function setupDrawer() {
    const openBtn = document.getElementById('mobile-menu-trigger');
    const closeBtn = document.getElementById('drawer-close-btn');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('mobile-nav-drawer');

    if (!drawer || !openBtn) return;

    function openMenu() {
      drawer?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeMenu() {
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      openBtn?.focus();
    }

    openBtn.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
        closeMenu();
      }
    });
  }

  setupDrawer();
  document.addEventListener('astro:after-swap', setupDrawer);
</script>
