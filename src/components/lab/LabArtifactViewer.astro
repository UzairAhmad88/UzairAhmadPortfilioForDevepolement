---
/**
 * LAB ARTIFACT VIEWER
 * Lightweight, accessible, zero-dependency modal/inspector overlay for Lab visual artifacts.
 */
---

<dialog id="lab-artifact-dialog" class="lab-artifact-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-caption">
  <div class="dialog-backdrop" data-close-dialog></div>
  <div class="dialog-container" role="document">
    <header class="dialog-header">
      <div class="dialog-header-text">
        <span class="dialog-kicker" id="dialog-kicker">LAB EVIDENCE INSPECTOR</span>
        <h2 class="dialog-title" id="dialog-title">Artifact Detail View</h2>
      </div>
      <button type="button" class="dialog-close-btn" data-close-dialog aria-label="Close artifact viewer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </header>

    <div class="dialog-body" id="dialog-body">
      <!-- Dynamic visual clone injected by client script -->
    </div>

    <footer class="dialog-footer">
      <p class="dialog-caption" id="dialog-caption"></p>
      <button type="button" class="dialog-dismiss-btn" data-close-dialog>
        Close View (Esc)
      </button>
    </footer>
  </div>
</dialog>

<script>
  function setupArtifactViewer() {
    const dialog = document.getElementById('lab-artifact-dialog') as HTMLDialogElement | null;
    if (!dialog) return;

    const dialogTitle = document.getElementById('dialog-title');
    const dialogKicker = document.getElementById('dialog-kicker');
    const dialogCaption = document.getElementById('dialog-caption');
    const dialogBody = document.getElementById('dialog-body');

    let previousActiveElement: HTMLElement | null = null;

    // Attach click handlers to all inspectable figures
    document.querySelectorAll('.lab-artifact-figure').forEach((figure) => {
      const canvas = figure.querySelector('.artifact-canvas');
      const titleElem = figure.querySelector('.artifact-title');
      const typeElem = figure.querySelector('.type-text');
      const captionElem = figure.querySelector('.caption-text');

      if (canvas && titleElem) {
        canvas.setAttribute('title', 'Click or press Enter to inspect full artifact view');
        canvas.classList.add('is-inspectable');

        const openModal = () => {
          previousActiveElement = document.activeElement as HTMLElement;
          if (dialogTitle) dialogTitle.textContent = titleElem.textContent || 'Artifact View';
          if (dialogKicker) dialogKicker.textContent = typeElem?.textContent ? `INSPECTING // ${typeElem.textContent}` : 'LAB EVIDENCE INSPECTOR';
          if (dialogCaption) dialogCaption.textContent = captionElem?.textContent || '';
          
          if (dialogBody) {
            dialogBody.innerHTML = '';
            const clone = canvas.cloneNode(true) as HTMLElement;
            clone.removeAttribute('tabindex');
            dialogBody.appendChild(clone);
          }

          dialog.showModal();
          const closeBtn = dialog.querySelector('.dialog-close-btn') as HTMLElement | null;
          closeBtn?.focus();
        };

        canvas.addEventListener('click', openModal);
        canvas.addEventListener('keydown', (e: Event) => {
          const keyEvent = e as KeyboardEvent;
          if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
            keyEvent.preventDefault();
            openModal();
          }
        });
      }
    });

    // Close buttons & backdrop clicks
    dialog.querySelectorAll('[data-close-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => {
        dialog.close();
      });
    });

    dialog.addEventListener('close', () => {
      if (previousActiveElement) {
        previousActiveElement.focus();
      }
    });
  }

  // Initialize on DOM load & view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupArtifactViewer);
  } else {
    setupArtifactViewer();
  }
  document.addEventListener('astro:page-load', setupArtifactViewer);
</script>

<style>
  .lab-artifact-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: min(94vw, 1100px);
    width: 100%;
    margin: auto;
    border-radius: var(--radius-lg, 0.875rem);
    overflow: hidden;
  }

  .lab-artifact-dialog::backdrop {
    background: rgba(4, 10, 8, 0.85);
    backdrop-filter: blur(4px);
  }

  .dialog-container {
    background: var(--color-surface-card, #101a17);
    border: 1px solid var(--color-border-hover, rgba(126, 216, 196, 0.3));
    border-radius: var(--radius-lg, 0.875rem);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    max-height: 90vh;
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    background: rgba(255, 255, 255, 0.02);
  }

  .dialog-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dialog-kicker {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    letter-spacing: 0.08em;
  }

  .dialog-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0;
  }

  .dialog-close-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(246, 241, 232, 0.1);
    color: var(--color-text-muted, #a9b8b1);
    border-radius: 0.375rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .dialog-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .dialog-body {
    padding: 1.5rem;
    overflow-y: auto;
    background: rgba(7, 14, 12, 0.6);
  }

  .dialog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    background: rgba(255, 255, 255, 0.02);
  }

  .dialog-caption {
    font-size: 0.8rem;
    color: #83968e;
    font-style: italic;
    margin: 0;
    flex: 1;
  }

  .dialog-dismiss-btn {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 0.375rem;
    background: var(--color-surface, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.15));
    color: var(--color-text, #f6f1e8);
    cursor: pointer;
    transition: all 150ms ease;
  }

  .dialog-dismiss-btn:hover {
    background: rgba(126, 216, 196, 0.15);
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.35);
  }

  /* Light theme overrides */
  :global(html[data-theme="light"]) .dialog-container {
    background: #ffffff;
    border-color: rgba(13, 118, 99, 0.25);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  }

  :global(html[data-theme="light"]) .dialog-header {
    background: #f8faf9;
    border-bottom-color: rgba(13, 118, 99, 0.1);
  }

  :global(html[data-theme="light"]) .dialog-kicker {
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .dialog-title {
    color: #1a2621;
  }

  :global(html[data-theme="light"]) .dialog-body {
    background: #f4f8f6;
  }

  :global(html[data-theme="light"]) .dialog-footer {
    background: #f8faf9;
    border-top-color: rgba(13, 118, 99, 0.1);
  }

  :global(html[data-theme="light"]) .dialog-caption {
    color: #52665e;
  }

  :global(html[data-theme="light"]) .dialog-dismiss-btn {
    background: #edf4f1;
    border-color: rgba(13, 118, 99, 0.2);
    color: #1a2621;
  }

  :global(.is-inspectable) {
    cursor: pointer;
  }
</style>
