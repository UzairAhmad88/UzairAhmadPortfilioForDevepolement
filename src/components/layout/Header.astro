---
import Nav from '@/components/navigation/Nav.astro';
import { siteConfig } from '@/data/site';
---

<header class="site-header">
  <a class="brand" href="#top" aria-label={`${siteConfig.name} home`}>UA</a>
  <Nav />
  <a
    class="header-link"
    href={siteConfig.socialLinks.github.url}
    target="_blank"
    rel="noreferrer"
  >
    GitHub
  </a>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1180px, calc(100% - 2rem));
    margin: 1rem auto 0;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(7, 17, 15, 0.72);
    backdrop-filter: blur(18px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.26);
  }

  .brand {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
  }

  :global(nav) {
    display: flex;
    gap: 1.3rem;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 600;
  }

  :global(nav a),
  .header-link {
    transition: color 180ms ease;
  }

  :global(nav a:hover),
  .header-link:hover {
    color: var(--teal);
  }

  .header-link {
    padding: 0.85rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 700;
  }

  @media (max-width: 920px) {
    :global(nav) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      width: calc(100% - 1rem);
      margin-top: 0.5rem;
    }

    .header-link {
      padding: 0.75rem 0.9rem;
    }
  }
</style>
