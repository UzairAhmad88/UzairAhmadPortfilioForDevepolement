---
import Nav from '@/components/navigation/Nav.astro';
import MobileNavDrawer from '@/components/navigation/MobileNavDrawer.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import { siteConfig } from '@/data/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-monogram">UA</span>
      <span class="brand-full">{siteConfig.name}</span>
    </a>

    <Nav currentPath={currentPath} />

    <div class="header-actions">
      <a
        href="https://github.com/UzairAhmad88"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label="Uzair Ahmad on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </a>

      <ThemeToggle />

      <button
        type="button"
        id="mobile-menu-trigger"
        class="mobile-trigger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNavDrawer currentPath={currentPath} />

<style>
  .site-header {
    position: sticky;
    top: max(0.6rem, env(safe-area-inset-top));
    z-index: 50;
    width: min(var(--container-max, 1100px), calc(100% - max(1.25rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right)))));
    margin: 0.6rem auto 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.2));
    border-radius: var(--radius-full, 9999px);
    background: var(--color-surface-elevated, rgba(7, 17, 15, 0.9));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-surface, 0 10px 30px rgba(0, 0, 0, 0.35));
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  :global(html[data-theme="light"]) .header-container,
  :global([data-theme="light"]) .header-container {
    background: rgba(251, 249, 245, 0.95);
    border-color: rgba(20, 31, 28, 0.15);
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.06);
  }

  :global(html[data-theme="light"]) .brand-full,
  :global([data-theme="light"]) .brand-full {
    color: #141f1c;
  }

  :global(html[data-theme="light"]) .github-link,
  :global([data-theme="light"]) .github-link {
    color: #4e6059;
    border-color: rgba(20, 31, 28, 0.15);
    background: rgba(20, 31, 28, 0.04);
  }

  :global(html[data-theme="light"]) .github-link:hover,
  :global([data-theme="light"]) .github-link:hover {
    color: #0d7663;
    background: rgba(13, 118, 99, 0.08);
  }

  :global(html[data-theme="light"]) .mobile-trigger,
  :global([data-theme="light"]) .mobile-trigger {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.15);
    color: #141f1c;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text-primary, #f6f1e8);
    font-weight: 700;
    min-height: var(--touch-target-min, 44px);
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent, #7ed8c4) 0%, var(--color-accent-hover, #3ca691) 100%);
    color: #07110f;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-full {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target-min, 40px);
    height: var(--touch-target-min, 40px);
    border-radius: 50%;
    color: var(--color-text-secondary, #a9b8b1);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
  }

  .github-link:hover {
    color: var(--color-accent, #7ed8c4);
    background: rgba(126, 216, 196, 0.1);
    border-color: var(--color-accent, #7ed8c4);
  }

  .github-link:focus-visible {
    outline: 2px solid var(--color-accent, #7ed8c4);
    outline-offset: 2px;
  }

  .mobile-trigger {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--touch-target-min, 40px);
    height: var(--touch-target-min, 40px);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--motion-transition-fast), border-color var(--motion-transition-fast), color var(--motion-transition-fast);
  }

  .mobile-trigger:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mobile-trigger:focus-visible {
    outline: 2px solid var(--color-accent, #7ed8c4);
    outline-offset: 2px;
  }

  @media (max-width: 820px) {
    .mobile-trigger {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .brand-full {
      display: none;
    }
  }
</style>
