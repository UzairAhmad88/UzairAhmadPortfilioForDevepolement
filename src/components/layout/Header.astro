---
import Nav from '@/components/navigation/Nav.astro';
import MobileNavDrawer from '@/components/navigation/MobileNavDrawer.astro';
import { siteConfig } from '@/data/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-monogram">UA</span>
      <span class="brand-full">{siteConfig.name}</span>
    </a>

    <Nav currentPath={currentPath} />

    <div class="header-actions">
      <a
        class="header-cta"
        href="/contact"
      >
        Get in Touch
      </a>

      <button
        type="button"
        id="mobile-menu-trigger"
        class="mobile-trigger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNavDrawer currentPath={currentPath} />

<style>
  .site-header {
    position: sticky;
    top: max(0.6rem, env(safe-area-inset-top));
    z-index: 50;
    width: min(var(--container-max, 1200px), calc(100% - max(1.25rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right)))));
    margin: 0.6rem auto 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid rgba(126, 216, 196, 0.2);
    border-radius: var(--radius-full, 9999px);
    background: rgba(7, 17, 15, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 0 24px rgba(126, 216, 196, 0.06);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink, #f6f1e8);
    font-weight: 700;
    min-height: var(--touch-target-min, 44px);
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #7ed8c4 0%, #3ca691 100%);
    color: #07110f;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    box-shadow: 0 0 14px rgba(126, 216, 196, 0.35);
  }

  .brand-full {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid rgba(126, 216, 196, 0.35);
    border-radius: var(--radius-full, 9999px);
    background: rgba(126, 216, 196, 0.08);
    color: var(--teal, #7ed8c4);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }

  .header-cta:hover {
    background: var(--teal, #7ed8c4);
    color: #07110f;
    border-color: var(--teal, #7ed8c4);
    box-shadow: 0 0 20px rgba(126, 216, 196, 0.35);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--teal, #7ed8c4);
    outline-offset: 2px;
  }

  .mobile-trigger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: var(--touch-target-min, 44px);
    min-height: var(--touch-target-min, 44px);
    background: transparent;
    border: 1px solid rgba(246, 241, 232, 0.15);
    border-radius: 0.5rem;
    color: var(--ink, #f6f1e8);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .mobile-trigger:hover,
  .mobile-trigger:focus-visible {
    border-color: var(--teal, #7ed8c4);
    color: var(--teal, #7ed8c4);
    outline: none;
  }

  @media (max-width: 820px) {
    .brand-full {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .mobile-trigger {
      display: flex;
    }

    .site-header {
      width: calc(100% - max(1rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right))));
      margin-top: max(0.4rem, env(safe-area-inset-top));
    }
  }
</style>
