---
import Nav from '@/components/navigation/Nav.astro';
import MobileNavDrawer from '@/components/navigation/MobileNavDrawer.astro';
import { siteConfig } from '@/data/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-monogram">UA</span>
      <span class="brand-full">{siteConfig.name}</span>
    </a>

    <Nav currentPath={currentPath} />

    <div class="header-actions">
      <a
        class="header-cta"
        href="/contact"
      >
        Get in Touch
      </a>

      <button
        type="button"
        id="mobile-menu-trigger"
        class="mobile-trigger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNavDrawer currentPath={currentPath} />

<style>
  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    width: min(1200px, calc(100% - 1.5rem));
    margin: 0.75rem auto 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border-subtle, #1e293b);
    border-radius: 9999px;
    background: rgba(10, 15, 26, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text-primary, #f8fafc);
    font-weight: 700;
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: -0.02em;
  }

  .brand-full {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 9999px;
    background: rgba(59, 130, 246, 0.1);
    color: var(--color-accent, #60a5fa);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .header-cta:hover {
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    border-color: var(--color-accent, #3b82f6);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--color-accent, #3b82f6);
    outline-offset: 2px;
  }

  .mobile-trigger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    background: transparent;
    border: 1px solid var(--border-subtle, #334155);
    border-radius: 0.5rem;
    color: var(--text-primary, #f8fafc);
    cursor: pointer;
    transition: border-color 150ms ease;
  }

  .mobile-trigger:hover,
  .mobile-trigger:focus-visible {
    border-color: var(--color-accent, #3b82f6);
    outline: none;
  }

  @media (max-width: 768px) {
    .brand-full {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .mobile-trigger {
      display: flex;
    }

    .site-header {
      width: calc(100% - 1rem);
      margin-top: 0.5rem;
    }
  }
</style>
