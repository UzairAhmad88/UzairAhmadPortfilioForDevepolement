---
import Nav from '@/components/navigation/Nav.astro';
import MobileNavDrawer from '@/components/navigation/MobileNavDrawer.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import { siteConfig } from '@/data/site';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header" role="banner">
  <div class="header-container">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-monogram">UA</span>
      <span class="brand-full">{siteConfig.name}</span>
    </a>

    <Nav currentPath={currentPath} />

    <div class="header-actions">
      <ThemeToggle />

      <a
        class="header-cta"
        href="/contact"
      >
        Get in Touch
      </a>

      <button
        type="button"
        id="mobile-menu-trigger"
        class="mobile-trigger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNavDrawer currentPath={currentPath} />

<style>
  .site-header {
    position: sticky;
    top: max(0.6rem, env(safe-area-inset-top));
    z-index: 50;
    width: min(var(--container-max, 1200px), calc(100% - max(1.25rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right)))));
    margin: 0.6rem auto 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.2));
    border-radius: var(--radius-full, 9999px);
    background: var(--color-surface-elevated, rgba(7, 17, 15, 0.88));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-surface, 0 16px 40px rgba(0, 0, 0, 0.45));
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  [data-theme="light"] .header-container {
    background: rgba(251, 249, 245, 0.92);
    border-color: var(--color-border-strong);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text-primary, #f6f1e8);
    font-weight: 700;
    min-height: var(--touch-target-min, 44px);
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent, #7ed8c4) 0%, var(--color-accent-hover, #3ca691) 100%);
    color: #07110f;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    box-shadow: 0 0 14px var(--color-accent-muted, rgba(126, 216, 196, 0.35));
  }

  .brand-full {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--color-accent-muted, rgba(126, 216, 196, 0.35));
    border-radius: var(--radius-full, 9999px);
    background: var(--color-accent-muted, rgba(126, 216, 196, 0.08));
    color: var(--color-accent, #7ed8c4);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--motion-transition-fast), border-color var(--motion-transition-fast), color var(--motion-transition-fast), box-shadow var(--motion-transition-fast);
  }

  .header-cta:hover {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    box-shadow: 0 0 20px var(--color-accent-muted, rgba(126, 216, 196, 0.3));
  }

  .mobile-trigger {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--touch-target-min, 44px);
    height: var(--touch-target-min, 44px);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--motion-transition-fast), border-color var(--motion-transition-fast), color var(--motion-transition-fast);
  }

  .mobile-trigger:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mobile-trigger:focus-visible {
    outline: 2px solid var(--color-accent, #7ed8c4);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .header-cta {
      display: none;
    }
    .mobile-trigger {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .brand-full {
      display: none;
    }
  }
</style>
