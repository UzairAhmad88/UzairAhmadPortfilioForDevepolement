---
import { siteConfig } from '@/data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="brand-link" aria-label="Uzair Ahmad home">
          <span class="brand-name">{siteConfig.name}</span>
        </a>
        <p class="brand-tagline">
          Quantitative Finance · Full-Stack Engineering · Machine Learning
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="footer-link">
          GitHub ↗
        </a>
        <a href={siteConfig.socialLinks.linkedin.url} target="_blank" rel="noopener noreferrer" class="footer-link">
          LinkedIn ↗
        </a>
        <a href={`mailto:${siteConfig.email}`} class="footer-link">
          Email
        </a>
        <a href={siteConfig.socialLinks.whatsapp.url} target="_blank" rel="noopener noreferrer" class="footer-link">
          WhatsApp ↗
        </a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <a href="#top" class="back-to-top" aria-label="Scroll back to top">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border, rgba(246, 241, 232, 0.1));
    background: var(--color-surface, #07110f);
    padding: clamp(2.5rem, 4vw, 3.5rem) 0 max(1.5rem, env(safe-area-inset-bottom));
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  :global(html[data-theme="light"]) .site-footer,
  :global([data-theme="light"]) .site-footer {
    background: #fbf9f5;
    border-top-color: rgba(20, 31, 28, 0.1);
  }

  .footer-container {
    width: min(var(--container-max, 1100px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-link {
    text-decoration: none;
    color: var(--color-text-primary, #f6f1e8);
  }

  :global(html[data-theme="light"]) .brand-link,
  :global([data-theme="light"]) .brand-link {
    color: #141f1c;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-tagline {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .brand-tagline,
  :global([data-theme="light"]) .brand-tagline {
    color: #5a6e66;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-link {
    color: var(--color-text-secondary, #a9b8b1);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 150ms ease;
    min-height: var(--touch-target-min, 44px);
    display: inline-flex;
    align-items: center;
  }

  :global(html[data-theme="light"]) .footer-link,
  :global([data-theme="light"]) .footer-link {
    color: #4e6059;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .footer-link:hover,
  :global([data-theme="light"]) .footer-link:hover {
    color: #0d7663;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted, #73847b);
    flex-wrap: wrap;
    gap: 1rem;
  }

  :global(html[data-theme="light"]) .footer-bottom,
  :global([data-theme="light"]) .footer-bottom {
    color: #73847b;
  }

  .copyright {
    margin: 0;
  }

  .back-to-top {
    color: var(--color-text-secondary, #a9b8b1);
    text-decoration: none;
    font-weight: 600;
    transition: color 150ms ease;
    min-height: var(--touch-target-min, 44px);
    display: inline-flex;
    align-items: center;
  }

  :global(html[data-theme="light"]) .back-to-top,
  :global([data-theme="light"]) .back-to-top {
    color: #4e6059;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .back-to-top:hover,
  :global([data-theme="light"]) .back-to-top:hover {
    color: #0d7663;
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .footer-nav {
      gap: 1rem;
    }
  }
</style>
