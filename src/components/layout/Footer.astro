---
import { siteConfig } from '@/data/site';
import { primaryNavigation } from '@/data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand-column">
        <a class="footer-brand" href="/">
          <span class="brand-monogram">UA</span>
          <span class="brand-name">{siteConfig.name}</span>
        </a>
        <p class="brand-statement">
          {siteConfig.author.title}
        </p>
        <div class="availability-pill">
          <span class="status-indicator"></span>
          <span>Available for high-impact technical roles & select collaborations</span>
        </div>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-column">
          <h3 class="footer-heading">Navigation</h3>
          <ul class="footer-links">
            {
              primaryNavigation.map((item) => (
                <li>
                  <a href={item.href} class="footer-link">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Selected Systems</h3>
          <ul class="footer-links">
            <li>
              <a href="/work/deep-learning-stock-return-prediction" class="footer-link">Stock Return Prediction</a>
            </li>
            <li>
              <a href="/work/curasphere-hms" class="footer-link">CuraSphere HMS</a>
            </li>
            <li>
              <a href="/work/market-regime-engine" class="footer-link">Market Regime Engine</a>
            </li>
            <li>
              <a href="/work" class="footer-link highlight">All Systems →</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Direct Channels</h3>
          <ul class="footer-links">
            <li>
              <a href={`mailto:${siteConfig.email}`} class="footer-link">{siteConfig.email}</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.linkedin.url} target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn ↗</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.whatsapp.url} target="_blank" rel="noopener noreferrer" class="footer-link">WhatsApp ↗</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {siteConfig.name}. All verified projects contain open source code.
      </p>
      <a href="#top" class="back-to-top" aria-label="Scroll back to top of page">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle, #1e293b);
    background: var(--bg-surface, #090d16);
    color: var(--text-secondary, #94a3b8);
    padding: 4rem 0 2rem;
    margin-top: 5rem;
  }

  .footer-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 2.5fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-subtle, #1e293b);
  }

  .footer-brand-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text-primary, #f8fafc);
    font-weight: 700;
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.8rem;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .brand-statement {
    font-size: 0.95rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.5;
    max-width: 340px;
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-muted, #94a3b8);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    width: fit-content;
  }

  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success, #10b981);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary, #f8fafc);
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    color: var(--text-secondary, #94a3b8);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 150ms ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-accent, #60a5fa);
  }

  .footer-link.highlight {
    color: var(--color-accent, #60a5fa);
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted, #64748b);
  }

  .back-to-top {
    color: var(--text-secondary, #94a3b8);
    text-decoration: none;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--text-primary, #f8fafc);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
