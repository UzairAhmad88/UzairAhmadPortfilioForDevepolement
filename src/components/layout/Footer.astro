---
import { siteConfig } from '@/data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand-column">
        <a class="footer-brand" href="/" aria-label="Uzair Ahmad home">
          <span class="brand-monogram">UA</span>
          <span class="brand-name">{siteConfig.name}</span>
        </a>
        <p class="brand-statement">
          {siteConfig.author.title}
        </p>
        <p class="brand-subtext">
          Building verifiable software systems where statistical rigor, deep learning, and resilient production engineering converge.
        </p>
        <div class="availability-pill">
          <span class="status-indicator" aria-hidden="true"></span>
          <span>Available for select engineering & quant collaborations</span>
        </div>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-column">
          <h3 class="footer-heading">Platform</h3>
          <ul class="footer-links">
            <li>
              <a href="/#work" class="footer-link">Selected Work</a>
            </li>
            <li>
              <a href="/research" class="footer-link">Research Platform</a>
            </li>
            <li>
              <a href="/lab" class="footer-link">Lab Workbench</a>
            </li>
            <li>
              <a href="/notes" class="footer-link">Engineering Notes</a>
            </li>
            <li>
              <a href="/about" class="footer-link">About & Background</a>
            </li>
            <li>
              <a href="/how-i-build" class="footer-link">Engineering Philosophy</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Ecosystem & Index</h3>
          <ul class="footer-links">
            <li>
              <a href="/technology" class="footer-link">Technology Matrix</a>
            </li>
            <li>
              <a href="/knowledge" class="footer-link highlight">Knowledge Graph ↗</a>
            </li>
            <li>
              <a href="/timeline" class="footer-link highlight">Timeline ↗</a>
            </li>
            <li>
              <a href="/discover" class="footer-link highlight">Discovery Engine 🔍</a>
            </li>
            <li>
              <a href="/archive" class="footer-link">System Archive</a>
            </li>
            <li>
              <a href="/collaboration" class="footer-link">Collaboration Guide</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Connect & Channels</h3>
          <ul class="footer-links">
            <li>
              <a href={`mailto:${siteConfig.email}`} class="footer-link">{siteConfig.email}</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.linkedin.url} target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn ↗</a>
            </li>
            <li>
              <a href={siteConfig.socialLinks.whatsapp.url} target="_blank" rel="noopener noreferrer" class="footer-link">WhatsApp ↗</a>
            </li>
            <li>
              <a href="/contact" class="footer-link highlight">Contact Channel →</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {siteConfig.name}. Engineered with Astro SSG · 100% Deterministic Code & Public Open Architecture.
      </p>
      <a href="#top" class="back-to-top" aria-label="Scroll back to top of page">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border, rgba(246, 241, 232, 0.12));
    background: var(--color-surface-elevated, rgba(7, 17, 15, 0.95));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text-secondary, #a9b8b1);
    padding: clamp(3rem, 5vw, 4.5rem) 0 max(2rem, env(safe-area-inset-bottom));
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }

  [data-theme="light"] .site-footer {
    background: rgba(251, 249, 245, 0.95);
    border-top-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
  }

  .footer-container {
    width: min(var(--container-max, 1200px), calc(100% - max(1.5rem, calc(env(safe-area-inset-left) + env(safe-area-inset-right) + 1rem))));
    margin: 0 auto;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 2.5fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
  }

  .footer-brand-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink, #f6f1e8);
    font-weight: 700;
  }

  .brand-monogram {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #7ed8c4 0%, #3ca691 100%);
    color: #07110f;
    font-weight: 800;
    font-size: 0.8rem;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(126, 216, 196, 0.3);
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .brand-statement {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink, #f6f1e8);
    line-height: 1.4;
    max-width: 360px;
    margin: 0;
  }

  .brand-subtext {
    font-size: 0.875rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.6;
    max-width: 360px;
    margin: 0;
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--teal, #7ed8c4);
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.24);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    width: fit-content;
    line-height: 1.4;
  }

  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal, #7ed8c4);
    box-shadow: 0 0 8px rgba(126, 216, 196, 0.6);
    flex-shrink: 0;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink, #f6f1e8);
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    color: var(--muted, #a9b8b1);
    text-decoration: none;
    font-size: 0.9rem;
    overflow-wrap: break-word;
    word-break: break-word;
    transition: color 150ms ease;
    min-height: 1.75rem;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--teal, #7ed8c4);
  }

  .footer-link.highlight {
    color: var(--teal, #7ed8c4);
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.85rem;
    color: var(--muted, #a9b8b1);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    margin: 0;
    line-height: 1.5;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    color: var(--muted, #a9b8b1);
    text-decoration: none;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--teal, #7ed8c4);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
