---
import type { ProjectVisualization } from '@/types/visualization';

export interface Props {
  visualization: ProjectVisualization;
  class?: string;
}

const { visualization, class: className } = Astro.props;

const statusLabelMap = {
  actual: 'Actual System Architecture',
  prototype: 'Working Prototype Topology',
  conceptual: 'Conceptual Architecture',
};

const roleBadgeMap = {
  input: 'Ingestion & Feed',
  process: 'Transformation & State',
  model: 'Model & Inference',
  guardrail: 'Guardrail & Contract',
  storage: 'Persistence & Cache',
  output: 'Output & Evaluation',
  router: 'Orchestrator & Router',
};
---

<figure class:list={['project-visualization-shell', className]} aria-label={visualization.title}>
  <header class="vis-header">
    <div class="vis-eyebrow-row">
      <span class="vis-type-tag">{visualization.type.replace('-', ' ')}</span>
      <span class:list={['vis-status-badge', `status-${visualization.status}`]}>
        <span class="status-indicator-dot" aria-hidden="true"></span>
        {statusLabelMap[visualization.status] || 'System Architecture'}
      </span>
    </div>

    <h3 class="vis-title">{visualization.title}</h3>

    {visualization.description && (
      <p class="vis-description">{visualization.description}</p>
    )}
  </header>

  <div class="vis-canvas" role="region" aria-label="Visual Topology Diagram">
    <div class="vis-nodes-grid" style={`--node-count: ${visualization.nodes.length}`}>
      {visualization.nodes.map((node, index) => (
        <div class="vis-node-wrapper">
          <div class:list={['vis-node-card', `role-${node.role || 'process'}`]}>
            <div class="node-header">
              <span class="node-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {node.badge ? (
                <span class="node-badge">{node.badge}</span>
              ) : node.role ? (
                <span class="node-badge">{roleBadgeMap[node.role]}</span>
              ) : null}
            </div>

            <h4 class="node-label">{node.label}</h4>
            {node.subLabel && <p class="node-sublabel">{node.subLabel}</p>}

            {node.details && node.details.length > 0 && (
              <ul class="node-details-list" aria-label={`Details for ${node.label}`}>
                {node.details.map((detail) => (
                  <li class="node-detail-item">{detail}</li>
                ))}
              </ul>
            )}
          </div>

          {index < visualization.nodes.length - 1 && (
            <div class="vis-connector" aria-hidden="true">
              <svg class="connector-arrow-desktop" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <svg class="connector-arrow-mobile" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 5V19M12 19L6 13M12 19L18 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <footer class="vis-footer">
    {visualization.caption && (
      <figcaption class="vis-caption">
        <strong>Technical Context:</strong> {visualization.caption}
      </figcaption>
    )}

    {visualization.sourceEvidence && (
      <div class="vis-evidence-ref">
        <span class="evidence-icon" aria-hidden="true">✓</span>
        <span class="evidence-text">Grounding Evidence: {visualization.sourceEvidence}</span>
      </div>
    )}

    {visualization.textAlternative && (
      <details class="vis-accessible-details">
        <summary class="accessible-summary">Textual Diagram Description (Assistive Tech)</summary>
        <div class="accessible-content">
          <p>{visualization.textAlternative}</p>
        </div>
      </details>
    )}
  </footer>
</figure>

<style>
  .project-visualization-shell {
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(126, 216, 196, 0.2);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    margin: 1.5rem 0 2.5rem 0;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  .vis-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .vis-eyebrow-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .vis-type-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
  }

  .vis-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    font-family: var(--font-mono, monospace);
  }

  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-actual {
    background: rgba(126, 216, 196, 0.12);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.3);
  }

  .status-prototype {
    background: rgba(189, 166, 255, 0.15);
    color: #bda6ff;
    border: 1px solid rgba(189, 166, 255, 0.3);
  }

  .status-conceptual {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .vis-title {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .vis-description {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0;
  }

  /* ==========================================================================
     CANVAS & NODES GRID
     ========================================================================== */
  .vis-canvas {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0 1.25rem 0;
  }

  .vis-nodes-grid {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: min-content;
  }

  .vis-node-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 180px;
  }

  .vis-node-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 1.15rem 1.15rem 1rem;
    background: rgba(7, 17, 15, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: 0.65rem;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .vis-node-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  /* Node Roles */
  .vis-node-card.role-input {
    border-left: 3px solid #83968e;
  }

  .vis-node-card.role-process, .vis-node-card.role-router {
    border-left: 3px solid var(--color-accent, #7ed8c4);
  }

  .vis-node-card.role-model {
    border-left: 3px solid #bda6ff;
  }

  .vis-node-card.role-guardrail {
    border-left: 3px solid #6ee7b7;
  }

  .vis-node-card.role-storage {
    border-left: 3px solid #7ed8c4;
  }

  .vis-node-card.role-output {
    border-left: 3px solid #d2a071;
  }

  .node-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }

  .node-index {
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-text-muted, #83968e);
  }

  .node-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.675rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-muted, #a9b8b1);
    white-space: nowrap;
  }

  .node-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.35rem 0;
    line-height: 1.35;
  }

  .node-sublabel {
    font-size: 0.8rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.45;
    margin: 0 0 0.65rem 0;
    flex-grow: 1;
  }

  .node-details-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px dashed rgba(246, 241, 232, 0.08);
    padding-top: 0.5rem;
  }

  .node-detail-item {
    font-size: 0.725rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #7ed8c4);
    line-height: 1.35;
  }

  .vis-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #7ed8c4);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .connector-arrow-desktop {
    width: 20px;
    height: 20px;
    display: block;
  }

  .connector-arrow-mobile {
    display: none;
    width: 20px;
    height: 20px;
  }

  /* ==========================================================================
     FOOTER & CAPTION
     ========================================================================== */
  .vis-footer {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .vis-caption {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
    margin: 0;
  }

  .vis-caption strong {
    color: var(--color-text, #f6f1e8);
  }

  .vis-evidence-ref {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--color-accent, #7ed8c4);
  }

  .evidence-icon {
    font-weight: 800;
  }

  .vis-accessible-details {
    margin-top: 0.5rem;
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    background: rgba(7, 17, 15, 0.4);
  }

  .accessible-summary {
    font-size: 0.775rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
    cursor: pointer;
    user-select: none;
  }

  .accessible-summary:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .accessible-content {
    margin-top: 0.5rem;
    font-size: 0.825rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 820px) {
    .vis-nodes-grid {
      flex-direction: column;
      gap: 0.75rem;
      min-width: 100%;
    }

    .vis-node-wrapper {
      flex-direction: column;
      width: 100%;
      min-width: 100%;
    }

    .connector-arrow-desktop {
      display: none;
    }

    .connector-arrow-mobile {
      display: block;
      margin: 0.25rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vis-node-card {
      transition: none !important;
      transform: none !important;
    }
  }

  /* ==========================================================================
     LIGHT THEME STYLING
     ========================================================================== */
  :global(html[data-theme="light"]) .project-visualization-shell,
  :global([data-theme="light"]) .project-visualization-shell {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .vis-title,
  :global([data-theme="light"]) .vis-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .vis-description,
  :global([data-theme="light"]) .vis-description,
  :global(html[data-theme="light"]) .vis-caption,
  :global([data-theme="light"]) .vis-caption {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .vis-caption strong,
  :global([data-theme="light"]) .vis-caption strong {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .vis-type-tag,
  :global([data-theme="light"]) .vis-type-tag {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .vis-node-card,
  :global([data-theme="light"]) .vis-node-card {
    background: #f8fafc !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 2px 8px rgba(20, 31, 28, 0.03) !important;
  }

  :global(html[data-theme="light"]) .vis-node-card:hover,
  :global([data-theme="light"]) .vis-node-card:hover {
    background: #ffffff !important;
    border-color: #0d7663 !important;
    box-shadow: 0 8px 20px rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .node-label,
  :global([data-theme="light"]) .node-label {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .node-sublabel,
  :global([data-theme="light"]) .node-sublabel {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .node-badge,
  :global([data-theme="light"]) .node-badge {
    background: rgba(20, 31, 28, 0.04) !important;
    color: #35453f !important;
    border: 1px solid rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .node-index,
  :global([data-theme="light"]) .node-index {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .node-detail-item,
  :global([data-theme="light"]) .node-detail-item {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .vis-connector,
  :global([data-theme="light"]) .vis-connector {
    color: #0d7663 !important;
    opacity: 0.8 !important;
  }

  :global(html[data-theme="light"]) .vis-evidence-ref,
  :global([data-theme="light"]) .vis-evidence-ref {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .vis-accessible-details,
  :global([data-theme="light"]) .vis-accessible-details {
    background: rgba(20, 31, 28, 0.02) !important;
    border-color: rgba(20, 31, 28, 0.1) !important;
  }

  :global(html[data-theme="light"]) .accessible-summary,
  :global([data-theme="light"]) .accessible-summary {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .accessible-content,
  :global([data-theme="light"]) .accessible-content {
    color: #35453f !important;
  }
</style>
