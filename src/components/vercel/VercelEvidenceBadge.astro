---
/**
 * Vercel Evidence Badge Component
 * Phase 16 — Verified Deployment & Production Evidence Presentation
 */
import type { VercelEvidence } from '@/types/vercel';
import { formatFrameworkName } from '@/lib/vercel/normalizer';

interface Props {
  evidence: VercelEvidence;
  compact?: boolean;
  showGitLink?: boolean;
}

const { evidence, compact = false, showGitLink = false } = Astro.props;

const isProduction = evidence.production && evidence.target === 'production';
const targetLabel = isProduction ? 'Production' : evidence.target === 'preview' ? 'Preview' : 'Development';
const frameworkDisplay = formatFrameworkName(evidence.framework);

// Accessible status color classes
const statusDotClass = evidence.deploymentState === 'READY'
  ? 'bg-emerald-400'
  : evidence.deploymentState === 'BUILDING'
  ? 'bg-amber-400 animate-pulse'
  : 'bg-rose-400';
---

{compact ? (
  <a
    href={evidence.deploymentUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-emerald-500/30 text-xs font-mono text-slate-300 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
    aria-label={`Visit verified ${targetLabel.toLowerCase()} deployment on Vercel (opens in new tab)`}
  >
    <span class={`w-1.5 h-1.5 rounded-full ${statusDotClass}`} aria-hidden="true"></span>
    <span class="font-medium text-white">{isProduction ? 'Live Site' : 'Preview'}</span>
    <span class="text-slate-500">↗</span>
  </a>
) : (
  <div class="rounded-xl border border-white/10 bg-slate-900/60 backdrop-blur-md p-4 space-y-3">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2">
        <span class={`w-2 h-2 rounded-full ${statusDotClass}`} aria-hidden="true"></span>
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-200">
          {targetLabel} Deployment
        </span>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-400">
          {evidence.deploymentState}
        </span>
      </div>

      <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
        <span>{frameworkDisplay}</span>
        <span>•</span>
        <span title={`Provenance: ${evidence.provenance}`}>
          Verified {new Date(evidence.lastVerifiedAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
        </span>
      </div>
    </div>

    <div class="flex items-center justify-between gap-4 pt-1">
      <a
        href={evidence.deploymentUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-medium text-emerald-400 hover:text-emerald-300 transition-colors focus-visible:outline-none focus-visible:underline"
        aria-label={`Visit live verified deployment at ${evidence.deploymentUrl}`}
      >
        <span>{evidence.isCustomDomain ? 'Visit Custom Domain' : 'Visit Live Deployment'}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      {showGitLink && evidence.matchedGitHubRepo && (
        <a
          href={`https://github.com/${evidence.matchedGitHubRepo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 hover:text-slate-200 transition-colors"
          aria-label={`View linked GitHub repository ${evidence.matchedGitHubRepo}`}
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Repository</span>
        </a>
      )}
    </div>
  </div>
)}
