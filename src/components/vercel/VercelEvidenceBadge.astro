---
/**
 * Vercel Evidence Badge Component
 * Phase 16 — Verified Deployment & Production Evidence Presentation
 */
import type { VercelEvidence } from '@/types/vercel';
import { formatFrameworkName } from '@/lib/vercel/normalizer';

interface Props {
  evidence: VercelEvidence;
  compact?: boolean;
  showGitLink?: boolean;
}

const { evidence, compact = false, showGitLink = false } = Astro.props;

const isProduction = evidence.production && evidence.target === 'production';
const targetLabel = isProduction ? 'Production' : evidence.target === 'preview' ? 'Preview' : 'Development';
const frameworkDisplay = formatFrameworkName(evidence.framework);

// Accessible status color classes
const statusDotClass = evidence.deploymentState === 'READY'
  ? 'bg-emerald-400'
  : evidence.deploymentState === 'BUILDING'
  ? 'bg-amber-400 animate-pulse'
  : 'bg-rose-400';
---

{compact ? (
  <a
    href={evidence.deploymentUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="evidence-badge-compact"
    aria-label={`Visit verified ${targetLabel.toLowerCase()} deployment on Vercel (opens in new tab)`}
  >
    <span class={`status-dot ${statusDotClass}`} aria-hidden="true"></span>
    <span class="badge-label">{isProduction ? 'Live Site' : 'Preview'}</span>
    <span class="badge-arrow">↗</span>
  </a>
) : (
  <div class="evidence-card">
    <div class="evidence-header">
      <div class="header-left">
        <span class={`status-dot ${statusDotClass}`} aria-hidden="true"></span>
        <span class="target-label">
          {targetLabel} Deployment
        </span>
        <span class="state-chip">
          {evidence.deploymentState}
        </span>
      </div>

      <div class="provenance-info">
        <span>{frameworkDisplay}</span>
        <span>•</span>
        <span title={`Provenance: ${evidence.provenance}`}>
          Verified {new Date(evidence.lastVerifiedAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
        </span>
      </div>
    </div>

    <div class="evidence-links">
      <a
        href={evidence.deploymentUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="live-link"
        aria-label={`Visit live verified deployment at ${evidence.deploymentUrl}`}
      >
        <span>{evidence.isCustomDomain ? 'Visit Custom Domain' : 'Visit Live Deployment'}</span>
        <svg class="link-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      {showGitLink && evidence.matchedGitHubRepo && (
        <a
          href={`https://github.com/${evidence.matchedGitHubRepo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link"
          aria-label={`View linked GitHub repository ${evidence.matchedGitHubRepo}`}
        >
          <svg class="repo-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Repository</span>
        </a>
      )}
    </div>
  </div>
)}

<style>
  .evidence-badge-compact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.1);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-secondary, #a9b8b1);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .evidence-badge-compact:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .evidence-card {
    border-radius: 0.75rem;
    border: 1px solid rgba(246, 241, 232, 0.09);
    background: rgba(16, 26, 23, 0.75);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  .evidence-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    display: inline-block;
  }

  .bg-emerald-400 {
    background: #10b981;
  }

  .bg-amber-400 {
    background: #f59e0b;
  }

  .bg-rose-400 {
    background: #ef4444;
  }

  .target-label {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text, #f6f1e8);
  }

  .state-chip {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: #83968e;
  }

  .provenance-info {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .evidence-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(246, 241, 232, 0.06);
  }

  .live-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
  }

  .live-link:hover {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  .link-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
    text-decoration: none;
  }

  .repo-link:hover {
    color: var(--color-text, #f6f1e8);
  }

  .repo-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* Light Theme Overrides */
  :global(html[data-theme="light"]) .evidence-card,
  :global([data-theme="light"]) .evidence-card {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04) !important;
  }

  :global(html[data-theme="light"]) .target-label,
  :global([data-theme="light"]) .target-label {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .state-chip,
  :global([data-theme="light"]) .state-chip,
  :global(html[data-theme="light"]) .evidence-badge-compact,
  :global([data-theme="light"]) .evidence-badge-compact {
    background: rgba(20, 31, 28, 0.04) !important;
    border-color: rgba(20, 31, 28, 0.1) !important;
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .provenance-info,
  :global([data-theme="light"]) .provenance-info,
  :global(html[data-theme="light"]) .repo-link,
  :global([data-theme="light"]) .repo-link {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .live-link,
  :global([data-theme="light"]) .live-link {
    color: #0d7663 !important;
  }
</style>
