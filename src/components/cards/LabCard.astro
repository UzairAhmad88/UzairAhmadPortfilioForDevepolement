---
import type { ResearchItem } from '@/types/research';

export interface Props {
  item: ResearchItem;
}

const { item } = Astro.props;
---

<article class="lab-card reveal">
  <div class="card-top">
    <span class="badge">{item.badge}</span>
    <span class="index-num">INQ // {item.slug}</span>
  </div>
  <h3>{item.title}</h3>
  <p class="question-text">
    <strong>Inquiry:</strong> {item.question}
  </p>
  <p class="approach-text">
    <strong>Methodology:</strong> {item.approach}
  </p>
  <a href={`/research/${item.slug}`} class="explore-link">
    Inspect Inquiry & Findings →
  </a>
</article>

<style>
  .lab-card {
    padding: 1.35rem;
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 8px;
    background: rgba(16, 26, 23, 0.75);
    display: flex;
    flex-direction: column;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    border-color: rgba(126, 216, 196, 0.35);
    background: rgba(16, 26, 23, 0.9);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .badge {
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .index-num {
    color: #83968e;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
  }

  .lab-card h3 {
    margin: 0 0 0.75rem 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
  }

  .question-text, .approach-text {
    color: var(--color-text-muted, #a9b8b1);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
  }

  .question-text strong, .approach-text strong {
    color: var(--color-text, #f6f1e8);
  }

  .explore-link {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-accent, #7ed8c4);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .explore-link:hover {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  :global(html[data-theme="light"]) .lab-card,
  :global([data-theme="light"]) .lab-card {
    background: #ffffff !important;
    border: 1px solid rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04) !important;
  }

  :global(html[data-theme="light"]) .lab-card:hover,
  :global([data-theme="light"]) .lab-card:hover {
    background: #ffffff !important;
    border-color: #0d7663 !important;
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .lab-card h3,
  :global([data-theme="light"]) .lab-card h3 {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .question-text,
  :global([data-theme="light"]) .question-text,
  :global(html[data-theme="light"]) .approach-text,
  :global([data-theme="light"]) .approach-text {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .question-text strong,
  :global([data-theme="light"]) .question-text strong,
  :global(html[data-theme="light"]) .approach-text strong,
  :global([data-theme="light"]) .approach-text strong {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .badge,
  :global([data-theme="light"]) .badge {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .index-num,
  :global([data-theme="light"]) .index-num {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .explore-link,
  :global([data-theme="light"]) .explore-link {
    border-top-color: rgba(20, 31, 28, 0.08) !important;
    color: #0d7663 !important;
  }
</style>
