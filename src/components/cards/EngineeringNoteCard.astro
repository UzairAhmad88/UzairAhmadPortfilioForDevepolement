---
import type { EngineeringNote } from '@/types/note';

export interface Props {
  note: EngineeringNote;
}

const { note } = Astro.props;

const typeColorMap: Record<string, string> = {
  'Debugging Note': 'type-debugging',
  'Architecture Note': 'type-architecture',
  'Technical Note': 'type-technical',
  'Decision Note': 'type-decision',
  'Implementation Note': 'type-implementation',
  'UX Note': 'type-ux',
  'Learning Note': 'type-learning',
};
---

<article class="note-card">
  <div class="note-header">
    <div class="meta-tags">
      <span class="topic-tag">{note.topic}</span>
      <span class:list={['type-tag', typeColorMap[note.type] || 'type-technical']}>
        {note.type}
      </span>
    </div>
    <span class="reading-time">{note.readingTimeMinutes} min read</span>
  </div>

  <h3 class="note-title">
    <a href={`/notes/${note.slug}`} class="title-link">
      {note.title}
    </a>
  </h3>

  <p class="note-summary">{note.summary}</p>

  {note.technologies && note.technologies.length > 0 && (
    <div class="tech-stack-row">
      {note.technologies.map((tech) => (
        <a href={`/technology/${tech}`} class="tech-pill">
          {tech}
        </a>
      ))}
    </div>
  )}

  <div class="note-footer">
    <span class="note-date">{note.publishedAt}</span>
    <a href={`/notes/${note.slug}`} class="read-link">
      Read Note →
    </a>
  </div>
</article>

<style>
  .note-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .note-card:hover {
    transform: translateY(-3px);
    border-color: rgba(126, 216, 196, 0.35);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .note-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .topic-tag {
    font-size: 0.725rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
  }

  .type-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
  }

  .type-debugging {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .type-architecture {
    background: rgba(168, 85, 247, 0.15);
    color: #d8b4fe;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .type-technical {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .type-decision {
    background: rgba(245, 158, 11, 0.15);
    color: #fcd34d;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .type-implementation {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .type-ux {
    background: rgba(236, 72, 153, 0.15);
    color: #f472b6;
    border: 1px solid rgba(236, 72, 153, 0.3);
  }

  .type-learning {
    background: rgba(14, 165, 233, 0.15);
    color: #7dd3fc;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }

  .reading-time {
    font-size: 0.725rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .note-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 0.75rem 0;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .note-summary {
    font-size: 0.925rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
  }

  .tech-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .tech-pill {
    font-size: 0.725rem;
    padding: 0.15rem 0.45rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.25rem;
    color: var(--color-text-muted, #a9b8b1);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .tech-pill:hover {
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .note-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(246, 241, 232, 0.09);
    margin-top: auto;
  }

  .note-date {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .read-link:hover,
  .read-link:focus-visible {
    color: #9bd8cf;
    text-decoration: underline;
  }

  [data-theme="light"] .note-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05);
  }

  [data-theme="light"] .tech-pill {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border-subtle, rgba(20, 31, 28, 0.08));
    color: var(--color-text-secondary, #465751);
  }
</style>
