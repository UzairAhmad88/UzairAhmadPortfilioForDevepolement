---
import type { LabItem } from '@/types/lab';

export interface Props {
  item: LabItem;
}

const { item } = Astro.props;

const statusClassMap: Record<string, string> = {
  Completed: 'status-completed',
  Active: 'status-active',
  Prototype: 'status-prototype',
  Validating: 'status-validating',
  Exploring: 'status-exploring',
  Paused: 'status-paused',
  Archived: 'status-archived',
  Abandoned: 'status-abandoned',
  Idea: 'status-idea',
};

const stateLabelMap: Record<string, string> = {
  actual: 'ACTUAL IMPLEMENTATION',
  prototype: 'WORKING PROTOTYPE',
  concept: 'MATHEMATICAL CONCEPT',
  planned: 'PLANNED EXPERIMENT',
};

const statusClass = statusClassMap[item.status] || 'status-default';
const stateLabel = stateLabelMap[item.state] || item.state.toUpperCase();
---

<article class="lab-card">
  <div class="card-content">
    <!-- Top Metadata Strip -->
    <div class="card-header">
      <div class="badge-group">
        <span class:list={['status-pill', statusClass]}>
          {item.status.toUpperCase()}
        </span>
        <span class="type-pill">
          {item.type}
        </span>
      </div>
      <span class="state-label">
        {item.year} // {stateLabel}
      </span>
    </div>

    <!-- Title & Question -->
    <div class="title-section">
      <h3 class="card-title">
        <a href={`/lab/${item.slug}`} class="title-link">
          {item.title}
        </a>
      </h3>

      <div class="question-box">
        <span class="q-prefix">Q:</span>
        <span class="q-content">{item.question}</span>
      </div>
    </div>

    <!-- Description -->
    <p class="card-description">
      {item.shortDescription}
    </p>

    <!-- Outcome Badge -->
    {item.resultOutcome && (
      <div class="outcome-row">
        <span class="outcome-label">Outcome:</span>
        <span class="outcome-value">{item.resultOutcome}</span>
      </div>
    )}
  </div>

  <!-- Footer Strip: Technologies & Actions -->
  <div class="card-footer">
    <div class="tech-stack">
      {item.technologies.slice(0, 4).map((tech) => (
        <span class="tech-tag">
          {tech}
        </span>
      ))}
      {item.technologies.length > 4 && (
        <span class="tech-overflow">
          +{item.technologies.length - 4}
        </span>
      )}
    </div>

    <a href={`/lab/${item.slug}`} class="inspect-link">
      Inspect Workbench <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .lab-card {
    background: var(--color-surface-card, rgba(16, 26, 23, 0.75));
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.09));
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
    height: 100%;
    box-shadow: var(--shadow-sm);
  }

  .lab-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent, #7ed8c4);
    box-shadow: var(--shadow-card, 0 12px 32px rgba(0, 0, 0, 0.4));
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .status-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid transparent;
  }

  .status-completed {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border-color: rgba(16, 185, 129, 0.35);
  }

  .status-active {
    background: rgba(126, 216, 196, 0.15);
    color: #7ed8c4;
    border-color: rgba(126, 216, 196, 0.4);
  }

  .status-prototype,
  .status-validating,
  .status-exploring {
    background: rgba(126, 216, 196, 0.1);
    color: #9bd8cf;
    border-color: rgba(126, 216, 196, 0.25);
  }

  .status-paused,
  .status-archived,
  .status-idea,
  .status-default {
    background: rgba(148, 163, 184, 0.12);
    color: #cbd5e1;
    border-color: rgba(148, 163, 184, 0.25);
  }

  .status-abandoned {
    background: rgba(239, 68, 68, 0.12);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .type-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    background: var(--color-surface, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.09));
    color: var(--color-text-muted, #83968e);
  }

  .state-label {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
  }

  .title-section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .question-box {
    background: var(--color-accent-muted, rgba(126, 216, 196, 0.08));
    border-left: 3px solid var(--color-accent, #7ed8c4);
    padding: 0.5rem 0.75rem;
    border-radius: 0 0.375rem 0.375rem 0;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    line-height: 1.5;
    color: var(--color-text-primary, #f6f1e8);
  }

  .q-prefix {
    font-weight: 800;
    color: var(--color-accent, #7ed8c4);
    margin-right: 0.35rem;
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .outcome-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .outcome-label {
    color: var(--color-text-muted, #83968e);
  }

  .outcome-value {
    color: var(--color-text-secondary, #a9b8b1);
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    margin-top: auto;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .tech-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    padding: 0.15rem 0.45rem;
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    border-radius: 0.25rem;
    color: var(--color-text-secondary, #a9b8b1);
  }

  .tech-overflow {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
  }

  .inspect-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    min-height: var(--touch-target-min, 44px);
    transition: color 150ms ease, transform 150ms ease;
  }

  .inspect-link:hover,
  .inspect-link:focus-visible {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  .inspect-link:hover .arrow {
    transform: translateX(3px);
  }

  .arrow {
    transition: transform 150ms ease;
  }

  :global(html[data-theme="light"]) .lab-card,
  :global([data-theme="light"]) .lab-card {
    background: #ffffff !important;
    border: 1px solid rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .lab-card:hover,
  :global([data-theme="light"]) .lab-card:hover {
    background: #ffffff !important;
    border-color: #0d7663 !important;
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.09) !important;
  }

  :global(html[data-theme="light"]) .card-title,
  :global([data-theme="light"]) .card-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .question-box,
  :global([data-theme="light"]) .question-box {
    background: rgba(13, 118, 99, 0.08) !important;
    border-left-color: #0d7663 !important;
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .q-prefix,
  :global([data-theme="light"]) .q-prefix {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .card-description,
  :global([data-theme="light"]) .card-description {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .inspect-link,
  :global([data-theme="light"]) .inspect-link {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .type-pill,
  :global([data-theme="light"]) .type-pill,
  :global(html[data-theme="light"]) .tech-tag,
  :global([data-theme="light"]) .tech-tag,
  :global(html[data-theme="light"]) .outcome-value,
  :global([data-theme="light"]) .outcome-value {
    background: rgba(20, 31, 28, 0.04) !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    color: #35453f !important;
  }
</style>
