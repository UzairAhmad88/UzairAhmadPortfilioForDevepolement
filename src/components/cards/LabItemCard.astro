---
import type { LabItem } from '@/types/lab';

export interface Props {
  item: LabItem;
}

const { item } = Astro.props;

const statusColors: Record<string, string> = {
  Completed: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Active: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30',
  Prototype: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  Validating: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  Exploring: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
  Paused: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Abandoned: 'bg-rose-500/10 text-rose-400 border-rose-500/30',
  Idea: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};

const stateBadge: Record<string, string> = {
  actual: 'ACTUAL IMPLEMENTATION',
  prototype: 'WORKING PROTOTYPE',
  concept: 'MATHEMATICAL CONCEPT',
  planned: 'PLANNED EXPERIMENT',
};

const statusClass = statusColors[item.status] || 'bg-slate-500/10 text-slate-400 border-slate-500/30';
---

<article class="lab-card group relative flex flex-col justify-between rounded-xl border border-slate-800 bg-[#12161c]/80 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-indigo-500/40 hover:bg-[#151b23] hover:shadow-lg hover:shadow-indigo-950/20">
  <div class="space-y-4">
    <!-- Top Metadata Strip -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class={`px-2 py-0.5 rounded border text-[10px] font-semibold tracking-wider ${statusClass}`}>
          {item.status.toUpperCase()}
        </span>
        <span class="text-slate-400 bg-slate-800/80 px-2 py-0.5 rounded text-[10px] uppercase tracking-wider">
          {item.type}
        </span>
      </div>
      <span class="text-slate-400 text-[11px] font-mono">
        {item.year} // {stateBadge[item.state] || item.state.toUpperCase()}
      </span>
    </div>

    <!-- Title & Question -->
    <div>
      <h3 class="text-lg font-bold tracking-tight text-slate-100 group-hover:text-indigo-400 transition-colors">
        <a href={`/lab/${item.slug}`} class="focus:outline-none focus:underline">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {item.title}
        </a>
      </h3>
      <p class="mt-2 text-xs font-mono text-indigo-300/90 leading-relaxed bg-indigo-950/20 border-l-2 border-indigo-500/40 px-2.5 py-1.5 rounded-r">
        <span class="text-slate-400 font-semibold">Q:</span> {item.question}
      </p>
    </div>

    <!-- Short Description / Intent -->
    <p class="text-sm text-slate-400 leading-relaxed line-clamp-3">
      {item.shortDescription}
    </p>

    <!-- Outcome Badge if present -->
    <div class="flex items-center gap-2 pt-1 text-xs">
      <span class="text-slate-400 font-mono text-[11px]">Outcome:</span>
      <span class="text-slate-300 font-mono text-[11px] bg-slate-800/60 px-2 py-0.5 rounded border border-slate-700/50">
        {item.resultOutcome}
      </span>
    </div>
  </div>

  <!-- Footer Strip: Technologies & Actions -->
  <div class="mt-5 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex flex-wrap items-center gap-1.5">
      {item.technologies.slice(0, 4).map((tech) => (
        <span class="rounded bg-slate-800/80 px-2 py-0.5 font-mono text-[11px] text-slate-300">
          {tech}
        </span>
      ))}
      {item.technologies.length > 4 && (
        <span class="font-mono text-[10px] text-slate-400">
          +{item.technologies.length - 4}
        </span>
      )}
    </div>

    <span class="text-indigo-400 font-semibold text-xs flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Inspect Workbench →
    </span>
  </div>
</article>
