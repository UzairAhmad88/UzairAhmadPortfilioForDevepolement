---
import type { LabItem } from '@/types/lab';

export interface Props {
  item: LabItem;
}

const { item } = Astro.props;

const statusColors: Record<string, string> = {
  Completed: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Active: 'bg-[rgba(126,216,196,0.1)] text-[#7ed8c4] border-[rgba(126,216,196,0.3)]',
  Prototype: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Validating: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Exploring: 'bg-[rgba(126,216,196,0.08)] text-[#9bd8cf] border-[rgba(126,216,196,0.22)]',
  Paused: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
  Abandoned: 'bg-rose-500/10 text-rose-400 border-rose-500/30',
  Idea: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};

const stateBadge: Record<string, string> = {
  actual: 'ACTUAL IMPLEMENTATION',
  prototype: 'WORKING PROTOTYPE',
  concept: 'MATHEMATICAL CONCEPT',
  planned: 'PLANNED EXPERIMENT',
};

const statusClass = statusColors[item.status] || 'bg-slate-500/10 text-slate-400 border-slate-500/30';
---

<article class="lab-card group relative flex flex-col justify-between rounded-xl border border-[rgba(246,241,232,0.09)] bg-[rgba(16,26,23,0.75)] p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[rgba(126,216,196,0.35)] hover:bg-[rgba(16,26,23,0.9)] hover:shadow-lg hover:shadow-black/40">
  <div class="space-y-4">
    <!-- Top Metadata Strip -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class={`px-2 py-0.5 rounded-full border text-[10px] font-semibold tracking-wider ${statusClass}`}>
          {item.status.toUpperCase()}
        </span>
        <span class="text-[#83968e] bg-[rgba(255,255,255,0.04)] border border-[rgba(246,241,232,0.08)] px-2 py-0.5 rounded text-[10px] uppercase tracking-wider font-semibold">
          {item.type}
        </span>
      </div>
      <span class="text-[#83968e] text-[11px] font-mono">
        {item.year} // {stateBadge[item.state] || item.state.toUpperCase()}
      </span>
    </div>

    <!-- Title & Question -->
    <div>
      <h3 class="text-lg font-bold tracking-tight text-[#f6f1e8] group-hover:text-[#7ed8c4] transition-colors">
        <a href={`/lab/${item.slug}`} class="focus:outline-none focus:underline">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {item.title}
        </a>
      </h3>
      <p class="mt-2 text-xs font-mono text-[#f6f1e8] leading-relaxed bg-[rgba(255,255,255,0.03)] border-l-2 border-[#7ed8c4] px-2.5 py-1.5 rounded-r">
        <span class="text-[#7ed8c4] font-bold">Q:</span> {item.question}
      </p>
    </div>

    <!-- Short Description / Intent -->
    <p class="text-sm text-[#a9b8b1] leading-relaxed line-clamp-3">
      {item.shortDescription}
    </p>

    <!-- Outcome Badge if present -->
    <div class="flex items-center gap-2 pt-1 text-xs">
      <span class="text-[#83968e] font-mono text-[11px]">Outcome:</span>
      <span class="text-[#a9b8b1] font-mono text-[11px] bg-[rgba(255,255,255,0.04)] px-2 py-0.5 rounded border border-[rgba(246,241,232,0.08)]">
        {item.resultOutcome}
      </span>
    </div>
  </div>

  <!-- Footer Strip: Technologies & Actions -->
  <div class="mt-5 pt-4 border-t border-[rgba(246,241,232,0.08)] flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex flex-wrap items-center gap-1.5">
      {item.technologies.slice(0, 4).map((tech) => (
        <span class="rounded bg-[rgba(255,255,255,0.04)] border border-[rgba(246,241,232,0.08)] px-2 py-0.5 font-mono text-[11px] text-[#a9b8b1]">
          {tech}
        </span>
      ))}
      {item.technologies.length > 4 && (
        <span class="font-mono text-[10px] text-[#83968e]">
          +{item.technologies.length - 4}
        </span>
      )}
    </div>

    <span class="text-[#7ed8c4] font-semibold text-xs flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Inspect Workbench →
    </span>
  </div>
</article>

<style>
  [data-theme="light"] .lab-card {
    background-color: var(--color-surface-elevated, #ffffff) !important;
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15)) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05);
  }

  [data-theme="light"] .lab-card:hover {
    background-color: #ffffff !important;
    border-color: var(--color-accent, #0d7663) !important;
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.1);
  }

  [data-theme="light"] .lab-card h3 a {
    color: var(--color-text-primary, #141f1c);
  }

  [data-theme="light"] .lab-card p {
    color: var(--color-text-secondary, #465751);
  }
</style>
