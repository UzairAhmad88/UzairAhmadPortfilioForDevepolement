---
import type { Project } from '@/types/project';
import ProjectDNA from '@/components/common/ProjectDNA.astro';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailUrl = `/work/${project.slug}`;
---

<article class="featured-card">
  <ProjectDNA project={project} variant="featured" />

  <div class="card-content-grid">
    <div class="card-main">
      <h3 class="featured-title">
        <a href={detailUrl} class="title-link">{project.title}</a>
      </h3>

      <p class="featured-description">
        {project.problem}
      </p>

      {project.solution && (
        <p class="featured-solution">
          <strong>Engineering Approach:</strong> {project.solution}
        </p>
      )}

      <div class="card-action-row">
        <a href={detailUrl} class="btn-primary">
          Inspect Case Study →
        </a>
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            View Source Code on GitHub ↗
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .featured-card {
    background: linear-gradient(135deg, rgba(16, 26, 23, 0.92), rgba(11, 20, 18, 0.88));
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45), 0 0 32px rgba(126, 216, 196, 0.05);
    margin-bottom: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .featured-title {
    font-size: clamp(1.4rem, 2.5vw + 0.2rem, 2.1rem);
    font-weight: 800;
    line-height: 1.22;
    margin: 0.5rem 0 1rem 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .title-link {
    color: var(--ink, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--teal, #7ed8c4);
  }

  .featured-description {
    font-size: var(--font-size-body, 1rem);
    color: var(--muted, #a9b8b1);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .featured-solution {
    font-size: 0.95rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .featured-solution strong {
    color: var(--ink, #f6f1e8);
  }

  .card-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: var(--teal, #7ed8c4);
    color: #07110f;
    font-weight: 800;
    font-size: 0.95rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    text-align: center;
  }

  .btn-primary:hover {
    background: #9bd8cf;
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(126, 216, 196, 0.4);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--teal, #7ed8c4);
    outline-offset: 2px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--muted, #a9b8b1);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid rgba(246, 241, 232, 0.15);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    text-align: center;
  }

  .btn-secondary:hover {
    color: var(--ink, #f6f1e8);
    border-color: rgba(126, 216, 196, 0.4);
    background: rgba(126, 216, 196, 0.06);
  }

  .btn-secondary:focus-visible {
    outline: 2px solid var(--teal, #7ed8c4);
    outline-offset: 2px;
  }

  [data-theme="light"] .featured-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 16px 40px rgba(20, 31, 28, 0.08);
  }

  [data-theme="light"] .btn-secondary {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border, rgba(20, 31, 28, 0.12));
    color: var(--color-text-primary, #141f1c);
  }

  [data-theme="light"] .btn-secondary:hover {
    background: rgba(13, 118, 99, 0.08);
    border-color: var(--color-accent-teal, #0d7663);
    color: var(--color-accent-teal, #0d7663);
  }

  @media (max-width: 640px) {
    .featured-card {
      padding: 1.5rem 1.25rem;
    }

    .card-action-row {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
    }
  }
</style>
