---
export interface Props {
  badge: 'Exploring' | 'Experimenting' | 'Building';
  title: string;
  inquiry: string;
  methods: string[];
  statusNote?: string;
  githubUrl?: string;
}

const { badge, title, inquiry, methods, statusNote, githubUrl } = Astro.props;

const badgeColors = {
  Exploring: 'badge-exploring',
  Experimenting: 'badge-experimenting',
  Building: 'badge-building',
};
---

<article class="inquiry-card">
  <div class="inquiry-header">
    <span class:list={['inquiry-badge', badgeColors[badge]]}>{badge}</span>
  </div>

  <h3 class="inquiry-title">{title}</h3>

  <div class="inquiry-body">
    <p class="inquiry-question">
      <strong>Core Inquiry:</strong> {inquiry}
    </p>

    <div class="methods-section">
      <span class="methods-label">Methods & Toolkit:</span>
      <ul class="methods-list">
        {methods.map((method) => (
          <li class="method-tag">{method}</li>
        ))}
      </ul>
    </div>

    {statusNote && (
      <p class="status-note">
        <em>Status:</em> {statusNote}
      </p>
    )}
  </div>

  {githubUrl && (
    <div class="inquiry-footer">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="repo-link">
        View Research Artifacts on GitHub ↗
      </a>
    </div>
  )}
</article>

<style>
  .inquiry-card {
    background: rgba(16, 26, 23, 0.8);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .inquiry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(126, 216, 196, 0.4);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .inquiry-header {
    margin-bottom: 1rem;
  }

  .inquiry-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
  }

  .badge-exploring {
    background: rgba(189, 166, 255, 0.15);
    color: #bda6ff;
    border: 1px solid rgba(189, 166, 255, 0.3);
  }

  .badge-experimenting {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .badge-building {
    background: rgba(126, 216, 196, 0.15);
    color: #7ed8c4;
    border: 1px solid rgba(126, 216, 196, 0.3);
  }

  .inquiry-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 1rem 0;
  }

  .inquiry-question {
    font-size: 0.95rem;
    color: var(--muted, #a9b8b1);
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }

  .inquiry-question strong {
    color: var(--teal, #7ed8c4);
  }

  .methods-section {
    margin-bottom: 1.25rem;
  }

  .methods-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted, #a9b8b1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .methods-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .method-tag {
    font-size: 0.75rem;
    color: var(--muted, #a9b8b1);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
  }

  .status-note {
    font-size: 0.85rem;
    color: var(--muted, #a9b8b1);
    margin: 0;
  }

  .inquiry-footer {
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.1);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--teal, #7ed8c4);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .repo-link:hover,
  .repo-link:focus-visible {
    color: #9bd8cf;
    text-decoration: underline;
  }
</style>
