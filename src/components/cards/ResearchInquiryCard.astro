---
import type { ResearchItem } from '@/types/research';

export interface Props {
  item?: ResearchItem;
  badge?: 'Exploring' | 'Experimenting' | 'Building' | 'Completed';
  title?: string;
  slug?: string;
  inquiry?: string;
  question?: string;
  methods?: string[];
  statusNote?: string;
  githubUrl?: string;
  domain?: string;
  technologies?: string[];
  relatedProjects?: string[];
}

const props = Astro.props;

// Normalizing props whether passed as full `item` or individual fields
const badge = props.item?.badge || props.badge || 'Exploring';
const title = props.item?.title || props.title || '';
const slug = props.item?.slug || props.slug || '';
const question = props.item?.question || props.question || props.inquiry || '';
const methods = props.item?.methodology || props.methods || [];
const domain = props.item?.domain || props.domain;
const technologies = props.item?.technologies || props.technologies || [];
const relatedProjects = props.item?.relatedProjects || props.relatedProjects || [];
const githubUrl = props.item?.githubUrl || props.githubUrl;
const statusNote = props.statusNote;

const badgeColors: Record<string, string> = {
  Exploring: 'badge-exploring',
  Experimenting: 'badge-experimenting',
  Building: 'badge-building',
  Completed: 'badge-completed',
};
---

<article class="inquiry-card">
  <div class="inquiry-header">
    <div class="badge-group">
      {domain && <span class="domain-tag">{domain}</span>}
      <span class:list={['inquiry-badge', badgeColors[badge] || 'badge-exploring']}>{badge}</span>
    </div>
    {slug && <span class="inq-id">INQ // {slug}</span>}
  </div>

  <h3 class="inquiry-title">
    {slug ? (
      <a href={`/research/${slug}`} class="title-link">
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  <div class="inquiry-body">
    <div class="question-box">
      <span class="question-label">Research Question</span>
      <p class="inquiry-question">
        "{question}"
      </p>
    </div>

    {technologies.length > 0 ? (
      <div class="methods-section">
        <span class="methods-label">Technologies:</span>
        <ul class="methods-list">
          {technologies.map((tech) => (
            <li class="method-tag">
              <a href={`/technology/${tech}`} class="tech-link">
                {tech}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : methods.length > 0 ? (
      <div class="methods-section">
        <span class="methods-label">Methods & Toolkit:</span>
        <ul class="methods-list">
          {methods.map((method) => (
            <li class="method-tag static-tag">{method}</li>
          ))}
        </ul>
      </div>
    ) : null}

    {relatedProjects.length > 0 && (
      <div class="related-proj-section">
        <span class="methods-label">Related Systems:</span>
        <ul class="methods-list">
          {relatedProjects.map((projSlug) => (
            <li class="method-tag">
              <a href={`/projects/${projSlug}`} class="tech-link">
                {projSlug}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {statusNote && (
      <p class="status-note">
        <em>Status:</em> {statusNote}
      </p>
    )}
  </div>

  <div class="inquiry-footer">
    {slug && (
      <a href={`/research/${slug}`} class="detail-link">
        Inspect Methodology & Evidence →
      </a>
    )}
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="repo-link">
        GitHub Artifacts ↗
      </a>
    )}
  </div>
</article>

<style>
  .inquiry-card {
    background: rgba(16, 26, 23, 0.8);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .inquiry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(126, 216, 196, 0.4);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .inquiry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .domain-tag {
    font-size: 0.725rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
  }

  .inq-id {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: #83968e;
  }

  .inquiry-badge {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
  }

  .badge-exploring {
    background: rgba(126, 216, 196, 0.08);
    color: #9bd8cf;
    border: 1px solid rgba(126, 216, 196, 0.22);
  }

  .badge-experimenting {
    background: rgba(126, 216, 196, 0.08);
    color: #9bd8cf;
    border: 1px solid rgba(126, 216, 196, 0.22);
  }

  .badge-building {
    background: rgba(126, 216, 196, 0.1);
    color: #7ed8c4;
    border: 1px solid rgba(126, 216, 196, 0.28);
  }

  .badge-completed {
    background: rgba(16, 185, 129, 0.1);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .inquiry-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 1.25rem 0;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .question-box {
    background: rgba(0, 0, 0, 0.25);
    border-left: 3px solid var(--color-accent, #7ed8c4);
    padding: 0.85rem 1rem;
    border-radius: 0 0.375rem 0.375rem 0;
    margin-bottom: 1.25rem;
  }

  .question-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, monospace);
  }

  .inquiry-question {
    font-size: 0.95rem;
    color: var(--ink, #f6f1e8);
    line-height: 1.55;
    margin: 0;
    font-style: italic;
  }

  .methods-section,
  .related-proj-section {
    margin-bottom: 1.25rem;
  }

  .methods-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted, #a9b8b1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono, monospace);
  }

  .methods-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .method-tag {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.25rem;
  }

  .static-tag {
    display: block;
    padding: 0.2rem 0.5rem;
    color: var(--muted, #a9b8b1);
  }

  .tech-link {
    display: block;
    padding: 0.2rem 0.5rem;
    color: var(--muted, #a9b8b1);
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .tech-link:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .status-note {
    font-size: 0.85rem;
    color: var(--muted, #a9b8b1);
    margin: 0;
  }

  .inquiry-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgba(246, 241, 232, 0.1);
  }

  .detail-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    color: #9bd8cf;
    text-decoration: underline;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min, 44px);
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--muted, #a9b8b1);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .repo-link:hover,
  .repo-link:focus-visible {
    color: var(--color-text, #f6f1e8);
    text-decoration: underline;
  }

  :global(html[data-theme="light"]) .inquiry-card,
  :global([data-theme="light"]) .inquiry-card {
    background: #ffffff !important;
    border: 1px solid rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .inquiry-card:hover,
  :global([data-theme="light"]) .inquiry-card:hover {
    border-color: #0d7663 !important;
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.09) !important;
  }

  :global(html[data-theme="light"]) .inquiry-title,
  :global([data-theme="light"]) .inquiry-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .title-link:hover,
  :global([data-theme="light"]) .title-link:hover {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .question-box,
  :global([data-theme="light"]) .question-box {
    background: rgba(13, 118, 99, 0.06) !important;
    border-left-color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .question-label,
  :global([data-theme="light"]) .question-label {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .inquiry-question,
  :global([data-theme="light"]) .inquiry-question {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .inquiry-description,
  :global([data-theme="light"]) .inquiry-description,
  :global(html[data-theme="light"]) .inquiry-finding,
  :global([data-theme="light"]) .inquiry-finding {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .detail-link,
  :global([data-theme="light"]) .detail-link {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .detail-link:hover,
  :global([data-theme="light"]) .detail-link:hover {
    color: #09594b !important;
  }

  :global(html[data-theme="light"]) .repo-link,
  :global([data-theme="light"]) .repo-link {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .repo-link:hover,
  :global([data-theme="light"]) .repo-link:hover {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .method-tag,
  :global([data-theme="light"]) .method-tag {
    background: rgba(20, 31, 28, 0.04) !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    color: #35453f !important;
  }
</style>
