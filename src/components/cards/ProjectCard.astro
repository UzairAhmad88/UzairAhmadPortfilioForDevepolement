---
import type { Project } from '@/types/project';
import ProjectDNA from '@/components/common/ProjectDNA.astro';

export interface Props {
  project: Project;
  viewMode?: 'grid' | 'compact';
}

const { project, viewMode = 'grid' } = Astro.props;
const categoryString = project.category.join(' ');
const detailUrl = `/work/${project.slug}`;
---

<article class:list={['project-card', `mode-${viewMode}`]} data-category={categoryString}>
  <ProjectDNA project={project} variant="card" />

  <h3 class="project-title">
    <a href={detailUrl} class="title-link">{project.title}</a>
  </h3>

  <p class="project-summary">
    {project.problem}
  </p>

  <div class="card-actions">
    <a href={detailUrl} class="action-link primary">
      Inspect Case Study →
    </a>
    {project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="action-link secondary">
        GitHub ↗
      </a>
    )}
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="action-link secondary">
        Live Demo ↗
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-card, 1.5rem);
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(126, 216, 196, 0.35);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35), 0 0 24px rgba(126, 216, 196, 0.06);
  }

  .project-title {
    font-size: clamp(1.15rem, 1.5vw, 1.3rem);
    font-weight: 700;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.35;
  }

  .title-link {
    color: var(--ink, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--teal, #7ed8c4);
  }

  .project-summary {
    color: var(--muted, #a9b8b1);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease;
    white-space: nowrap;
  }

  .action-link.primary {
    color: var(--teal, #7ed8c4);
  }

  .action-link.primary:hover {
    color: #9bd8cf;
    text-decoration: underline;
  }

  .action-link.secondary {
    color: var(--muted, #a9b8b1);
  }

  .action-link.secondary:hover {
    color: var(--ink, #f6f1e8);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none !important;
    }
  }
</style>
