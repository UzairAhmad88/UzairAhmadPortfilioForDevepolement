---
import type { Project } from '@/types/project';
import ProjectDNA from '@/components/common/ProjectDNA.astro';

export interface Props {
  project: Project;
  viewMode?: 'grid' | 'compact';
}

const { project, viewMode = 'grid' } = Astro.props;
const categoryString = project.category.join(' ');
const detailUrl = `/work/${project.slug}`;
---

<article class:list={['project-card', `mode-${viewMode}`]} data-category={categoryString}>
  <ProjectDNA project={project} variant="card" />

  <h3 class="project-title">
    <a href={detailUrl} class="title-link">{project.title}</a>
  </h3>

  <p class="project-summary">
    {project.problem}
  </p>

  <div class="card-actions">
    <a href={detailUrl} class="card-action-btn primary">
      Inspect Case Study →
    </a>
    {project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="card-action-btn secondary">
        GitHub ↗
      </a>
    )}
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="card-action-btn secondary">
        Live Demo ↗
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-card, 1.5rem);
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.09));
    border-radius: var(--radius-lg, 0.75rem);
    transition: transform var(--motion-duration-normal) var(--motion-ease-standard), border-color var(--motion-duration-normal) var(--motion-ease-standard), box-shadow var(--motion-duration-normal) var(--motion-ease-standard);
  }

  .project-card:hover {
    transform: translateY(calc(-1 * var(--motion-distance-sm)));
    border-color: var(--color-accent-muted, rgba(126, 216, 196, 0.35));
    box-shadow: var(--shadow-card, 0 16px 40px rgba(0, 0, 0, 0.35));
  }

  .project-title {
    font-size: clamp(1.15rem, 1.5vw, 1.3rem);
    font-weight: 700;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.35;
  }

  .title-link {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .project-summary {
    color: var(--color-text-secondary, #a9b8b1);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .card-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .card-action-btn.primary {
    background: var(--color-accent, #7ed8c4);
    color: #07110f !important;
    border: 1px solid var(--color-accent, #7ed8c4);
  }

  .card-action-btn.primary:hover {
    background: var(--color-accent-hover, #9bd8cf);
    border-color: var(--color-accent-hover, #9bd8cf);
    color: #07110f !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(126, 216, 196, 0.25);
  }

  .card-action-btn.secondary {
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.12));
    color: var(--color-text-primary, #f6f1e8);
  }

  .card-action-btn.secondary:hover {
    background: var(--color-accent-muted, rgba(126, 216, 196, 0.1));
    border-color: var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .project-card,
  :global([data-theme="light"]) .project-card {
    background: #ffffff !important;
    border: 1px solid rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .project-card:hover,
  :global([data-theme="light"]) .project-card:hover {
    border-color: #0d7663 !important;
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.09) !important;
  }

  :global(html[data-theme="light"]) .title-link,
  :global([data-theme="light"]) .title-link {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .title-link:hover,
  :global([data-theme="light"]) .title-link:hover {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .project-summary,
  :global([data-theme="light"]) .project-summary {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .card-action-btn.secondary,
  :global([data-theme="light"]) .card-action-btn.secondary {
    background: rgba(20, 31, 28, 0.04) !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .card-action-btn.secondary:hover,
  :global([data-theme="light"]) .card-action-btn.secondary:hover {
    background: rgba(13, 118, 99, 0.08) !important;
    border-color: #0d7663 !important;
    color: #0d7663 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
