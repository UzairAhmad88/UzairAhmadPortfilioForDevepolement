---
import type { Project } from '@/types/project';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const categoryString = project.category.join(' ');
const detailUrl = `/work/${project.slug}`;
const domainLabel = project.domain || project.projectType || 'Engineering';
const techList = project.technologies?.slice(0, 4) || [];
---

<article class="simple-project-card" data-category={categoryString}>
  <div class="card-header">
    <span class="domain-tag">{domainLabel}</span>
    {project.status === 'completed' && <span class="status-pill completed">Completed</span>}
    {project.status === 'active' && <span class="status-pill active">Active</span>}
    {project.status === 'academic' && <span class="status-pill academic">Academic</span>}
  </div>

  <h3 class="project-title">
    <a href={detailUrl} class="title-link">{project.title}</a>
  </h3>

  <p class="project-description">
    {project.shortDescription || project.problem}
  </p>

  {techList.length > 0 && (
    <div class="tech-stack" aria-label="Technologies used">
      {techList.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>
  )}

  <div class="card-footer">
    <a href={detailUrl} class="view-link">
      View Project →
    </a>
    <div class="external-links">
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link" aria-label={`${project.title} source code on GitHub`}>
          GitHub ↗
        </a>
      )}
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="ext-link" aria-label={`${project.title} live demo on Vercel`}>
          Live Demo ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .simple-project-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    border-radius: var(--radius-lg, 10px);
    transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
  }

  .simple-project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent, #7ed8c4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  :global(html[data-theme="light"]) .simple-project-card,
  :global([data-theme="light"]) .simple-project-card {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  :global(html[data-theme="light"]) .simple-project-card:hover,
  :global([data-theme="light"]) .simple-project-card:hover {
    border-color: #0d7663;
    box-shadow: 0 12px 30px rgba(20, 31, 28, 0.08);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .domain-tag {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .domain-tag,
  :global([data-theme="light"]) .domain-tag {
    color: #0d7663;
  }

  .status-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary, #a9b8b1);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.1));
  }

  .status-pill.completed {
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.3);
    background: rgba(126, 216, 196, 0.08);
  }

  :global(html[data-theme="light"]) .status-pill.completed,
  :global([data-theme="light"]) .status-pill.completed {
    color: #0d7663;
    border-color: rgba(13, 118, 99, 0.25);
    background: rgba(13, 118, 99, 0.08);
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  .title-link {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  :global(html[data-theme="light"]) .title-link,
  :global([data-theme="light"]) .title-link {
    color: #141f1c;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .title-link:hover,
  :global([data-theme="light"]) .title-link:hover {
    color: #0d7663;
  }

  .project-description {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  :global(html[data-theme="light"]) .project-description,
  :global([data-theme="light"]) .project-description {
    color: #4a5c55;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tech-tag {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 4px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .tech-tag,
  :global([data-theme="light"]) .tech-tag {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.08);
    color: #4a5c55;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  :global(html[data-theme="light"]) .card-footer,
  :global([data-theme="light"]) .card-footer {
    border-top-color: rgba(20, 31, 28, 0.08);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    transition: color 150ms ease, transform 150ms ease;
  }

  :global(html[data-theme="light"]) .view-link,
  :global([data-theme="light"]) .view-link {
    color: #0d7663;
  }

  .view-link:hover,
  .view-link:focus-visible {
    transform: translateX(2px);
  }

  .external-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ext-link {
    font-size: 0.82rem;
    color: var(--color-text-muted, #73847b);
    text-decoration: none;
    transition: color 150ms ease;
  }

  :global(html[data-theme="light"]) .ext-link,
  :global([data-theme="light"]) .ext-link {
    color: #6a7c75;
  }

  .ext-link:hover,
  .ext-link:focus-visible {
    color: var(--color-text-primary, #f6f1e8);
  }

  :global(html[data-theme="light"]) .ext-link:hover,
  :global([data-theme="light"]) .ext-link:hover {
    color: #141f1c;
  }
</style>
