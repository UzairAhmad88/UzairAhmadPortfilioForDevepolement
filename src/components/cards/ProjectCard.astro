---
import type { Project } from '@/types/project';
import ProjectDNA from '@/components/common/ProjectDNA.astro';

export interface Props {
  project: Project;
  viewMode?: 'grid' | 'compact';
}

const { project, viewMode = 'grid' } = Astro.props;
const categoryString = project.category.join(' ');
const detailUrl = `/work/${project.slug}`;
---

<article class:list={['project-card', `mode-${viewMode}`]} data-category={categoryString}>
  <ProjectDNA project={project} variant="card" />

  <h3 class="project-title">
    <a href={detailUrl} class="title-link">{project.title}</a>
  </h3>

  <p class="project-summary">
    {project.problem}
  </p>

  <div class="card-actions">
    <a href={detailUrl} class="action-link primary">
      Inspect Case Study →
    </a>
    {project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="action-link secondary">
        GitHub ↗
      </a>
    )}
    {project.liveUrl && (
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="action-link secondary">
        Live Demo ↗
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-card, 1.5rem);
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.09));
    border-radius: var(--radius-lg, 0.75rem);
    transition: transform var(--motion-duration-normal) var(--motion-ease-standard), border-color var(--motion-duration-normal) var(--motion-ease-standard), box-shadow var(--motion-duration-normal) var(--motion-ease-standard);
  }

  .project-card:hover {
    transform: translateY(calc(-1 * var(--motion-distance-sm)));
    border-color: var(--color-accent-muted, rgba(126, 216, 196, 0.35));
    box-shadow: var(--shadow-card, 0 16px 40px rgba(0, 0, 0, 0.35));
  }

  .project-title {
    font-size: clamp(1.15rem, 1.5vw, 1.3rem);
    font-weight: 700;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.35;
  }

  .title-link {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .project-summary {
    color: var(--color-text-secondary, #a9b8b1);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
    white-space: nowrap;
  }

  .action-link.primary {
    color: var(--color-accent, #7ed8c4);
  }

  .action-link.primary:hover {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  .action-link.secondary {
    color: var(--color-text-secondary, #a9b8b1);
  }

  .action-link.secondary:hover {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: underline;
  }

  [data-theme="light"] .project-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05);
  }

  [data-theme="light"] .project-card:hover {
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
