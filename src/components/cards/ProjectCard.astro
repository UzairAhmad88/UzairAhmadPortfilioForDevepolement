---
import type { Project } from '@/types/project';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const categoryString = project.category.join(' ');
---

<article class="project-card reveal" data-category={categoryString}>
  <span class="project-type">{project.projectType}</span>
  <h3>{project.title}</h3>

  {
    project.problem && (
      <p>
        <strong>
          {project.category.includes('quant') && project.slug.includes('regime') ? 'Research:' : 'Problem:'}
        </strong>{' '}
        {project.problem}
      </p>
    )
  }

  {
    project.system && (
      <p>
        <strong>System:</strong> {project.system}
      </p>
    )
  }

  {
    project.product && (
      <p>
        <strong>Product:</strong> {project.product}
      </p>
    )
  }

  {
    project.outcome && (
      <p>
        <strong>Outcome:</strong> {project.outcome}
      </p>
    )
  }

  {
    project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noreferrer">
        View repository
      </a>
    )
  }
</article>

<style>
  .project-card {
    min-height: 290px;
    padding: 1.3rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.035)),
      rgba(255, 255, 255, 0.03);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.18);
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
    transform-style: preserve-3d;
  }

  .project-card:hover {
    transform: translateY(-6px) rotateX(var(--tilt-y, 0deg)) rotateY(var(--tilt-x, 0deg));
    border-color: rgba(14, 124, 102, 0.42);
    background:
      linear-gradient(180deg, rgba(126, 216, 196, 0.1), rgba(255, 255, 255, 0.045)),
      rgba(255, 255, 255, 0.045);
  }

  .project-type {
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .project-card h3 {
    margin: 1rem 0 0.75rem;
  }

  .project-card p {
    color: var(--muted);
    line-height: 1.65;
  }

  .project-card a {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--deep);
    font-weight: 800;
  }

  :global(.project-card.hidden-project) {
    display: none !important;
  }
</style>
