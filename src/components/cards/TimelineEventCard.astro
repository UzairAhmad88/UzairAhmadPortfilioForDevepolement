---
import type { TimelineEvent } from '@/types/timeline';

interface Props {
  event: TimelineEvent;
}

const { event } = Astro.props;

const typeLabels: Record<string, string> = {
  project: 'PROJECT',
  research: 'RESEARCH',
  lab: 'LAB EXPERIMENT',
  note: 'ENGINEERING NOTE',
  technology: 'TECHNOLOGY',
  milestone: 'MILESTONE',
  methodology: 'METHODOLOGY',
};

const typeClass = `type-${event.type}`;
const isArchived = event.archiveState && event.archiveState !== 'active';
---

<article class={`timeline-event-card ${typeClass} ${isArchived ? 'is-archived' : ''}`} id={event.id}>
  <div class="event-meta-header">
    <div class="meta-left">
      <span class="type-pill">{typeLabels[event.type] || event.type.toUpperCase()}</span>
      {event.status && event.status !== 'completed' && event.status !== 'active' && (
        <span class={`status-pill status-${event.status}`}>
          {event.status.toUpperCase()}
        </span>
      )}
    </div>
    <time class="event-date" datetime={event.date}>
      {event.dateDisplay}
    </time>
  </div>

  <div class="event-content">
    {event.tagline && <p class="event-tagline">{event.tagline}</p>}
    <h3 class="event-title">
      {event.entityHref ? (
        <a href={event.entityHref} class="event-link">
          {event.title}
        </a>
      ) : (
        event.title
      )}
    </h3>
    
    <p class="event-desc">{event.description}</p>

    {event.takeaway && (
      <div class="event-takeaway">
        <span class="takeaway-label">Insight / Takeaway:</span>
        <p class="takeaway-text">{event.takeaway}</p>
      </div>
    )}

    {event.successorProjectId && (
      <div class="evolution-link-box">
        <span class="evolution-label">Evolutionary Path:</span>
        <p class="evolution-text">
          Superseded by <a href={`/work/${event.successorProjectId}`}>{event.successorProjectTitle || event.successorProjectId} →</a>
        </p>
      </div>
    )}

    {event.predecessorProjectId && (
      <div class="evolution-link-box precursor">
        <span class="evolution-label">Lineage:</span>
        <p class="evolution-text">
          Evolved from <a href={`/work/${event.predecessorProjectId}`}>{event.predecessorProjectTitle || event.predecessorProjectId} →</a>
        </p>
      </div>
    )}

    <div class="event-footer">
      {event.technologies && event.technologies.length > 0 && (
        <div class="tech-tags">
          {event.technologies.slice(0, 5).map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
          {event.technologies.length > 5 && (
            <span class="tech-tag more">+{event.technologies.length - 5}</span>
          )}
        </div>
      )}

      {event.entityHref && (
        <a href={event.entityHref} class="action-link" aria-label={`Explore ${event.title}`}>
          {event.type === 'project' ? 'Explore Case Study' : event.type === 'research' ? 'Read Research' : event.type === 'lab' ? 'Inspect Experiment' : 'Read Note'} →
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .timeline-event-card {
    position: relative;
    background: var(--color-background-subtle, #101a17);
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.1));
    border-radius: var(--radius-md, 8px);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform var(--transition-fast, 150ms ease), border-color var(--transition-fast, 150ms ease), box-shadow var(--transition-fast, 150ms ease);
  }

  .timeline-event-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.35);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .timeline-event-card.is-archived {
    opacity: 0.92;
    border-style: dashed;
    border-color: rgba(246, 241, 232, 0.15);
  }

  .timeline-event-card.type-research {
    border-left: 3px solid #bda6ff;
  }

  .timeline-event-card.type-lab {
    border-left: 3px solid #7ed8c4;
  }

  .timeline-event-card.type-project {
    border-left: 3px solid #d2a071;
  }

  .timeline-event-card.type-note {
    border-left: 3px solid #83968e;
  }

  .event-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .type-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-accent-teal, #7ed8c4);
    background: rgba(126, 216, 196, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 4px);
    border: 1px solid rgba(126, 216, 196, 0.2);
  }

  .timeline-event-card.type-research .type-pill {
    color: #bda6ff;
    background: rgba(189, 166, 255, 0.08);
    border-color: rgba(189, 166, 255, 0.25);
  }

  .timeline-event-card.type-project .type-pill {
    color: #d2a071;
    background: rgba(210, 160, 113, 0.08);
    border-color: rgba(210, 160, 113, 0.25);
  }

  .timeline-event-card.type-note .type-pill {
    color: #a9b8b1;
    background: rgba(246, 241, 232, 0.05);
    border-color: rgba(246, 241, 232, 0.12);
  }

  .status-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.675rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    border: 1px solid;
  }

  .status-superseded {
    color: #d2a071;
    background: rgba(210, 160, 113, 0.1);
    border-color: rgba(210, 160, 113, 0.3);
  }

  .status-legacy {
    color: #a9b8b1;
    background: rgba(169, 184, 177, 0.1);
    border-color: rgba(169, 184, 177, 0.25);
  }

  .status-archived {
    color: #83968e;
    background: rgba(131, 150, 142, 0.1);
    border-color: rgba(131, 150, 142, 0.25);
  }

  .status-in-progress {
    color: #7ed8c4;
    background: rgba(126, 216, 196, 0.1);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .event-date {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--color-text-muted, #83968e);
    letter-spacing: 0.04em;
  }

  .event-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-tagline {
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    color: var(--color-text-muted, #83968e);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .event-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    margin: 0;
    color: var(--color-text-primary, #f6f1e8);
  }

  .event-link {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color var(--transition-fast, 150ms ease);
  }

  .event-link:hover,
  .event-link:focus-visible {
    color: var(--color-accent-teal, #7ed8c4);
    text-decoration: underline;
  }

  .event-desc {
    font-size: 0.925rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.6;
    margin: 0;
  }

  .event-takeaway {
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid var(--color-accent-teal, #7ed8c4);
    padding: 0.6rem 0.85rem;
    border-radius: 0 var(--radius-sm, 4px) var(--radius-sm, 4px) 0;
  }

  .takeaway-label {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent-teal, #7ed8c4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.2rem;
  }

  .takeaway-text {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.45;
    margin: 0;
  }

  .evolution-link-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(210, 160, 113, 0.08);
    border: 1px solid rgba(210, 160, 113, 0.2);
    border-radius: var(--radius-sm, 4px);
    font-size: 0.825rem;
  }

  .evolution-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 800;
    color: #d2a071;
    text-transform: uppercase;
  }

  .evolution-text {
    margin: 0;
    color: var(--color-text-secondary, #a9b8b1);
  }

  .evolution-text a {
    color: var(--color-text-primary, #f6f1e8);
    font-weight: 700;
    text-decoration: none;
  }

  .evolution-text a:hover {
    color: var(--color-accent-teal, #7ed8c4);
    text-decoration: underline;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    color: var(--color-text-muted, #a9b8b1);
    background: rgba(246, 241, 232, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .tech-tag.more {
    color: var(--color-accent-teal, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.2);
  }

  .action-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent-teal, #7ed8c4);
    text-decoration: none;
    transition: color var(--transition-fast, 150ms ease);
    margin-left: auto;
  }

  .action-link:hover,
  .action-link:focus-visible {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .event-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .action-link {
      margin-left: 0;
    }
  }
</style>
