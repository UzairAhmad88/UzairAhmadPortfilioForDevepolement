---
import type { DiscoveryItem } from '@/types/discovery';

export interface Props {
  item: DiscoveryItem;
}

const { item } = Astro.props;

const typeMetadata: Record<string, { label: string; icon: string; tagClass: string }> = {
  project: { label: 'Project', icon: '⚡', tagClass: 'tag-project' },
  research: { label: 'Research', icon: '🔬', tagClass: 'tag-research' },
  lab: { label: 'Lab Experiment', icon: '🧪', tagClass: 'tag-lab' },
  note: { label: 'Engineering Note', icon: '📝', tagClass: 'tag-note' },
  technology: { label: 'Technology', icon: '🛠️', tagClass: 'tag-technology' },
  methodology: { label: 'Methodology', icon: '📐', tagClass: 'tag-methodology' },
};

const meta = typeMetadata[item.type] || {
  label: item.type,
  icon: '•',
  tagClass: 'tag-default',
};
---

<article
  class="discovery-result-card"
  data-item-id={item.id}
  data-item-type={item.type}
  data-item-techs={item.technologies.join(',')}
  data-item-topics={item.topics.join(',')}
  data-item-status={item.status || ''}
  data-item-year={item.year || ''}
>
  <div class="card-body">
    <!-- Top Metadata Strip -->
    <div class="card-meta-row">
      <div class="meta-left">
        <span class:list={['type-badge', meta.tagClass]}>
          <span class="type-icon">{meta.icon}</span>
          <span>{meta.label}</span>
        </span>
        {item.badge && item.badge !== meta.label && (
          <span class="custom-badge">{item.badge}</span>
        )}
      </div>

      <div class="meta-right">
        {item.year && <span class="meta-year">{item.year}</span>}
        {item.relatedIds.length > 0 && (
          <span class="meta-connections" title="Connected entities in Knowledge Graph">
            {item.relatedIds.length} connected
          </span>
        )}
      </div>
    </div>

    <!-- Title & Canonical Link -->
    <h3 class="card-title">
      <a href={item.href} class="title-link">
        {item.title}
      </a>
    </h3>

    <!-- Excerpt / Short Description -->
    {item.excerpt && (
      <p class="card-excerpt">
        {item.excerpt}
      </p>
    )}

    <!-- Technology & Topic Chips -->
    <div class="chips-container">
      {item.technologies.slice(0, 4).map((tech) => (
        <a href={`/technology/${tech}`} class="tech-chip">
          {tech}
        </a>
      ))}
      {item.topics.slice(0, 2).map((topic) => (
        <span class="topic-chip">
          {topic}
        </span>
      ))}
    </div>
  </div>

  <!-- Card Action Footer -->
  <div class="card-footer">
    <a
      href={`/knowledge?focus=${item.id}`}
      class="graph-link"
      title="Inspect relationships in Knowledge Graph"
    >
      <span>Graph Connections</span>
      <span aria-hidden="true">↗</span>
    </a>

    <a href={item.href} class="view-link">
      <span>View {meta.label}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .discovery-result-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
  }

  .discovery-result-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.35);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
  }

  .tag-project {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .tag-research {
    background: rgba(126, 216, 196, 0.15);
    color: #7ed8c4;
    border-color: rgba(126, 216, 196, 0.35);
  }

  .tag-lab {
    background: rgba(126, 216, 196, 0.12);
    color: #9bd8cf;
    border-color: rgba(126, 216, 196, 0.28);
  }

  .tag-note {
    background: rgba(126, 216, 196, 0.08);
    color: #7ed8c4;
    border-color: rgba(126, 216, 196, 0.22);
  }

  .tag-technology {
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    border-color: rgba(246, 241, 232, 0.12);
  }

  .tag-methodology,
  .tag-default {
    background: rgba(255, 255, 255, 0.05);
    color: #a9b8b1;
    border-color: rgba(246, 241, 232, 0.09);
  }

  .type-icon {
    font-size: 0.8rem;
  }

  .custom-badge {
    color: #83968e;
    font-size: 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #83968e;
    font-size: 0.7rem;
  }

  .meta-connections {
    color: var(--color-accent, #7ed8c4);
    font-weight: 600;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
  }

  .title-link {
    color: var(--color-text, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .title-link:hover,
  .title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .card-excerpt {
    font-size: 0.85rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .tech-chip {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    color: var(--color-text-muted, #a9b8b1);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .tech-chip:hover {
    color: var(--color-accent, #7ed8c4);
    border-color: rgba(126, 216, 196, 0.3);
  }

  .topic-chip {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(246, 241, 232, 0.05);
    color: #83968e;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
  }

  .graph-link {
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    font-weight: 600;
  }

  .graph-link:hover {
    text-decoration: underline;
  }

  .view-link {
    color: var(--color-text-muted, #a9b8b1);
    text-decoration: none;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .view-link:hover {
    color: var(--color-text, #f6f1e8);
  }

  [data-theme="light"] .discovery-result-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  [data-theme="light"] .discovery-result-card:hover {
    border-color: var(--color-accent, #0d7663);
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.08);
  }

  [data-theme="light"] .title-link {
    color: var(--color-text-primary, #141f1c);
  }

  [data-theme="light"] .card-excerpt {
    color: var(--color-text-secondary, #465751);
  }

  [data-theme="light"] .tech-chip,
  [data-theme="light"] .topic-chip {
    background: rgba(20, 31, 28, 0.04);
    border-color: rgba(20, 31, 28, 0.08);
    color: #465751;
  }

  [data-theme="light"] .meta-connections,
  [data-theme="light"] .graph-link {
    color: var(--color-accent, #0d7663);
  }
</style>
