---
import type { Project } from '@/types/project';
import { getArchiveStateBadge, getArchiveReasonText } from '@/lib/archive';
import { getTechnologyById } from '@/data/technologies';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const archive = project.archive;
const stateBadge = getArchiveStateBadge(archive?.state);
const reasonText = getArchiveReasonText(archive?.reason);
const yearDisplay = archive?.originalYear || (project.publishedAt ? new Date(project.publishedAt).getFullYear().toString() : 'Historical');
---


<article class="archive-card" data-state={archive?.state || 'archived'} data-category={(project.category || []).join(' ')}>
  <div class="archive-card-header">
    <div class="header-badges">
      <span class:list={['archive-state-badge', stateBadge.badgeClass]} title={reasonText}>
        {stateBadge.label}
      </span>

      <span class="archive-year-badge">
        Originated {yearDisplay}
      </span>
      {archive?.archivedAt && (
        <span class="archived-date-badge">
          Archived {archive.archivedAt}
        </span>
      )}
    </div>
    <span class="archive-domain-badge">{project.domain || project.projectType}</span>
  </div>

  <div class="archive-card-body">
    <h3 class="archive-title">
      <a href={`/work/${project.slug}`} class="archive-title-link">
        {project.title}
      </a>
    </h3>

    <p class="archive-excerpt">
      {project.shortDescription || project.problem}
    </p>

    {archive?.archiveNote && (
      <div class="archive-context-box">
        <span class="context-label">Historical Context & Retrospective:</span>
        <p class="context-text">{archive.archiveNote}</p>
      </div>
    )}

    {archive?.successorProjectId && (
      <div class="successor-banner">
        <span class="successor-icon" aria-hidden="true">↳</span>
        <span class="successor-label">Superseded by:</span>
        <a href={`/work/${archive.successorProjectId}`} class="successor-link">
          {archive.successorProjectTitle || archive.successorProjectId} →
        </a>
      </div>
    )}

    {project.technologies && project.technologies.length > 0 && (
      <ul class="archive-tech-list" aria-label="Technologies used in this historical system">
        {project.technologies.map((tech) => {
          const techEntity = getTechnologyById(tech);
          return techEntity ? (
            <li class="archive-tech-pill">
              <a href={`/technology/${techEntity.id}`} class="archive-tech-link">
                {tech}
              </a>
            </li>
          ) : (
            <li class="archive-tech-pill">{tech}</li>
          );
        })}
      </ul>
    )}
  </div>

  <div class="archive-card-footer">
    <a href={`/work/${project.slug}`} class="view-history-btn">
      View Case Study & History →
    </a>
    {project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="repo-ext-link" aria-label={`View ${project.title} on GitHub`}>
        GitHub ↗
      </a>
    )}
  </div>
</article>

<style>
  .archive-card {
    display: flex;
    flex-direction: column;
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .archive-card:hover {
    border-color: rgba(126, 216, 196, 0.3);
    background: rgba(16, 26, 23, 0.9);
  }

  .archive-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.06);
  }

  .header-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .archive-state-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full, 9999px);
    font-family: var(--font-mono, monospace);
  }

  .badge-superseded {
    background: rgba(189, 166, 255, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(189, 166, 255, 0.3);
  }

  .badge-legacy {
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }

  .badge-archived {
    background: rgba(120, 144, 156, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(120, 144, 156, 0.3);
  }

  .badge-paused, .badge-abandoned {
    background: rgba(210, 160, 113, 0.15);
    color: #d2a071;
    border: 1px solid rgba(210, 160, 113, 0.3);
  }

  .archive-year-badge, .archived-date-badge {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(246, 241, 232, 0.06);
  }

  .archive-domain-badge {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-accent, #7ed8c4);
  }

  .archive-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .archive-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .archive-title-link {
    color: var(--color-text, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .archive-title-link:hover, .archive-title-link:focus-visible {
    color: var(--color-accent, #7ed8c4);
  }

  .archive-excerpt {
    font-size: 0.925rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0;
  }

  .archive-context-box {
    background: rgba(7, 17, 15, 0.6);
    border-left: 3px solid var(--color-accent, #7ed8c4);
    padding: 0.75rem 0.9rem;
    border-radius: 0 0.375rem 0.375rem 0;
  }

  .context-label {
    display: block;
    font-size: 0.675rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 0.25rem;
  }

  .context-text {
    font-size: 0.85rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.5;
    margin: 0;
  }

  .successor-banner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    background: rgba(189, 166, 255, 0.08);
    border: 1px solid rgba(189, 166, 255, 0.2);
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.825rem;
  }

  .successor-icon {
    color: #c4b5fd;
    font-weight: 700;
  }

  .successor-label {
    color: var(--color-text-muted, #83968e);
  }

  .successor-link {
    color: #c4b5fd;
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .successor-link:hover {
    color: #e9d5ff;
    text-decoration: underline;
  }

  .archive-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0 0;
  }

  .archive-tech-pill {
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--color-text-muted, #a9b8b1);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(246, 241, 232, 0.07);
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .archive-tech-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .archive-tech-link:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .archive-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(246, 241, 232, 0.06);
  }

  .view-history-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    min-height: var(--touch-target-min, 44px);
    transition: color 150ms ease;
  }

  .view-history-btn:hover {
    color: #9bd8cf;
    text-decoration: underline;
  }

  .repo-ext-link {
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(246, 241, 232, 0.08);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .repo-ext-link:hover {
    color: var(--color-text, #f6f1e8);
    border-color: rgba(246, 241, 232, 0.25);
  }
</style>
