---
import { knowledgeGraph, getFocusedGraph, getNodeBySlug } from '@/data/knowledgeGraph';
import type { KnowledgeNodeType, KnowledgeNode, KnowledgeEdge } from '@/types/knowledge';

export interface Props {
  nodeId?: string;
  type?: KnowledgeNodeType;
  slug?: string;
  title?: string;
  subtitle?: string;
}

const {
  nodeId,
  type,
  slug,
  title = 'Connected Knowledge & Systems',
  subtitle = 'Deterministic bidirectional relationships across projects, research, experiments, and technical notes.',
} = Astro.props;

let targetNodeId = nodeId;
if (!targetNodeId && type && slug) {
  const foundNode = getNodeBySlug(knowledgeGraph, type, slug);
  if (foundNode) {
    targetNodeId = foundNode.id;
  }
}

const focused = targetNodeId ? getFocusedGraph(knowledgeGraph, targetNodeId, 1) : null;
const grouped = focused?.groupedByType;

const typeLabels: Record<KnowledgeNodeType, { name: string; icon: string }> = {
  project: { name: 'Projects & Systems', icon: '⚡' },
  research: { name: 'Research Inquiries', icon: '🔬' },
  lab: { name: 'Lab Experiments & Prototypes', icon: '🧪' },
  note: { name: 'Engineering Notes', icon: '📝' },
  technology: { name: 'Technologies', icon: '🛠️' },
  methodology: { name: 'Methodology Steps', icon: '📐' },
};

function getEdgeLabel(sourceId: string, targetId: string): string {
  const edge = focused?.directEdges.find(
    (e: KnowledgeEdge) =>
      (e.source === sourceId && e.target === targetId) ||
      (e.source === targetId && e.target === sourceId)
  );
  return edge ? edge.label : 'Related';
}
---

{focused && focused.connectedNodes.length > 0 && (
  <section class="related-knowledge-section" aria-label="Connected Knowledge Network">
    <div class="section-top-bar">
      <div>
        <p class="section-eyebrow">
          Knowledge Graph Layer
        </p>
        <h2 class="section-title">
          {title}
        </h2>
        <p class="section-subtitle">
          {subtitle}
        </p>
      </div>
      <a
        href={`/knowledge?focus=${focused.focusNode.id}`}
        class="explore-graph-btn"
      >
        <span>Explore Graph ({focused.connectedNodes.length} connections)</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="knowledge-groups-grid">
      {(Object.keys(grouped || {}) as KnowledgeNodeType[]).map((groupType) => {
        const nodesInGroup = grouped ? grouped[groupType] : [];
        if (!nodesInGroup || nodesInGroup.length === 0) return null;
        const meta = typeLabels[groupType] || { name: groupType, icon: '•' };

        return (
          <div class="knowledge-group-card">
            <div>
              <div class="group-header">
                <span class="group-icon" aria-hidden="true">{meta.icon}</span>
                <span class="group-name">{meta.name}</span>
                <span class="group-count">({nodesInGroup.length})</span>
              </div>

              <ul class="nodes-list">
                {nodesInGroup.map((node: KnowledgeNode) => {
                  const edgeLabel = getEdgeLabel(focused.focusNode.id, node.id);
                  return (
                    <li class="node-item">
                      <div class="node-meta-row">
                        <span class="edge-label">{edgeLabel}</span>
                        {node.badge && <span class="node-badge-text">{node.badge}</span>}
                      </div>
                      <a href={node.href} class="node-title-link">
                        {node.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-knowledge-section {
    border-top: 1px solid rgba(246, 241, 232, 0.09);
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-top-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .section-top-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin: 0 0 0.35rem 0;
  }

  .section-title {
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .section-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted, #a9b8b1);
    max-width: 650px;
    margin: 0;
    line-height: 1.5;
  }

  .explore-graph-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.4rem 0.85rem;
    border-radius: 0.375rem;
    background: rgba(126, 216, 196, 0.1);
    border: 1px solid rgba(126, 216, 196, 0.3);
    color: var(--color-accent, #7ed8c4);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 150ms ease;
  }

  .explore-graph-btn:hover {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
  }

  .knowledge-groups-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .knowledge-group-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .group-icon {
    font-size: 0.85rem;
  }

  .group-name {
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
  }

  .group-count {
    margin-left: auto;
    color: #83968e;
    font-size: 0.7rem;
  }

  .nodes-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .node-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .node-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
  }

  .edge-label {
    color: var(--color-accent, #7ed8c4);
    font-weight: 600;
  }

  .node-badge-text {
    color: #83968e;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
  }

  .node-title-link {
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .node-title-link:hover {
    color: var(--color-accent, #7ed8c4);
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .knowledge-groups-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .knowledge-groups-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-theme="light"]) .knowledge-group-card,
  :global([data-theme="light"]) .knowledge-group-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  :global(html[data-theme="light"]) .group-name,
  :global([data-theme="light"]) .group-name,
  :global(html[data-theme="light"]) .node-title-link,
  :global([data-theme="light"]) .node-title-link {
    color: var(--color-text-primary, #141f1c);
  }

  :global(html[data-theme="light"]) .explore-graph-btn,
  :global([data-theme="light"]) .explore-graph-btn {
    background: rgba(13, 118, 99, 0.1);
    border-color: rgba(13, 118, 99, 0.3);
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .explore-graph-btn:hover,
  :global([data-theme="light"]) .explore-graph-btn:hover {
    background: #0d7663;
    color: #ffffff;
  }
</style>
