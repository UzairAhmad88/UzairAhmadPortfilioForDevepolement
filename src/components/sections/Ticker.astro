---
import { tickerSkills } from '@/data/skills';
---

<section class="ticker-strip" aria-label="Professional identity">
  <div class="ticker-content">
    {tickerSkills.map((skill) => <span>{skill}</span>)}
    {tickerSkills.map((skill) => <span>{skill}</span>)}
  </div>
</section>

<style>
  .ticker-strip {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.045);
  }

  .ticker-content {
    display: flex;
    gap: 2rem;
    width: max-content;
    padding: 1rem 0;
    animation: marquee 28s linear infinite;
  }

  .ticker-strip span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
