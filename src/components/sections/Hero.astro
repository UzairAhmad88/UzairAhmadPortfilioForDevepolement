---
import { siteConfig } from '@/data/site';
---

<section class="simple-hero">
  <div class="hero-content">
    <div class="status-pill">
      <span class="status-dot"></span>
      <span>Available for select quantitative & engineering work</span>
    </div>

    <h1 class="hero-name">Uzair Ahmad</h1>

    <p class="hero-title">
      Quantitative Finance + Full-Stack Engineer
    </p>

    <p class="hero-lede">
      I build software, data-driven systems, and quantitative research tools.
    </p>

    <div class="currently-strip">
      <span class="strip-label">Focus Areas:</span>
      <span class="strip-item">Quantitative Research</span>
      <span class="strip-sep">·</span>
      <span class="strip-item">Financial Engineering</span>
      <span class="strip-sep">·</span>
      <span class="strip-item">AI / ML</span>
      <span class="strip-sep">·</span>
      <span class="strip-item">Full-Stack Systems</span>
    </div>

    <div class="hero-actions">
      <a href="#work" class="btn primary">
        View Work →
      </a>
      <a href={siteConfig.socialLinks.github.url} target="_blank" rel="noopener noreferrer" class="btn secondary">
        GitHub ↗
      </a>
      <a href="/contact" class="btn ghost">
        Contact
      </a>
    </div>
  </div>
</section>

<style>
  .simple-hero {
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 1.5rem;
  }

  :global(html[data-theme="light"]) .status-pill,
  :global([data-theme="light"]) .status-pill {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent, #7ed8c4);
    box-shadow: 0 0 8px var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .status-dot,
  :global([data-theme="light"]) .status-dot {
    background: #0d7663;
    box-shadow: 0 0 8px rgba(13, 118, 99, 0.4);
  }

  .hero-name {
    font-size: clamp(2.5rem, 5vw + 0.5rem, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.5rem 0;
  }

  :global(html[data-theme="light"]) .hero-name,
  :global([data-theme="light"]) .hero-name {
    color: #141f1c;
  }

  .hero-title {
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-accent, #7ed8c4);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }

  :global(html[data-theme="light"]) .hero-title,
  :global([data-theme="light"]) .hero-title {
    color: #0d7663;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0 0 1.75rem 0;
    max-width: 680px;
  }

  :global(html[data-theme="light"]) .hero-lede,
  :global([data-theme="light"]) .hero-lede {
    color: #4a5c55;
  }

  .currently-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary, #a9b8b1);
    margin-bottom: 2rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    border-radius: var(--radius-md, 8px);
    width: fit-content;
  }

  :global(html[data-theme="light"]) .currently-strip,
  :global([data-theme="light"]) .currently-strip {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.1);
    color: #4a5c55;
  }

  .strip-label {
    font-weight: 700;
    color: var(--color-text-primary, #f6f1e8);
    margin-right: 0.25rem;
  }

  :global(html[data-theme="light"]) .strip-label,
  :global([data-theme="light"]) .strip-label {
    color: #141f1c;
  }

  .strip-sep {
    color: var(--color-text-muted, #73847b);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn.primary {
    background: var(--color-accent, #7ed8c4);
    color: #07110f;
    border: 1px solid var(--color-accent, #7ed8c4);
  }

  .btn.primary:hover {
    background: var(--color-accent-hover, #9bd8cf);
    border-color: var(--color-accent-hover, #9bd8cf);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(126, 216, 196, 0.25);
  }

  .btn.secondary {
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    color: var(--color-accent, #7ed8c4);
  }

  .btn.secondary:hover {
    background: rgba(126, 216, 196, 0.15);
    border-color: var(--color-accent, #7ed8c4);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .btn.secondary,
  :global([data-theme="light"]) .btn.secondary {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }

  .btn.ghost {
    background: transparent;
    border: 1px solid var(--color-border, rgba(246, 241, 232, 0.15));
    color: var(--color-text-primary, #f6f1e8);
  }

  .btn.ghost:hover {
    border-color: var(--color-text-primary, #f6f1e8);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .btn.ghost,
  :global([data-theme="light"]) .btn.ghost {
    border-color: rgba(20, 31, 28, 0.2);
    color: #141f1c;
  }
</style>
