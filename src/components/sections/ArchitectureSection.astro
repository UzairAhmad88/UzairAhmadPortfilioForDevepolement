---
import { buildStages } from '@/data/architecturePipeline';
---

<section id="how-i-build" class="section-shell how-i-build-section">
  <div class="section-heading reveal">
    <p class="eyebrow">Engineering Philosophy</p>
    <h2>How I Build Software & Systems</h2>
    <p class="section-subtitle">
      A disciplined 5-stage lifecycle from mathematical problem formulation to resilient production deployment.
    </p>
  </div>

  <div class="build-lifecycle-container reveal">
    <!-- Stepper Navigation -->
    <div class="stepper-nav" role="tablist" aria-label="Engineering Lifecycle Stages">
      {
        buildStages.map((stage, idx) => (
          <button
            type="button"
            class:list={['stage-tab', { 'active-tab': idx === 0 }]}
            role="tab"
            id={`tab-${stage.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${stage.id}`}
            data-stage-id={stage.id}
          >
            <span class="stage-num">{stage.step}</span>
            <span class="stage-name">{stage.title}</span>
          </button>
        ))
      }
    </div>

    <!-- Interactive Stage Panels -->
    <div class="stage-panels">
      {
        buildStages.map((stage, idx) => (
          <div
            id={`panel-${stage.id}`}
            class:list={['stage-panel', { 'active-panel': idx === 0 }]}
            role="tabpanel"
            aria-labelledby={`tab-${stage.id}`}
            hidden={idx !== 0}
          >
            <div class="panel-header">
              <div class="panel-step-badge">{stage.step} // {stage.title.toUpperCase()}</div>
              <h3 class="panel-headline">{stage.focus}</h3>
            </div>

            <div class="panel-body-grid">
              <div class="panel-col">
                <span class="col-label">Key Engineering Activities:</span>
                <ul class="activity-list">
                  {stage.activities.map((act) => (
                    <li>{act}</li>
                  ))}
                </ul>
              </div>

              <div class="panel-col meta-col">
                <div class="meta-item-box">
                  <span class="col-label">Deliverable:</span>
                  <p class="deliverable-text">{stage.deliverables}</p>
                </div>
                <div class="meta-item-box">
                  <span class="col-label">Engineering Guarantee:</span>
                  <p class="guarantee-text">{stage.standards}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupBuildLifecycle() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.stage-tab');
    const panels = document.querySelectorAll<HTMLElement>('.stage-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const stageId = tab.dataset.stageId;
        if (!stageId) return;

        tabs.forEach((t) => {
          t.classList.remove('active-tab');
          t.setAttribute('aria-selected', 'false');
        });

        panels.forEach((p) => {
          p.classList.remove('active-panel');
          p.hidden = true;
        });

        tab.classList.add('active-tab');
        tab.setAttribute('aria-selected', 'true');

        const targetPanel = document.getElementById(`panel-${stageId}`);
        if (targetPanel) {
          targetPanel.classList.add('active-panel');
          targetPanel.hidden = false;
        }
      });
    });
  }

  setupBuildLifecycle();
  document.addEventListener('astro:after-swap', setupBuildLifecycle);
</script>

<style>
  .how-i-build-section {
    padding: var(--space-section, 6.5rem) 0;
  }

  .section-subtitle {
    max-width: 660px;
    color: var(--color-text-muted, #a9b8b1);
    font-size: var(--font-size-body, 1.05rem);
    line-height: 1.65;
    margin: 0.5rem 0 2.5rem 0;
  }

  .build-lifecycle-container {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    overflow: hidden;
  }

  .stepper-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    background: rgba(7, 17, 15, 0.9);
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .stage-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    min-height: var(--touch-target-min, 44px);
    background: transparent;
    border: none;
    border-right: 1px solid rgba(246, 241, 232, 0.08);
    cursor: pointer;
    text-align: left;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .stage-tab:last-child {
    border-right: none;
  }

  .stage-tab:hover,
  .stage-tab:focus-visible {
    background: rgba(126, 216, 196, 0.06);
    outline: none;
  }

  .stage-tab.active-tab {
    background: rgba(126, 216, 196, 0.12);
    border-bottom: 2px solid #7ed8c4;
  }

  .stage-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: #7ed8c4;
    margin-bottom: 0.25rem;
  }

  .stage-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    line-height: 1.3;
  }

  .stage-panels {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .panel-step-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: #7ed8c4;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  .panel-headline {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 1.5rem 0;
  }

  .panel-body-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .col-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #83968e;
    margin-bottom: 0.65rem;
  }

  .activity-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .activity-list li {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .meta-item-box {
    background: rgba(7, 17, 15, 0.7);
    border: 1px solid rgba(246, 241, 232, 0.06);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
  }

  .deliverable-text {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
    line-height: 1.45;
  }

  .guarantee-text {
    margin: 0;
    font-size: 0.9rem;
    color: #7ed8c4;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .stepper-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .stage-tab:nth-child(2) {
      border-right: none;
    }

    .panel-body-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .stepper-nav {
      grid-template-columns: 1fr;
    }

    .stage-tab {
      border-right: none;
      border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    }
  }
</style>
