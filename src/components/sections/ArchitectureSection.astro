---
import { methodologySteps } from '@/data/methodology';
import { projects } from '@/data/projects';

function getProjectBySlug(slug: string) {
  return projects.find((p) => p.slug === slug);
}
---

<section id="how-i-build" class="section-shell how-i-build-section">
  <div class="section-heading reveal">
    <p class="eyebrow">Engineering Methodology</p>
    <h2>How I Build Software & Systems</h2>
    <p class="section-subtitle">
      A disciplined 6-stage lifecycle moving from mathematical problem formulation to resilient production deployment, backed by evidence from real project repositories.
    </p>
  </div>

  <div class="build-lifecycle-container reveal">
    <!-- Stepper Navigation -->
    <div class="stepper-nav" role="tablist" aria-label="Engineering Lifecycle Stages">
      {
        methodologySteps.map((stage, idx) => (
          <button
            type="button"
            class:list={['stage-tab', { 'active-tab': idx === 0 }]}
            role="tab"
            id={`tab-${stage.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${stage.id}`}
            data-stage-id={stage.id}
          >
            <span class="stage-num">{stage.number}</span>
            <span class="stage-name">{stage.title}</span>
          </button>
        ))
      }
    </div>

    <!-- Interactive Stage Panels -->
    <div class="stage-panels">
      {
        methodologySteps.map((stage, idx) => {
          const evidenceProjects = stage.projectSlugs
            .map((slug) => getProjectBySlug(slug))
            .filter(Boolean);

          return (
            <div
              id={`panel-${stage.id}`}
              class:list={['stage-panel', { 'active-panel': idx === 0 }]}
              role="tabpanel"
              aria-labelledby={`tab-${stage.id}`}
              hidden={idx !== 0}
            >
              <div class="panel-header">
                <div class="panel-step-badge">{stage.number} // {stage.title.toUpperCase()} — {stage.tagline.toUpperCase()}</div>
                <h3 class="panel-headline">{stage.shortDescription}</h3>
                <p class="panel-desc">{stage.description}</p>
              </div>

              <div class="panel-body-grid">
                <div class="panel-col">
                  <span class="col-label">Questions I Ask:</span>
                  <ul class="activity-list questions-list">
                    {stage.questions.slice(0, 3).map((q) => (
                      <li>{q}</li>
                    ))}
                  </ul>
                </div>

                <div class="panel-col meta-col">
                  <div class="meta-item-box">
                    <span class="col-label">Core Practices:</span>
                    <ul class="practice-list">
                      {stage.practices.slice(0, 3).map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>

                  {evidenceProjects.length > 0 && (
                    <div class="meta-item-box evidence-box">
                      <span class="col-label">Project Evidence:</span>
                      <div class="evidence-pill-group">
                        {evidenceProjects.map((proj) => (
                          <a href={`/work/${proj?.slug}`} class="evidence-pill">
                            {proj?.title} ↗
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Full Methodology Link Footer -->
    <div class="lifecycle-footer">
      <div class="footer-left">
        <span class="method-footnote">Methodology is flexible and adapts by domain (Quantitative ML, Multi-Agent AI, SaaS).</span>
      </div>
      <a href="/how-i-build" class="full-methodology-btn">
        Explore Full Methodology & Technical Decisions →
      </a>
    </div>
  </div>
</section>

<script>
  function setupBuildLifecycle() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.stage-tab');
    const panels = document.querySelectorAll<HTMLElement>('.stage-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const stageId = tab.dataset.stageId;
        if (!stageId) return;

        tabs.forEach((t) => {
          t.classList.remove('active-tab');
          t.setAttribute('aria-selected', 'false');
        });

        panels.forEach((p) => {
          p.classList.remove('active-panel');
          p.hidden = true;
        });

        tab.classList.add('active-tab');
        tab.setAttribute('aria-selected', 'true');

        const targetPanel = document.getElementById(`panel-${stageId}`);
        if (targetPanel) {
          targetPanel.classList.add('active-panel');
          targetPanel.hidden = false;
        }
      });
    });
  }

  setupBuildLifecycle();
  document.addEventListener('astro:after-swap', setupBuildLifecycle);
</script>

<style>
  .how-i-build-section {
    padding: var(--space-section, 6.5rem) 0;
  }

  .section-subtitle {
    max-width: 660px;
    color: var(--color-text-muted, #a9b8b1);
    font-size: var(--font-size-body, 1.05rem);
    line-height: 1.65;
    margin: 0.5rem 0 2.5rem 0;
  }

  .build-lifecycle-container {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    overflow: hidden;
  }

  .stepper-nav {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    background: rgba(7, 17, 15, 0.9);
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
  }

  .stage-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    min-height: var(--touch-target-min, 44px);
    background: transparent;
    border: none;
    border-right: 1px solid rgba(246, 241, 232, 0.08);
    cursor: pointer;
    text-align: left;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .stage-tab:last-child {
    border-right: none;
  }

  .stage-tab:hover,
  .stage-tab:focus-visible {
    background: rgba(126, 216, 196, 0.06);
    outline: none;
  }

  .stage-tab.active-tab {
    background: rgba(126, 216, 196, 0.12);
    border-bottom: 2px solid #7ed8c4;
  }

  .stage-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: #7ed8c4;
    margin-bottom: 0.2rem;
  }

  .stage-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text, #f6f1e8);
    line-height: 1.3;
  }

  .stage-panels {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .panel-step-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    color: #7ed8c4;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  .panel-headline {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
  }

  .panel-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    max-width: 800px;
  }

  .panel-body-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .col-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #83968e;
    margin-bottom: 0.65rem;
  }

  .activity-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .activity-list li {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
  }

  .questions-list li {
    font-style: italic;
    color: rgba(246, 241, 232, 0.85);
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .meta-item-box {
    background: rgba(7, 17, 15, 0.7);
    border: 1px solid rgba(246, 241, 232, 0.06);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
  }

  .practice-list {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .practice-list li {
    font-size: 0.875rem;
    color: var(--color-text, #f6f1e8);
    line-height: 1.45;
  }

  .evidence-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .evidence-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #7ed8c4;
    text-decoration: none;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    transition: background 150ms ease;
  }

  .evidence-pill:hover,
  .evidence-pill:focus-visible {
    background: rgba(126, 216, 196, 0.18);
  }

  .lifecycle-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: rgba(7, 17, 15, 0.95);
    border-top: 1px solid rgba(246, 241, 232, 0.08);
    flex-wrap: wrap;
  }

  .method-footnote {
    font-size: 0.825rem;
    color: var(--muted, #a9b8b1);
  }

  .full-methodology-btn {
    color: #7ed8c4;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .full-methodology-btn:hover,
  .full-methodology-btn:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .stepper-nav {
      grid-template-columns: repeat(3, 1fr);
    }

    .stage-tab:nth-child(3) {
      border-right: none;
    }

    .panel-body-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .stepper-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .stage-tab:nth-child(2n) {
      border-right: none;
    }

    .lifecycle-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  :global(html[data-theme="light"]) .build-lifecycle-container,
  :global([data-theme="light"]) .build-lifecycle-container {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.05);
  }

  :global(html[data-theme="light"]) .stepper-nav,
  :global([data-theme="light"]) .stepper-nav,
  :global(html[data-theme="light"]) .lifecycle-footer,
  :global([data-theme="light"]) .lifecycle-footer {
    background: #f7f4ec;
    border-color: rgba(20, 31, 28, 0.1);
  }

  :global(html[data-theme="light"]) .stage-tab,
  :global([data-theme="light"]) .stage-tab {
    border-color: rgba(20, 31, 28, 0.1);
  }

  :global(html[data-theme="light"]) .stage-tab:hover,
  :global([data-theme="light"]) .stage-tab:hover {
    background: rgba(13, 118, 99, 0.06);
  }

  :global(html[data-theme="light"]) .stage-tab.active-tab,
  :global([data-theme="light"]) .stage-tab.active-tab {
    background: #ffffff;
    border-bottom-color: #0d7663;
  }

  :global(html[data-theme="light"]) .stage-num,
  :global([data-theme="light"]) .stage-num,
  :global(html[data-theme="light"]) .panel-step-badge,
  :global([data-theme="light"]) .panel-step-badge,
  :global(html[data-theme="light"]) .full-methodology-btn,
  :global([data-theme="light"]) .full-methodology-btn {
    color: #0d7663;
  }

  :global(html[data-theme="light"]) .stage-name,
  :global([data-theme="light"]) .stage-name,
  :global(html[data-theme="light"]) .panel-headline,
  :global([data-theme="light"]) .panel-headline,
  :global(html[data-theme="light"]) .practice-list li,
  :global([data-theme="light"]) .practice-list li {
    color: #141f1c;
  }

  :global(html[data-theme="light"]) .panel-desc,
  :global([data-theme="light"]) .panel-desc,
  :global(html[data-theme="light"]) .activity-list li,
  :global([data-theme="light"]) .activity-list li,
  :global(html[data-theme="light"]) .questions-list li,
  :global([data-theme="light"]) .questions-list li,
  :global(html[data-theme="light"]) .method-footnote,
  :global([data-theme="light"]) .method-footnote {
    color: #35453f;
  }

  :global(html[data-theme="light"]) .meta-item-box,
  :global([data-theme="light"]) .meta-item-box {
    background: #f7f4ec;
    border-color: rgba(20, 31, 28, 0.1);
  }

  :global(html[data-theme="light"]) .evidence-pill,
  :global([data-theme="light"]) .evidence-pill {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }
</style>
