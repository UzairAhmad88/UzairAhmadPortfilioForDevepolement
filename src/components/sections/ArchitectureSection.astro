---
import { architectureStages } from '@/data/architecturePipeline';
---

<section class="section-shell architecture-section">
  <div class="section-heading reveal">
    <p class="eyebrow">Architecture</p>
    <h2>A signature path from data to product.</h2>
  </div>

  <div class="architecture-pipeline reveal">
    {
      architectureStages.map((stage) => (
        <button type="button" data-skill={stage.skill} aria-label={`${stage.label}: ${stage.skill}`}>
          {stage.label}
        </button>
      ))
    }
  </div>

  <p class="pipeline-note reveal" aria-live="polite">
    Tap or hover a layer to reveal the technical competency behind it.
  </p>
</section>

<script>
  function setupArchitecturePipeline() {
    const pipelineButtons = document.querySelectorAll<HTMLButtonElement>(
      '.architecture-pipeline button'
    );
    const pipelineNote = document.querySelector<HTMLElement>('.pipeline-note');

    pipelineButtons.forEach((button) => {
      const showSkill = () => {
        if (pipelineNote && button.dataset.skill) {
          pipelineNote.textContent = button.dataset.skill;
          pipelineButtons.forEach((b) => b.classList.remove('active-stage'));
          button.classList.add('active-stage');
        }
      };

      button.addEventListener('click', showSkill);
      button.addEventListener('mouseenter', showSkill);
      button.addEventListener('focus', showSkill);
    });
  }

  setupArchitecturePipeline();
  document.addEventListener('astro:after-swap', setupArchitecturePipeline);
</script>

<style>
  .architecture-section {
    padding: var(--space-section, 6.5rem) 0;
  }

  .architecture-pipeline {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .architecture-pipeline button {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(3.8rem, 8vw, 5.4rem);
    min-width: var(--touch-target-min, 44px);
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.055);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.4vw, 0.88rem);
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .architecture-pipeline button:hover,
  .architecture-pipeline button:focus-visible,
  .architecture-pipeline button.active-stage {
    background: rgba(126, 216, 196, 0.14);
    border-color: rgba(126, 216, 196, 0.5);
    color: #b5eadf;
    outline: none;
  }

  .pipeline-note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
    min-height: 1.5rem;
  }

  @media (max-width: 1024px) {
    .architecture-pipeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.65rem;
    }
  }

  @media (max-width: 600px) {
    .architecture-pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
