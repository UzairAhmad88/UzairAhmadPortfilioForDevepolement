---
import { siteConfig } from '@/data/site';
---

<section id="contact" class="contact-section section-shell reveal">
  <p class="eyebrow"><span class="section-number">06 /</span> Inquiry & Collaboration</p>
  <h2>Have a difficult problem?</h2>
  <p>Let's turn it into a system.</p>
  <div class="contact-actions">
    <a
      class="button primary"
      href={siteConfig.socialLinks.linkedin.url}
      target="_blank"
      rel="noreferrer"
    >
      Start a Conversation
    </a>
    <a
      class="button email"
      href={`mailto:${siteConfig.author.email}`}
      aria-label={`Email ${siteConfig.name}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M4.5 5.75h15A2.5 2.5 0 0 1 22 8.25v7.5a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 15.75v-7.5a2.5 2.5 0 0 1 2.5-2.5Zm0 1.5a1 1 0 0 0-.7.29l7.48 5.55c.43.32 1.01.32 1.44 0l7.48-5.55a1 1 0 0 0-.7-.29h-15Zm16 2.04-6.89 5.11a2.7 2.7 0 0 1-3.22 0L3.5 9.29v6.46a1 1 0 0 0 1 1h15a1 1 0 0 0 1-1V9.29Z"
        ></path>
      </svg>
      Email
    </a>
    <a
      class="button whatsapp"
      href={siteConfig.socialLinks.whatsapp.url}
      target="_blank"
      rel="noreferrer"
      aria-label={`Chat with ${siteConfig.name} on WhatsApp`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12.04 2.5a9.43 9.43 0 0 0-8.1 14.28L2.8 21.5l4.84-1.1a9.43 9.43 0 1 0 4.4-17.9Zm0 1.72a7.7 7.7 0 0 1 6.56 11.74 7.72 7.72 0 0 1-9.9 2.8l-.34-.18-2.92.66.68-2.8-.22-.36a7.7 7.7 0 0 1 6.14-11.86Zm-3.1 3.7c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.68 2.7 4.16 3.68 2.06.82 2.48.66 2.92.62.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.42-1.34-1.66-.14-.24-.02-.38.1-.5.1-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.46-.4-.46-.54-.46h-.52Z"
        ></path>
      </svg>
      WhatsApp
    </a>
    <a class="button ghost" href="#work">View My Work</a>
    <a
      class="button ghost"
      href={siteConfig.socialLinks.vercel.url}
      target="_blank"
      rel="noreferrer"
    >
      Vercel Projects
    </a>
  </div>
</section>

<style>
  .contact-section {
    padding: var(--space-section, 6.5rem) 0;
    text-align: center;
  }

  .contact-section h2 {
    margin-inline: auto;
  }

  .contact-section p {
    color: var(--muted);
    font-size: var(--font-size-body, 1.05rem);
    line-height: 1.65;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .contact-actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 320px;
      margin-inline: auto;
    }

    .contact-actions .button {
      width: 100%;
    }
  }
</style>
