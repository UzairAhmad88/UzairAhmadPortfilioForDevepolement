---
---

<section id="currently" class="simple-currently">
  <div class="currently-container">
    <div class="section-label">CURRENTLY</div>

    <div class="currently-list">
      <div class="currently-row">
        <span class="row-tag">Building</span>
        <div class="row-content">
          <strong>Quant Research & Portfolio Dashboard</strong>
          <span class="row-desc">— Interactive portfolio analytics, factor models, and backtesting visualization platform.</span>
        </div>
      </div>

      <div class="currently-row">
        <span class="row-tag">Exploring</span>
        <div class="row-content">
          <strong>Quantitative Finance & Multi-Agent Intelligence</strong>
          <span class="row-desc">— Market regime clustering, fractional differentiation for memory preservation, and deterministic LLM state machines.</span>
        </div>
      </div>

      <div class="currently-row">
        <span class="row-tag">Learning</span>
        <div class="row-content">
          <strong>Stochastic Calculus & Time-Series Microstructure</strong>
          <span class="row-desc">— Volatility estimation (GARCH/Heston), orderbook modeling, and expanding walk-forward cross-validation.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .simple-currently {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .currently-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    margin-bottom: 1.5rem;
  }

  :global(html[data-theme="light"]) .section-label,
  :global([data-theme="light"]) .section-label {
    color: #0d7663;
  }

  .currently-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .currently-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.75rem 0;
  }

  .row-tag {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted, #73847b);
  }

  :global(html[data-theme="light"]) .row-tag,
  :global([data-theme="light"]) .row-tag {
    color: #5a6e66;
  }

  .row-content {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-primary, #f6f1e8);
  }

  :global(html[data-theme="light"]) .row-content,
  :global([data-theme="light"]) .row-content {
    color: #141f1c;
  }

  .row-desc {
    color: var(--color-text-secondary, #a9b8b1);
  }

  :global(html[data-theme="light"]) .row-desc,
  :global([data-theme="light"]) .row-desc {
    color: #4a5c55;
  }

  @media (max-width: 600px) {
    .currently-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
