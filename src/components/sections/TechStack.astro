---
import { getTechnologyById } from '@/data/technologies';
import { universeNodes } from '@/data/skills';

const domainGroups = [
  {
    role: 'Quantitative & Mathematical Systems',
    focus: 'Time-series forecasting, statistical stationarity, and algorithmic backtesting.',
    techIds: ['python', 'pytorch', 'pandas', 'numpy', 'scikit-learn', 'cuda'],
  },
  {
    role: 'AI & Intelligent Systems',
    focus: 'Neural return prediction, regime transition clustering, and deterministic agent execution.',
    techIds: ['pytorch', 'langgraph', 'fastapi', 'pydantic', 'scikit-learn'],
  },
  {
    role: 'Backend & Data Infrastructure',
    focus: 'Resilient REST APIs, relational schemas, secure endpoints, and data validation.',
    techIds: ['nodejs', 'express', 'typescript', 'postgresql', 'fastapi'],
  },
  {
    role: 'Frontend & Product Experience',
    focus: 'Accessible interfaces, sub-second performance, design systems, and mobile-first layouts.',
    techIds: ['astro', 'react', 'typescript', 'tailwindcss', 'html5-css3'],
  },
  {
    role: 'Engineering Discipline & Delivery',
    focus: 'Version control, reproducible research notebooks, automated testing, and CI/CD.',
    techIds: ['git', 'jupyter', 'cuda'],
  },
];
---

<section id="stack" class="section-shell technical-map">
  <div class="section-heading reveal">
    <p class="eyebrow"><span class="section-number">04 /</span> Technical Map</p>
    <h2>Organized by Engineering Role & System Responsibility</h2>
    <p class="section-subtitle">
      I select tools strictly for their reliability, mathematical correctness, and execution performance—never for vanity.
    </p>
  </div>

  <div class="universe reveal" aria-label="Technical Discipline Universe Map">
    <div class="universe-core">
      <span class="core-label">CORE ENGINE</span>
      <span class="core-lang">PYTHON & TS</span>
    </div>
    {
      universeNodes.map((node) => (
        <span class="universe-tag" style={`--x:${node.x};--y:${node.y}`}>{node.label}</span>
      ))
    }
  </div>

  <div class="role-stack-grid reveal">
    {
      domainGroups.map((group) => {
        const groupTechs = group.techIds
          .map((id) => getTechnologyById(id))
          .filter(Boolean);

        return (
          <article class="stack-card">
            <h3 class="stack-role-title">{group.role}</h3>
            <p class="stack-focus-text">{group.focus}</p>
            <div class="skill-pills-wrap">
              {groupTechs.map((tech) => (
                <a href={`/technology/${tech?.id}`} class="skill-pill">
                  {tech?.name}
                </a>
              ))}
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="stack-footer-cta reveal">
    <span class="footer-note">All technologies link to verified project repositories and case studies.</span>
    <a href="/technology" class="tech-system-link">
      Explore Full Technology System & Project Mappings →
    </a>
  </div>
</section>

<style>
  .technical-map {
    padding: var(--space-section, 6.5rem) 0;
  }

  .section-subtitle {
    max-width: 660px;
    color: var(--color-text-muted, #a9b8b1);
    font-size: var(--font-size-body, 1.05rem);
    line-height: 1.65;
    margin: 0.5rem 0 2.5rem 0;
  }

  .universe {
    position: relative;
    min-height: clamp(320px, 42vw, 420px);
    margin-bottom: 2rem;
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    background:
      radial-gradient(circle at center, rgba(126, 216, 196, 0.08), transparent 45%),
      linear-gradient(rgba(246, 241, 232, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246, 241, 232, 0.025) 1px, transparent 1px),
      rgba(16, 26, 23, 0.75);
    background-size: auto, 36px 36px, 36px 36px, auto;
    overflow: hidden;
    transition: background 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .universe::before,
  .universe::after {
    content: "";
    position: absolute;
    inset: 18%;
    border: 1px solid rgba(246, 241, 232, 0.06);
    border-radius: 50%;
    pointer-events: none;
    transition: border-color 200ms ease;
  }

  .universe::after {
    inset: 32%;
    border-color: rgba(126, 216, 196, 0.12);
  }

  .universe-core {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: clamp(6.5rem, 16vw, 8.5rem);
    height: clamp(6.5rem, 16vw, 8.5rem);
    border-radius: 50%;
    background: #07110f;
    border: 1px solid rgba(126, 216, 196, 0.4);
    box-shadow: 0 0 40px rgba(126, 216, 196, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 2;
    transition: background 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .core-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 700;
    color: #83968e;
    letter-spacing: 0.06em;
  }

  .core-lang {
    font-family: var(--font-mono, monospace);
    font-size: clamp(0.75rem, 1.8vw, 0.95rem);
    font-weight: 800;
    color: #7ed8c4;
    margin-top: 0.15rem;
  }

  .universe-tag {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(246, 241, 232, 0.12);
    border-radius: var(--radius-full, 9999px);
    background: rgba(7, 17, 15, 0.9);
    color: var(--color-text, #f6f1e8);
    font-family: var(--font-mono, monospace);
    font-size: clamp(0.7rem, 1.2vw, 0.8rem);
    font-weight: 700;
    white-space: nowrap;
    z-index: 1;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }

  .universe-tag:hover {
    border-color: #7ed8c4;
    color: #7ed8c4;
    transform: scale(1.08);
    box-shadow: 0 4px 16px rgba(126, 216, 196, 0.2);
  }

  .role-stack-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .stack-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 2.5vw, 1.6rem);
    display: flex;
    flex-direction: column;
    transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }

  .stack-card:hover {
    border-color: rgba(126, 216, 196, 0.3);
  }

  .stack-card:nth-child(4),
  .stack-card:nth-child(5) {
    grid-column: span 1;
  }

  .stack-role-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
  }

  .stack-focus-text {
    font-size: 0.9rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .skill-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .skill-pill {
    font-size: 0.775rem;
    font-weight: 600;
    color: #7ed8c4;
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .skill-pill:hover,
  .skill-pill:focus-visible {
    background: rgba(126, 216, 196, 0.2);
    border-color: #7ed8c4;
  }

  .stack-footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.5rem;
    background: rgba(16, 26, 23, 0.7);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.75rem;
    flex-wrap: wrap;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .footer-note {
    font-size: 0.85rem;
    color: var(--muted, #a9b8b1);
  }

  .tech-system-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: #7ed8c4;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .tech-system-link:hover,
  .tech-system-link:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  @media (max-width: 980px) {
    .role-stack-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .role-stack-grid {
      grid-template-columns: 1fr;
    }

    .stack-footer-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ============================================================
     LIGHT THEME EXPLICIT OVERRIDES
     Ensures crisp contrast, clean surfaces, and zero dark artifacts
     ============================================================ */
  /* ============================================================
     LIGHT THEME EXPLICIT OVERRIDES
     Ensures crisp contrast, clean surfaces, and zero dark artifacts
     ============================================================ */
  :global(html[data-theme="light"]) .universe,
  :global([data-theme="light"]) .universe {
    background:
      radial-gradient(circle at center, rgba(13, 118, 99, 0.08), transparent 50%),
      linear-gradient(rgba(20, 31, 28, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 31, 28, 0.04) 1px, transparent 1px),
      #ffffff !important;
    border-color: rgba(20, 31, 28, 0.14) !important;
    box-shadow: 0 4px 20px rgba(20, 31, 28, 0.05) !important;
  }

  :global(html[data-theme="light"]) .universe::before,
  :global([data-theme="light"]) .universe::before {
    border-color: rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .universe::after,
  :global([data-theme="light"]) .universe::after {
    border-color: rgba(13, 118, 99, 0.25) !important;
  }

  :global(html[data-theme="light"]) .universe-core,
  :global([data-theme="light"]) .universe-core {
    background: #ffffff !important;
    border-color: rgba(13, 118, 99, 0.5) !important;
    box-shadow: 0 8px 30px rgba(13, 118, 99, 0.15) !important;
  }

  :global(html[data-theme="light"]) .core-label,
  :global([data-theme="light"]) .core-label {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .core-lang,
  :global([data-theme="light"]) .core-lang {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .universe-tag,
  :global([data-theme="light"]) .universe-tag {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.15) !important;
    color: #141f1c !important;
    box-shadow: 0 2px 8px rgba(20, 31, 28, 0.08) !important;
  }

  :global(html[data-theme="light"]) .universe-tag:hover,
  :global([data-theme="light"]) .universe-tag:hover {
    border-color: #0d7663 !important;
    color: #0d7663 !important;
    box-shadow: 0 4px 14px rgba(13, 118, 99, 0.18) !important;
  }

  :global(html[data-theme="light"]) .stack-card,
  :global([data-theme="light"]) .stack-card {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04) !important;
  }

  :global(html[data-theme="light"]) .stack-card:hover,
  :global([data-theme="light"]) .stack-card:hover {
    border-color: rgba(13, 118, 99, 0.4) !important;
    box-shadow: 0 8px 24px rgba(13, 118, 99, 0.08) !important;
  }

  :global(html[data-theme="light"]) .stack-role-title,
  :global([data-theme="light"]) .stack-role-title {
    color: #141f1c !important;
  }

  :global(html[data-theme="light"]) .stack-focus-text,
  :global([data-theme="light"]) .stack-focus-text {
    color: #35453f !important;
  }

  :global(html[data-theme="light"]) .skill-pill,
  :global([data-theme="light"]) .skill-pill {
    background: rgba(13, 118, 99, 0.08) !important;
    border-color: rgba(13, 118, 99, 0.25) !important;
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .skill-pill:hover,
  :global([data-theme="light"]) .skill-pill:hover {
    background: rgba(13, 118, 99, 0.16) !important;
    border-color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .stack-footer-cta,
  :global([data-theme="light"]) .stack-footer-cta {
    background: #ffffff !important;
    border-color: rgba(20, 31, 28, 0.12) !important;
    box-shadow: 0 2px 10px rgba(20, 31, 28, 0.04) !important;
  }

  :global(html[data-theme="light"]) .footer-note,
  :global([data-theme="light"]) .footer-note {
    color: #4e6059 !important;
  }

  :global(html[data-theme="light"]) .tech-system-link,
  :global([data-theme="light"]) .tech-system-link {
    color: #0d7663 !important;
  }

  :global(html[data-theme="light"]) .tech-system-link:hover,
  :global([data-theme="light"]) .tech-system-link:hover {
    color: #09594b !important;
  }
</style>
