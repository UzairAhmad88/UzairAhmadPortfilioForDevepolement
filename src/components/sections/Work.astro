---
import ProjectCard from '@/components/cards/ProjectCard.astro';
import { getFeaturedProjects, projects } from '@/data/projects';

const featuredList = getFeaturedProjects().length > 0 ? getFeaturedProjects() : projects.slice(0, 5);
---

<section id="work" class="simple-work-section">
  <div class="work-header">
    <div class="header-left">
      <span class="section-label">SELECTED WORK</span>
      <h2 class="section-title">Software, Quantitative Tools & Real-World Platforms</h2>
    </div>
    <a href="/work" class="view-all-link">
      View All Work ({projects.length}) →
    </a>
  </div>

  <div class="project-grid">
    {featuredList.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>

  <div class="work-footer">
    <a href="/work" class="btn secondary">
      Explore All Projects & Archives ({projects.length}) →
    </a>
  </div>
</section>

<style>
  .simple-work-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .section-label,
  :global([data-theme="light"]) .section-label {
    color: #0d7663;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .section-title,
  :global([data-theme="light"]) .section-title {
    color: #141f1c;
  }

  .view-all-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent, #7ed8c4);
    text-decoration: none;
    transition: transform 150ms ease;
    display: inline-flex;
    align-items: center;
  }

  :global(html[data-theme="light"]) .view-all-link,
  :global([data-theme="light"]) .view-all-link {
    color: #0d7663;
  }

  .view-all-link:hover,
  .view-all-link:focus-visible {
    transform: translateX(3px);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .work-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn.secondary {
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    color: var(--color-accent, #7ed8c4);
  }

  .btn.secondary:hover {
    background: rgba(126, 216, 196, 0.15);
    border-color: var(--color-accent, #7ed8c4);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .btn.secondary,
  :global([data-theme="light"]) .btn.secondary {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }

  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .work-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
