<section id="about" class="simple-about-preview">
  <div class="about-container">
    <div class="header-left">
      <span class="section-label">ABOUT</span>
      <h2 class="section-title">Bridging Theory, Data & Software Systems</h2>
    </div>

    <div class="about-grid">
      <div class="about-narrative">
        <p class="lead-para">
          I am <strong>Uzair Ahmad</strong>, a software and machine learning engineer based in Peshawar, Pakistan. I build systems where mathematical modeling, statistical learning, and reliable full-stack web architectures intersect.
        </p>
        <p class="secondary-para">
          My work spans end-to-end quantitative pipelines (financial time-series modeling, walk-forward validation, GMM market regime clustering) to full-stack applications (distributed multi-tenant platforms, role-based EMR software, and high-speed POS tools).
        </p>
        <div class="about-actions">
          <a href="/about" class="btn secondary">
            Read Full Background & Capabilities →
          </a>
        </div>
      </div>

      <div class="capabilities-sidebar">
        <h3 class="capabilities-title">Core Capabilities</h3>

        <div class="cap-group">
          <h4 class="cap-heading">Quantitative Finance</h4>
          <p class="cap-desc">Time Series · Market Regimes · Factor Modeling · Risk Evaluation</p>
        </div>

        <div class="cap-group">
          <h4 class="cap-heading">AI & Machine Learning</h4>
          <p class="cap-desc">PyTorch · Deep Learning · Multi-Agent LLMs · LangGraph · Scikit-Learn</p>
        </div>

        <div class="cap-group">
          <h4 class="cap-heading">Full-Stack Engineering</h4>
          <p class="cap-desc">TypeScript · React · Python · FastAPI · Node.js · PostgreSQL · Astro</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .simple-about-preview {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .about-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
  }

  :global(html[data-theme="light"]) .section-label,
  :global([data-theme="light"]) .section-label {
    color: #0d7663;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .section-title,
  :global([data-theme="light"]) .section-title {
    color: #141f1c;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .about-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lead-para {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0;
  }

  :global(html[data-theme="light"]) .lead-para,
  :global([data-theme="light"]) .lead-para {
    color: #141f1c;
  }

  .secondary-para {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .secondary-para,
  :global([data-theme="light"]) .secondary-para {
    color: #4a5c55;
  }

  .about-actions {
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn.secondary {
    background: rgba(126, 216, 196, 0.08);
    border: 1px solid rgba(126, 216, 196, 0.25);
    color: var(--color-accent, #7ed8c4);
  }

  .btn.secondary:hover {
    background: rgba(126, 216, 196, 0.15);
    border-color: var(--color-accent, #7ed8c4);
    transform: translateY(-1px);
  }

  :global(html[data-theme="light"]) .btn.secondary,
  :global([data-theme="light"]) .btn.secondary {
    background: rgba(13, 118, 99, 0.08);
    border-color: rgba(13, 118, 99, 0.25);
    color: #0d7663;
  }

  .capabilities-sidebar {
    padding: 1.5rem;
    background: var(--color-surface, #0c1815);
    border: 1px solid var(--color-border, rgba(126, 216, 196, 0.15));
    border-radius: var(--radius-lg, 10px);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(html[data-theme="light"]) .capabilities-sidebar,
  :global([data-theme="light"]) .capabilities-sidebar {
    background: #ffffff;
    border-color: rgba(20, 31, 28, 0.12);
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.04);
  }

  .capabilities-title {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-primary, #f6f1e8);
    margin: 0 0 0.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  :global(html[data-theme="light"]) .capabilities-title,
  :global([data-theme="light"]) .capabilities-title {
    color: #141f1c;
    border-bottom-color: rgba(20, 31, 28, 0.08);
  }

  .cap-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cap-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent, #7ed8c4);
    margin: 0;
  }

  :global(html[data-theme="light"]) .cap-heading,
  :global([data-theme="light"]) .cap-heading {
    color: #0d7663;
  }

  .cap-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary, #a9b8b1);
    margin: 0;
  }

  :global(html[data-theme="light"]) .cap-desc,
  :global([data-theme="light"]) .cap-desc {
    color: #4a5c55;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
