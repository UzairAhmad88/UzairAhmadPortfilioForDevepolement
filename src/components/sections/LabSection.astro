---
import { getFeaturedLabItems } from '@/data/lab';

const featuredExperiments = getFeaturedLabItems().slice(0, 3);
---

<section id="lab" class="lab-workbench-section">
  <div class="section-shell">
    <div class="section-heading reveal">
      <p class="eyebrow"><span class="section-number">06 /</span> Experimental Workbench</p>
      <h2>Active prototypes, algorithmic tests, and proofs of concept.</h2>
      <p class="section-intro">
        A look at technical explorations currently occupying the bench — built to test hypotheses, evaluate architectures, and understand systems before formal productization.
      </p>
    </div>

    <div class="workbench-grid">
      {featuredExperiments.map((item) => (
        <article class="workbench-card reveal">
          <div class="workbench-card-top">
            <span class="workbench-badge">{item.type}</span>
            <span class="workbench-status">{item.status.toUpperCase()}</span>
          </div>

          <h3 class="workbench-title">
            <a href={`/lab/${item.slug}`}>
              {item.title.split(':')[0]}
            </a>
          </h3>

          <p class="workbench-question">
            <strong>Question:</strong> {item.question}
          </p>

          <p class="workbench-desc">
            {item.shortDescription}
          </p>

          <div class="workbench-card-bottom">
            <div class="tech-pills">
              {item.technologies.slice(0, 3).map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>
            <a href={`/lab/${item.slug}`} class="workbench-link">
              Inspect Experiment →
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="workbench-footer reveal">
      <a href="/lab" class="view-all-lab-btn">
        Explore All Experiments in the Lab ({getFeaturedLabItems().length}+ items) →
      </a>
    </div>
  </div>
</section>

<style>
  .lab-workbench-section {
    padding: var(--space-section, 6.5rem) 0;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.06));
    border-bottom: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.06));
  }

  .section-intro {
    max-width: 42rem;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a9b8b1);
    line-height: 1.6;
  }

  .workbench-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .workbench-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.09));
    border-radius: var(--radius-lg, 0.75rem);
    background: rgba(16, 26, 23, 0.75);
    display: flex;
    flex-direction: column;
    transition: transform var(--motion-duration-normal) var(--motion-ease-standard), border-color var(--motion-duration-normal) var(--motion-ease-standard), box-shadow var(--motion-duration-normal) var(--motion-ease-standard);
  }

  .workbench-card:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 216, 196, 0.35);
    box-shadow: var(--shadow-card, 0 16px 40px rgba(0, 0, 0, 0.35));
  }

  .workbench-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .workbench-badge {
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workbench-status {
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    background: rgba(126, 216, 196, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid rgba(126, 216, 196, 0.25);
    letter-spacing: 0.04em;
  }

  .workbench-title {
    margin: 0 0 0.75rem 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .workbench-title a {
    color: var(--color-text-primary, #f6f1e8);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .workbench-title a:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .workbench-question {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--color-text-primary, #f6f1e8);
    background: rgba(255, 255, 255, 0.03);
    border-left: 2px solid var(--color-accent, #7ed8c4);
    padding: 0.5rem 0.65rem;
    border-radius: 0 4px 4px 0;
    margin: 0 0 0.85rem 0;
    line-height: 1.5;
  }

  .workbench-question strong {
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .workbench-desc {
    color: var(--color-text-secondary, #a9b8b1);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .workbench-card-bottom {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-pill {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-secondary, #a9b8b1);
    font-family: var(--font-mono, monospace);
    font-size: 0.725rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm, 4px);
    border: 1px solid var(--color-border-subtle, rgba(246, 241, 232, 0.08));
  }

  .workbench-link {
    color: var(--color-accent, #7ed8c4);
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .workbench-link:hover {
    color: var(--color-accent-hover, #9bd8cf);
    text-decoration: underline;
  }

  .workbench-footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  .view-all-lab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: rgba(126, 216, 196, 0.08);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.28);
    border-radius: var(--radius-md, 8px);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .view-all-lab-btn:hover {
    background: rgba(126, 216, 196, 0.16);
    border-color: var(--color-accent, #7ed8c4);
    color: var(--color-accent, #7ed8c4);
    transform: translateY(-1px);
  }

  [data-theme="light"] .workbench-card {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 4px 16px rgba(20, 31, 28, 0.05);
  }

  [data-theme="light"] .workbench-card:hover {
    box-shadow: 0 12px 32px rgba(20, 31, 28, 0.1);
  }

  [data-theme="light"] .workbench-question {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    color: var(--color-text-primary, #141f1c);
  }

  [data-theme="light"] .tech-pill {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border-subtle, rgba(20, 31, 28, 0.08));
    color: var(--color-text-secondary, #465751);
  }

  @media (max-width: 960px) {
    .workbench-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .workbench-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
