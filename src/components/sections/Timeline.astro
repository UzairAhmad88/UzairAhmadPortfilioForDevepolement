---
import { currentFocusItems } from '@/data/timeline';
---

<section id="currently" class="section-shell current-focus-section">
  <div class="section-heading reveal">
    <p class="eyebrow">Active Focus</p>
    <h2>Currently: Building, Learning & Exploring</h2>
    <p class="section-subtitle">
      A transparent snapshot of what is actively on my workbench, in my research queue, and on my radar.
    </p>
  </div>

  <div class="focus-grid reveal">
    {
      currentFocusItems.map((item) => (
        <article class="focus-card">
          <div class="card-header">
            <span class="focus-badge" style={`color: ${item.badgeColor}; border-color: ${item.badgeColor}40; background: ${item.badgeColor}15;`}>
              ● {item.category.toUpperCase()}
            </span>
          </div>

          <h3 class="focus-title">{item.title}</h3>
          <p class="focus-desc">{item.description}</p>

          <div class="focus-tags">
            {item.technologies.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .current-focus-section {
    padding: var(--space-section, 6.5rem) 0;
  }

  .section-subtitle {
    max-width: 640px;
    color: var(--color-text-muted, #a9b8b1);
    font-size: var(--font-size-body, 1.05rem);
    line-height: 1.65;
    margin: 0.5rem 0 2.5rem 0;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .focus-card {
    background: rgba(16, 26, 23, 0.75);
    border: 1px solid rgba(246, 241, 232, 0.09);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .focus-card:hover {
    border-color: rgba(126, 216, 196, 0.35);
    transform: translateY(-2px);
  }

  .card-header {
    margin-bottom: 0.85rem;
  }

  .focus-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .focus-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text, #f6f1e8);
    line-height: 1.35;
    margin: 0 0 0.75rem 0;
  }

  .focus-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.65;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tech-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted, #a9b8b1);
    background: rgba(246, 241, 232, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
