---
import type { Project } from '@/types/project';
import { getProjectDNA } from '@/utils/projectDNA';
import { getTechnologyById } from '@/data/technologies';

export interface Props {
  project: Project;
  variant?: 'detail' | 'card' | 'featured' | 'compact';
  class?: string;
}

const { project, variant = 'card', class: className } = Astro.props;
const dna = getProjectDNA(project);
---

{variant === 'detail' && (
  <div class:list={['project-dna-detail', className]} aria-label="Project Technical Specification & DNA">
    <div class="dna-header">
      <span class="dna-eyebrow">SYSTEM PROFILE / TECHNICAL DNA</span>
      <span class:list={['status-indicator', `status-${dna.rawStatus}`]}>
        <span class="status-dot"></span>
        {dna.status}
      </span>
    </div>

    <div class="dna-grid">
      <div class="dna-cell">
        <span class="cell-label">CLASSIFICATION</span>
        <span class="cell-value highlight">{dna.type}</span>
      </div>

      {dna.role && (
        <div class="dna-cell">
          <span class="cell-label">ROLE RESPONSIBILITY</span>
          <span class="cell-value">{dna.role}</span>
        </div>
      )}

      {dna.context && (
        <div class="dna-cell">
          <span class="cell-label">PROJECT CONTEXT</span>
          <span class="cell-value">{dna.context}</span>
        </div>
      )}

      {dna.timeline && (
        <div class="dna-cell">
          <span class="cell-label">TIMELINE / LIFECYCLE</span>
          <span class="cell-value">{dna.timeline}</span>
        </div>
      )}

      {dna.deployment && (
        <div class="dna-cell">
          <span class="cell-label">DEPLOYMENT RUNTIME</span>
          <span class="cell-value">{dna.deployment}</span>
        </div>
      )}

      {dna.domain && (
        <div class="dna-cell">
          <span class="cell-label">DISCIPLINE / DOMAIN</span>
          <span class="cell-value">{dna.domain}</span>
        </div>
      )}

      {dna.technologies && dna.technologies.length > 0 && (
        <div class="dna-cell full-width">
          <span class="cell-label">CORE STACK & RUNTIME</span>
          <ul class="tech-stack-list" aria-label="Technologies and runtime components">
            {dna.technologies.map((tech) => {
              const techEntity = getTechnologyById(tech);
              return techEntity ? (
                <li class="tech-stack-item">
                  <a href={`/technology/${techEntity.id}`} class="tech-dna-link">
                    {tech}
                  </a>
                </li>
              ) : (
                <li class="tech-stack-item">{tech}</li>
              );
            })}
          </ul>
        </div>
      )}

      {dna.evidence && dna.evidence.length > 0 && (
        <div class="dna-cell full-width">
          <span class="cell-label">VERIFIABLE EVIDENCE & ARTIFACTS</span>
          <div class="evidence-list" aria-label="Verifiable project artifacts">
            {dna.evidence.map((item) => (
              item.url ? (
                <a
                  href={item.url}
                  target={item.url.startsWith('http') ? '_blank' : undefined}
                  rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class:list={['evidence-pill', `type-${item.type}`]}
                >
                  <span class="evidence-name">{item.label}</span>
                  <span class="evidence-arrow" aria-hidden="true">
                    {item.url.startsWith('http') ? '↗' : '→'}
                  </span>
                </a>
              ) : (
                <span class="evidence-pill disabled">
                  <span class="evidence-name">{item.label}</span>
                </span>
              )
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
)}

{variant === 'card' && (
  <div class:list={['project-dna-card', className]}>
    <div class="card-dna-meta">
      <span class="card-dna-type">{dna.type}</span>
      <span class:list={['card-status-badge', `status-${dna.rawStatus}`]}>
        {dna.status}
      </span>
    </div>

    {dna.role && (
      <div class="card-role-line">
        <span class="role-label">Role:</span> <span class="role-text">{dna.role}</span>
      </div>
    )}

    {dna.technologies && dna.technologies.length > 0 && (
      <ul class="card-tech-list" aria-label="Technologies used">
        {dna.technologies.slice(0, 4).map((tech) => {
          const techEntity = getTechnologyById(tech);
          return techEntity ? (
            <li class="card-tech-pill">
              <a href={`/technology/${techEntity.id}`} class="card-tech-link">
                {tech}
              </a>
            </li>
          ) : (
            <li class="card-tech-pill">{tech}</li>
          );
        })}
      </ul>
    )}
  </div>
)}

{variant === 'featured' && (
  <div class:list={['project-dna-featured', className]}>
    <div class="featured-dna-top">
      <div class="badge-duo">
        <span class="flagship-tag">★ Flagship Engineering System</span>
        <span class:list={['featured-status', `status-${dna.rawStatus}`]}>
          {dna.status}
        </span>
      </div>
      {dna.context && <span class="featured-context">{dna.context}</span>}
    </div>

    <div class="featured-dna-specs">
      <div class="spec-item">
        <span class="spec-label">TYPE</span>
        <span class="spec-value">{dna.type}</span>
      </div>
      {dna.role && (
        <div class="spec-item">
          <span class="spec-label">ROLE</span>
          <span class="spec-value">{dna.role}</span>
        </div>
      )}
      {dna.deployment && (
        <div class="spec-item">
          <span class="spec-label">RUNTIME</span>
          <span class="spec-value">{dna.deployment}</span>
        </div>
      )}
    </div>

    {dna.technologies && dna.technologies.length > 0 && (
      <ul class="featured-tech-row" aria-label="Key Technologies">
        {dna.technologies.map((tech) => {
          const techEntity = getTechnologyById(tech);
          return techEntity ? (
            <li class="featured-tech-pill">
              <a href={`/technology/${techEntity.id}`} class="featured-tech-link">
                {tech}
              </a>
            </li>
          ) : (
            <li class="featured-tech-pill">{tech}</li>
          );
        })}
      </ul>
    )}
  </div>
)}

{variant === 'compact' && (
  <div class:list={['project-dna-compact', className]}>
    <span class="compact-type">{dna.type}</span>
    <span class="compact-separator">·</span>
    <span class="compact-status">{dna.status}</span>
    {dna.timeline && (
      <>
        <span class="compact-separator">·</span>
        <span class="compact-timeline">{dna.timeline}</span>
      </>
    )}
  </div>
)}

<style>
  /* ==========================================================================
     DETAIL VARIANT (Full technical fingerprint spec sheet)
     ========================================================================== */
  .project-dna-detail {
    background: rgba(16, 26, 23, 0.85);
    border: 1px solid rgba(246, 241, 232, 0.1);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: clamp(2rem, 3.5vw, 2.75rem);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .dna-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.08);
    margin-bottom: 1.25rem;
  }

  .dna-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent, #7ed8c4);
    text-transform: uppercase;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full, 9999px);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-active {
    background: rgba(126, 216, 196, 0.1);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.28);
  }

  .status-academic {
    background: rgba(126, 216, 196, 0.1);
    color: var(--color-accent, #7ed8c4);
    border: 1px solid rgba(126, 216, 196, 0.25);
  }

  .status-completed {
    background: rgba(16, 185, 129, 0.1);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .status-prototype, .status-research {
    background: rgba(126, 216, 196, 0.08);
    color: #9bd8cf;
    border: 1px solid rgba(126, 216, 196, 0.22);
  }

  .status-superseded {
    background: rgba(120, 144, 156, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(120, 144, 156, 0.25);
  }

  .status-legacy {
    background: rgba(120, 144, 156, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(120, 144, 156, 0.25);
  }

  .status-archived, .status-paused, .status-abandoned {
    background: rgba(120, 144, 156, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(120, 144, 156, 0.25);
  }


  .dna-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
  }

  .dna-cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .dna-cell.full-width {
    grid-column: 1 / -1;
  }

  .cell-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #83968e);
  }

  .cell-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
    line-height: 1.4;
  }

  .cell-value.highlight {
    color: var(--color-accent, #7ed8c4);
  }

  .tech-stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0 0;
  }

  .tech-stack-item {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
    background: rgba(246, 241, 232, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 0.3rem;
    white-space: nowrap;
    transition: border-color 150ms ease;
  }

  .tech-stack-item:has(a:hover) {
    border-color: rgba(126, 216, 196, 0.4);
  }

  .tech-dna-link,
  .card-tech-link,
  .featured-tech-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .tech-dna-link:hover,
  .card-tech-link:hover,
  .featured-tech-link:hover {
    color: var(--color-accent, #7ed8c4);
  }

  .evidence-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }

  .evidence-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.12);
    color: var(--color-text, #f6f1e8);
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .evidence-pill:hover, .evidence-pill:focus-visible {
    background: rgba(126, 216, 196, 0.1);
    border-color: rgba(126, 216, 196, 0.4);
    color: var(--color-accent, #7ed8c4);
  }

  .evidence-pill.type-github {
    border-color: rgba(126, 216, 196, 0.25);
  }

  .evidence-pill.type-live {
    border-color: rgba(16, 185, 129, 0.3);
    color: #6ee7b7;
  }

  .evidence-arrow {
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  /* ==========================================================================
     CARD VARIANT (Compact fingerprint for ProjectCard)
     ========================================================================== */
  .project-dna-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .card-dna-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dna-badge-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-dna-type {
    color: var(--color-accent, #7ed8c4);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono, monospace);
  }

  .card-status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
  }

  .card-timeline {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
  }

  .card-role-line {
    font-size: 0.8rem;
    color: var(--color-text-muted, #a9b8b1);
    line-height: 1.4;
  }

  .role-label {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    color: var(--color-text-muted, #83968e);
  }

  .role-text {
    color: var(--color-text, #f6f1e8);
    font-weight: 500;
  }

  .card-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0 0;
  }

  .card-tech-pill {
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--color-text-muted, #a9b8b1);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  /* ==========================================================================
     FEATURED VARIANT (Integrated spec strip for FeaturedProjectCard)
     ========================================================================== */
  .project-dna-featured {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .featured-dna-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .badge-duo {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .flagship-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent, #7ed8c4);
  }

  .featured-status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full, 9999px);
  }

  .featured-context {
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-muted, #83968e);
  }

  .featured-dna-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem 1.25rem;
    padding: 0.875rem 1rem;
    background: rgba(7, 17, 15, 0.5);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: 0.5rem;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spec-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #83968e);
  }

  .spec-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
  }

  .featured-tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .featured-tech-pill {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text, #f6f1e8);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 0.3rem;
    white-space: nowrap;
  }

  /* ==========================================================================
     COMPACT VARIANT (Horizontal strip for archive rows or minimal lists)
     ========================================================================== */
  .project-dna-compact {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--color-text-muted, #a9b8b1);
  }

  .compact-type {
    color: var(--color-accent, #7ed8c4);
    font-weight: 700;
  }

  .compact-status {
    color: var(--color-text, #f6f1e8);
  }

  :global(html[data-theme="light"]) .project-dna-detail,
  :global([data-theme="light"]) .project-dna-detail {
    background: var(--color-surface-elevated, #ffffff);
    border-color: var(--color-border-strong, rgba(20, 31, 28, 0.15));
    box-shadow: 0 8px 24px rgba(20, 31, 28, 0.06);
  }

  :global(html[data-theme="light"]) .tech-stack-item,
  :global([data-theme="light"]) .tech-stack-item {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border-subtle, rgba(20, 31, 28, 0.08));
    color: var(--color-text-primary, #141f1c);
  }

  :global(html[data-theme="light"]) .evidence-pill,
  :global([data-theme="light"]) .evidence-pill {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border, rgba(20, 31, 28, 0.12));
    color: var(--color-text-primary, #141f1c);
  }

  :global(html[data-theme="light"]) .featured-dna-specs,
  :global([data-theme="light"]) .featured-dna-specs {
    background: var(--color-surface, rgba(20, 31, 28, 0.03));
    border-color: var(--color-border-subtle, rgba(20, 31, 28, 0.08));
  }

  :global(html[data-theme="light"]) .card-tech-pill,
  :global([data-theme="light"]) .card-tech-pill {
    background: var(--color-surface, rgba(20, 31, 28, 0.04));
    border-color: var(--color-border-subtle, rgba(20, 31, 28, 0.08));
    color: var(--color-text-secondary, #35453f);
  }

  @media (max-width: 640px) {
    .dna-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .featured-dna-specs {
      grid-template-columns: 1fr;
    }
  }
</style>
